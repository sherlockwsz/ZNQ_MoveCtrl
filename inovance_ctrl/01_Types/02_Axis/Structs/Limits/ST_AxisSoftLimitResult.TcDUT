<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_AxisSoftLimitResult" Id="{813dce35-0bc1-479c-8389-cfd62a86f56f}">
    <Declaration><![CDATA[//==============================================================
// 单轴软件限位计算结果
//
// 本结构体只保存FB内部的软件限位计算结果。
// 它不是WPF输入参数，也不保存轴的实际限位配置。
//==============================================================

TYPE ST_AxisSoftLimitResult :
STRUCT
    //==========================================================
    // 软件限位整体状态
    //==========================================================

    bEnabled : BOOL;// 当前是否启用PLC侧软件限位
    bConfigValid : BOOL;// 负限位、正限位和Margin配置是否正确
    bReferenceValid : BOOL;// 当前坐标基准是否有效
    bReady : BOOL;// 软件限位是否能够正常参与运动检查
    
    //==========================================================
    // 当前限位区域状态
    //==========================================================

    bPositiveActive : BOOL;// 实际位置已经进入正向限位缓冲区域
    bNegativeActive : BOOL;// 实际位置已经进入负向限位缓冲区域
    
    //==========================================================
    // 点动方向许可
    //==========================================================

    bJogPositiveAllowed : BOOL;// 是否允许继续正向点动
    bJogNegativeAllowed : BOOL;// 是否允许继续负向点动

    //==========================================================
    // 定位目标检查结果
    //==========================================================

    bAbsoluteTargetValid : BOOL;// 当前绝对目标是否在限位范围内
    bRelativeTargetValid : BOOL;// 当前相对运动最终目标是否在限位范围内
    fRelativeTargetPosition : LREAL;// 相对移动距离换算得到的最终绝对位置
    
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>