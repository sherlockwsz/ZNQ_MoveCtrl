<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="E_DamperErrorCode" Id="{282e7aca-01f6-4e87-9ff4-734bbf75c4a8}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
// 阻尼器上下料流程错误码。
// 保留原范围，并定义本次异常保护错误码：16#6100～16#61FF。
TYPE E_DamperErrorCode :
(
    None         := 16#0000,
    ReservedBase := 16#6100,
    ScrewVisionOffline       := 16#6111,
    ScrewVisionTimeout       := 16#6112,
    ScrewVisionInvalidResult := 16#6113,
    ScrewVisionServiceFault  := 16#6114,
    ScrewTargetNotDetected   := 16#6115,
    MotionCommandRejected    := 16#6121,
    MotionCommandAborted     := 16#6122,
    MotionTimeout            := 16#6123,
    ReservedEnd  := 16#61FF
) UDINT;
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
