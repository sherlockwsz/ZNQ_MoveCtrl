<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="E_DamperTakeStep" Id="{fe8c8926-3cc4-420e-b47a-707e2480c41b}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}

TYPE E_DamperTakeStep :
(
    Idle                 := 0,
    EnsureSafeZ          := 10,// 确认DamperZ位于安全高度。
    MoveXYToVisionPosition     := 11,// XY移动，使相机中心对准当前阻尼器。

    AcquireVisionResult        := 12,// 请求统一螺钉角度视觉结果，并分别锁存检测角度与机械修正量。

    MoveXYToSlot               := 20,// 检测完成后，XY回到阻尼器理论料位。
    LowerZToSlot         := 30,// Z轴下降到料盘取料高度。
    ClampPlaceholder     := 40,// 夹爪夹紧占位。
    EmptyReleaseClose    := 41, // 撤销Close，等待Action重新武装及Owner释放。
    EmptyOpen            := 42, // 独立Open事务完成后才允许抬Z。
    EmptyLiftSafe        := 43, // 安全Z到位后才报告EmptySkip。
    RotationToCameraAngle := 50,// 兼容保留步骤名：Z轴抬升与按需执行一次DamperRotation修正并行。
    MoveXYToTransfer     := 60, // 两个并行动作均完成后，XY移动到转台备料位。
	// XY到达备料位、Z保持110mm时，
	// DamperRotation绝对运动到本件实际机械基准角度+扫码偏移角。
	RotationToScanAngle := 65,
    LowerZToTransfer     := 70,
    ReleasePlaceholder   := 80,
    RotationReturnHome      := 90,// Z抬升与Rotation绝对回零并行执行。
    WaitTurntableRotation   := 95,// Z到达安全位置后，请求并等待转台换位。
    Completed            := 100
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
