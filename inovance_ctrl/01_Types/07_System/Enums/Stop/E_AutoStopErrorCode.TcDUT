  <DUT Name="E_AutoStopErrorCode" Id="{21b962c5-58d3-4e57-bd9d-84290411689d}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
