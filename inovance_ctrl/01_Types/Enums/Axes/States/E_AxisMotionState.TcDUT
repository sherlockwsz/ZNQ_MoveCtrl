<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="E_AxisMotionState" Id="{b39be91d-315a-4c11-9254-b9866ee1c1a5}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_AxisMotionState :
(
    Undefined  := 0,    // 状态尚未初始化

    Disabled   := 10,   // 轴未使能
    NotReady   := 20,   // NC轴、驱动器或通信尚未准备好
    Standstill := 30,   // 轴已使能并静止



    Homing     := 40,   // 回零中
    Moving     := 50,   // 相对或绝对定位运动中
    Jogging    := 60,   // 点动中
    Stopping   := 70,   // MC_Stop或MC_Halt停止中
    Resetting  := 80,   // 错误复位中

    Error      := 90,   // 轴存在错误
	
	TorqueRunning := 100 // 力矩控制
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>