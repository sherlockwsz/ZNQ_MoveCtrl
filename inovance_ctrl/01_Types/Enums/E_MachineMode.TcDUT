  <DUT Name="E_MachineMode" Id="{85a3bc1e-60e0-4441-9fcb-5d9dfcdb887f}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_MachineMode :
(
    Undefined   := 0,    // 启动后尚未选择模式
    Manual      := 10,   // 手动调试模式
    Automatic   := 20,   // 自动运行模式
    Maintenance := 30    // 维护模式
);
END_TYPE]]></Declaration>
