  <DUT Name="E_GripperCommStep" Id="{1de5945a-0227-49eb-85bb-d6cb43c6efb3}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_GripperCommStep :
(
