<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="E_ScrewdriverStep" Id="{606c08a8-6dbd-49dc-b77b-aa909f9a5086}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_ScrewdriverStep :
(
    Idle                    := 0,
    InitializeSafeZ         := 10,  // 首次启动：Z先到85
    InitializeYZero         := 20,  // 首次启动：Y再到0

    MoveYForPreTighten      := 30,  // 第一件需要Y进位；后续已在62可直接跳过
    LowerForPreTighten      := 40,
    WaitPreTighten          := 50,
    LiftAfterPreTighten     := 60,
    RetreatYForAdjustment  := 70,  // 当前机构有干涉：调整前必须Y回0
    WaitAdjustment         := 80,  // 独立模拟调整

    MoveYForFinalTighten    := 90,
    LowerForFinalTighten    := 100,
    WaitFinalTighten        := 110,
    FinalLiftZ              := 120, // Z到85后才允许转台松夹
    WaitDoneAck             := 130, // 保持完成信号，等待转台确认
    Error                   := 900
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>