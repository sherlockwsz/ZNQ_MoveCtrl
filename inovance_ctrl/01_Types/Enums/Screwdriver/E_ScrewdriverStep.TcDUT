<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="E_ScrewdriverStep" Id="{606c08a8-6dbd-49dc-b77b-aa909f9a5086}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_ScrewdriverStep :
(
    Idle                       := 0,

    // 首次初始化
    InitializeSafeZ            := 10,
    InitializeYZero            := 20,

    // 预拧紧
    MoveYForPreTighten         := 30,
    LowerForPreTighten         := 40,
    WaitPreTighten             := 50,
    LiftAfterPreTighten        := 60,
    RetreatYForAdjustment     := 70,

    // 调整机构进入工作位置
    MoveAdjustmentXYToWork     := 80,
    LowerAdjustmentZToWork     := 90,
    WaitAdjustment             := 100,

    // 二次拧紧
    MoveYForFinalTighten       := 110,
    LowerForFinalTighten       := 120,
    WaitFinalTighten           := 130,
    FinalLiftScrewdriverZ      := 140,

    // 调整机构撤离
    LiftAdjustmentZToSafe      := 150,
    ReturnAdjustmentXYStandby  := 160,

    // 全部撤离完成后保持完成信号
    WaitDoneAck                := 170,

    Error                      := 900
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>