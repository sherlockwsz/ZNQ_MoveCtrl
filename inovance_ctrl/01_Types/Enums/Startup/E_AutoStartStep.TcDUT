  <DUT Name="E_AutoStartStep" Id="{c7c4639f-a212-4202-90f3-adc2847232b6}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
TYPE E_AutoStartStep :
(
    Idle             		 := 0,   // 等待新的自动启动上升沿
    WaitAxesReady    		 := 10,  // 请求八轴使能，等待全部轴就绪
    WaitMachinePreparation   := 20,  // 允许现有五盘流程运行
	Running          		 := 30
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>