<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="E_MachineMode" Id="{6b6dc0c8-9717-4dc0-94de-73588146c4f1}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
{attribute 'strict'}
{attribute 'to_string'}
TYPE E_MachineMode :
(
    Disabled        := 0,   // 控制条件无效，所有轴无命令所有者
    Manual          := 10,  // WPF单轴调试拥有命令权
    AutoStarting    := 20,  // 自动准入、使能和就绪等待
    Automatic       := 30,  // 整机自动流程正在执行
    Homing          := 40,  // 回零流程预留
    Stopping        := 50,  // 受控停止正在执行
    Fault           := 60   // 停止完成后仍存在整机锁存故障
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
