<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <DUT Name="ST_AxisCmd" Id="{bf7479eb-b665-403f-aa40-61f162a9ede9}">
    <Declaration><![CDATA[(*
    单轴动作命令。

    持续型信号：
    bEnable、bStop、bJogPos、bJogNeg、bTorqueControl。

    上升沿触发信号：
    bReset、bMoveAbs、bMoveRel。
*)
TYPE ST_AxisCmd :
STRUCT
    bEnable : BOOL;// 轴使能请求
    // TRUE：请求使能；FALSE：请求撤销使能

    bReset : BOOL;    // 错误复位命令，上升沿触发

    bStop : BOOL;    // 停止请求
    // TRUE期间MC_Stop保持锁定，恢复FALSE后解除锁定

    bMoveAbs : BOOL;    // 绝对运动命令，上升沿触发

    bMoveRel : BOOL;    // 相对运动命令，上升沿触发

    bJogPos : BOOL;    // 正向点动，按住为TRUE，松开为FALSE

    bJogNeg : BOOL;    // 反向点动，按住为TRUE，松开为FALSE
	
    //==========================================================
    // 转矩控制命令
    //==========================================================

    // 持续型转矩控制请求。
    //
    // TRUE：
    // 1. 请求轴切换到CST模式；
    // 2. 按Set.Torque中的参数建立并保持转矩。
    //
    // FALSE：
    // 1. 退出转矩控制；
    // 2. FB_AxisControl负责恢复位置模式；
    // 3. 确认恢复位置模式后，才能再次执行MoveAbs等位置命令。
    bTorqueControl : BOOL;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>