<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="ST_GripperFeedback" Id="{adabb868-89bd-44c0-afd4-a15e1c6d1094}">
    <Declaration><![CDATA[TYPE ST_GripperFeedback :
STRUCT
    bOnline             : BOOL;
    bPositionValid      : BOOL;
    bCurrentValid       : BOOL;
    bFaultCodeValid     : BOOL;
    diActualPosition    : DINT;
    iActualCurrent      : INT;
    udFaultCode         : UDINT;
    bBusy               : BOOL;
    bOpen               : BOOL;
    bClosed             : BOOL;
    bPositionReached    : BOOL;
    bCurrentReached     : BOOL;
    bFault              : BOOL;
    bCommFault          : BOOL;
    bStopAcknowledged   : BOOL;   // 整机Stop写命令已收到有效回执
    bStopError          : BOOL;   // 整机Stop发送或应答失败
    udiAcceptedId       : UDINT;
    udiRejectedId       : UDINT;
    udiCompletedId      : UDINT;
    udCommErrorCode     : UDINT;
    udCommandErrorCode  : UDINT;
    udStopErrorCode     : UDINT;  // Stop错误与普通动作错误分离
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
