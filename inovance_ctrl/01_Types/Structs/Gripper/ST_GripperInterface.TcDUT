<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <DUT Name="ST_GripperInterface" Id="{afd9d177-881e-495d-b69b-5724f6545672}">
    <Declaration><![CDATA[TYPE ST_GripperInterface :
STRUCT
    Port     : ComSerialConfig;     // 本台电机使用的COM口和串口参数
    Set      : ST_GripperConfig;    // 站号、开合位置、电流阈值、超时等
    Cmd      : ST_GripperRequest;   // 上层写入的动作请求
    Feedback : ST_GripperFeedback;  // PLC写入的位置、电流、状态和故障
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>