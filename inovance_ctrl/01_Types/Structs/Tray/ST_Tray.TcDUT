  <DUT Name="ST_Tray" Id="{8f3fc1d4-d785-4880-a667-d410a998673a}">
    <Declaration><![CDATA[(*
    单层料盘数据：
    料盘当前状态。五层高/低位统一由GVL_PositionConfig.stTray.aLayer保存。

    位置配置位于GVL_PositionConfig，不在运行时状态结构中重复存放。
*)
TYPE ST_Tray :
STRUCT
    eState        : E_Tray;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
