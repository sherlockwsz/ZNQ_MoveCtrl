<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <GVL Name="GVL_ClampingPdo" Id="{8d408c98-4816-438f-806e-b8a1a1f5ff40}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // SV680N 1B01h 输入: 6061h真实运行模式，仅用于Clamping模式确认。
    // 8=CSP，10=CST；准备和位置运动必须确认值为8。
    i8ModeOfOperationDisplay AT %I* : SINT;

    // SV680N 1B02h 输入: 603Fh 故障码及 60FDh DI 状态，仅供诊断。
    uiErrorCode AT %I* : UINT;
    udiDigitalInputs AT %I* : UDINT;

    // SV680N 1702h 输出: 607Fh 最大轮廓速度，单位为驱动器指令单位/s。
    // 手册默认 4294967295，表示此 PDO 初始不额外限制速度。
    // 真实转矩控制联调前必须根据机械行程单独设定合理速度限制。
    udiMaxProfileVelocity AT %Q* : UDINT := 13421773;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
