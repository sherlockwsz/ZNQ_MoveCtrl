<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <GVL Name="GVL_DamperGripper" Id="{017ce3c4-7c38-4e26-a51f-9d75c2cef429}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    stDamperGripper : ST_GripperInterface := (
        Port := (
            ComPort  := 3,
            Baudrate := 115200,
            Parity   := PARITY_NONE,
            DataBits := 8,
            StopBits := STOPBITS_ONE,
            DTR      := DTR_CTRL_DISABLE,
            RTS      := RTS_CTRL_DISABLE,
            CTS      := FALSE,
            DSR      := FALSE
        ),
        Set := (
            nStationId           := 2,
            diOpenPosition       := 0,
            diClosePosition      := 35000,   // 已标定
            bPositivePulseCloses := TRUE,
            diPositionTolerance  := 20,     // 暂定
            uiCloseCurrentMin    := 1,      // 暂定
            tReplyTimeout        := T#500MS,
            tFeedbackTimeout     := T#3S,   // 3秒无任何有效反馈才判通信故障
            tMoveTimeout         := T#5S,
            bParametersVerified  := TRUE
        )
    );

    // COM4调整夹爪：50000闭合，29000张开。
    // 位置公差、夹紧电流阈值和实测运动时间尚未标定，
    // 因此bParametersVerified保持FALSE；实机自动流程不得发起运动。
    stAdjustGripper : ST_GripperInterface := (
        Port := (
            ComPort  := 4,
            Baudrate := 115200,
            Parity   := PARITY_NONE,
            DataBits := 8,
            StopBits := STOPBITS_ONE,
            DTR      := DTR_CTRL_DISABLE,
            RTS      := RTS_CTRL_DISABLE,
            CTS      := FALSE,
            DSR      := FALSE
        ),
        Set := (
            nStationId           := 2,
            diOpenPosition       := 29000,
            diClosePosition      := 50000,
            bPositivePulseCloses := TRUE,
            diPositionTolerance  := 0,      // 待实机标定
            uiCloseCurrentMin    := 0,      // 待实机标定；不绕过Close电流判据
            tReplyTimeout        := T#500MS,
            tFeedbackTimeout     := T#3S,
            tMoveTimeout         := T#5S,   // 现有调试占位值，需按实测时间复核
            bParametersVerified  := FALSE
        )
    );
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>