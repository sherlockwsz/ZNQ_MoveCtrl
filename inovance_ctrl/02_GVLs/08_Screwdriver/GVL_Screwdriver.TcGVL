<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <GVL Name="GVL_Screwdriver" Id="{71351413-6719-4619-ABF6-2F53BFAED97C}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // 默认FALSE：本次只增加独立在线调试入口，不自动打开新端口或接入工艺。
    bEnableScrewdriver1 : BOOL := FALSE;
    bEnableScrewdriver2 : BOOL := FALSE;

    stScrewdriver1 : ST_ScrewdriverInterface := (
        Port := (
            stPortConfig := (
                ComPort  := 5,
                Baudrate := 115200,
                Parity   := PARITY_NONE,
                DataBits := 8,
                StopBits := STOPBITS_ONE,
                DTR      := DTR_CTRL_DISABLE,
                RTS      := RTS_CTRL_DISABLE,
                CTS      := FALSE,
                DSR      := FALSE
            ),
            tAdsTimeout   := T#2S,
            tReplyTimeout := T#3S
        ),
        Set := (
            byStationId       := 1,
            bExpectReply      := TRUE,
            bRequirePcControl := TRUE,
            nMaxRetry         := 1
        )
    );

    stScrewdriver2 : ST_ScrewdriverInterface := (
        Port := (
            stPortConfig := (
                ComPort  := 6,
                Baudrate := 115200,
                Parity   := PARITY_NONE,
                DataBits := 8,
                StopBits := STOPBITS_ONE,
                DTR      := DTR_CTRL_DISABLE,
                RTS      := RTS_CTRL_DISABLE,
                CTS      := FALSE,
                DSR      := FALSE
            ),
            tAdsTimeout   := T#2S,
            tReplyTimeout := T#3S
        ),
        Set := (
            byStationId       := 2,
            bExpectReply      := TRUE,
            bRequirePcControl := TRUE,
            nMaxRetry         := 1
        )
    );
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
