<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <GVL Name="GVL_Screwdriver" Id="{71351413-6719-4619-ABF6-2F53BFAED97C}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // COM5/COM6实际工艺通信默认使能；两个FB实例仍保持端口和事务完全独立。
    bEnableScrewdriver1 : BOOL := TRUE;
    bEnableScrewdriver2 : BOOL := TRUE;

    stScrewdriver1 : ST_ScrewdriverInterface := (
        Port := (
            stPortConfig := (
                ComPort  := 5,
                Baudrate := 115200,
                Parity   := PARITY_NONE,
                DataBits := 8,
                StopBits := STOPBITS_ONE,
                DTR      := DTR_CTRL_DISABLE,
                RTS      := RTS_CTRL_DISABLE,
                CTS      := FALSE,
                DSR      := FALSE
            ),
            tAdsTimeout   := T#2S,
            tReplyTimeout := T#3S
        ),
        Set := (
            byStationId       := 1,
            bExpectReply      := TRUE,
            bRequirePcControl := TRUE,
            nMaxRetry         := 1
        )
    );

    stScrewdriver2 : ST_ScrewdriverInterface := (
        Port := (
            stPortConfig := (
                ComPort  := 6,
                Baudrate := 115200,
                Parity   := PARITY_NONE,
                DataBits := 8,
                StopBits := STOPBITS_ONE,
                DTR      := DTR_CTRL_DISABLE,
                RTS      := RTS_CTRL_DISABLE,
                CTS      := FALSE,
                DSR      := FALSE
            ),
            tAdsTimeout   := T#2S,
            tReplyTimeout := T#3S
        ),
        Set := (
            byStationId       := 2,
            bExpectReply      := TRUE,
            bRequirePcControl := TRUE,
            nMaxRetry         := 1
        )
    );
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
