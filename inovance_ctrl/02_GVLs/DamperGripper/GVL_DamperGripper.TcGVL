<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <GVL Name="GVL_DamperGripper" Id="{017ce3c4-7c38-4e26-a51f-9d75c2cef429}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    stDamperGripper : ST_GripperInterface := (
        Port := (
            ComPort  := 3,
            Baudrate := 115200,
            Parity   := PARITY_NONE,
            DataBits := 8,
            StopBits := STOPBITS_ONE,
            DTR      := DTR_CTRL_DISABLE,
            RTS      := RTS_CTRL_DISABLE,
            CTS      := FALSE,
            DSR      := FALSE
        ),
        Set := (
            nStationId           := 2,
            diOpenPosition       := 0,
            diClosePosition      := 35000,   // 暂定，标定后修改
            bPositivePulseCloses := TRUE,
            diPositionTolerance  := 20,     // 暂定
            uiCloseCurrentMin    := 1,      // 尚未标定
            tReplyTimeout        := T#1S,
            tFeedbackTimeout     := T#3S,   // 3秒无任何有效反馈才判通信故障
            tMoveTimeout         := T#5S,
            bParametersVerified  := TRUE
        )
    );

    // 第二台只创建接口；COM号和电机参数核实前不启用通信或运动。
    stAdjustGripper : ST_GripperInterface := (
        Port := (
            ComPort  := 4,
            Baudrate := 115200,
            Parity   := PARITY_NONE,
            DataBits := 8,
            StopBits := STOPBITS_ONE,
            DTR      := DTR_CTRL_DISABLE,
            RTS      := RTS_CTRL_DISABLE,
            CTS      := FALSE,
            DSR      := FALSE
        ),
        Set := (
            nStationId          := 2,       
            tReplyTimeout       := T#500MS,
            tFeedbackTimeout    := T#3S,
            tMoveTimeout        := T#5S,
            bParametersVerified := TRUE
        )
    );
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
