<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_AxisConfig" Id="{292f67a3-fb57-4951-94dc-c8359ba6e509}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    //==========================================================
    // Axis1软件限位配置
    //
    // 当前数值仅为示例。
    // 接入实际电机前，必须修改为真实机械行程。
    //==========================================================
    Axis1Limit : ST_AxisLimit := (
        bSoftLimitEnable := TRUE,//软限位是否使能
		
		// 实际增量编码器轴应在加入回零后改为TRUE
		bRequireHomed := FALSE,// 当前模拟轴没有执行MC_Home，因此不要求回零
		
        // 示例范围：0～600工程单位
        fSoftwareLimitNeg := 0.0,
        fSoftwareLimitPos := 600.0,
		
        fSoftLimitMargin := 5.0// 距离限位5个工程单位时停止继续向外点动
    );
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>