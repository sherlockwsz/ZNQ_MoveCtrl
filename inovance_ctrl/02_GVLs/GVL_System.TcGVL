<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="GVL_System" Id="{e087346e-e6fe-4094-b4e2-6f8a98151646}">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL
    // =====================================================
    // 设备运行模式
    // 由FB_ModeManager根据HMI请求和系统条件更新
    // =====================================================
    eMachineMode : E_MachineMode :=
        E_MachineMode.Undefined;

    // =====================================================
    // HMI通信监控配置
    // =====================================================

    // 是否启用HMI心跳保护
    // PLC代码离线测试时可以FALSE
    // 实际WPF联调和设备运行时建议TRUE
    bUseHmiWatchdog : BOOL := FALSE;

    // HMI心跳超时时间
    tHmiHeartbeatTimeout : TIME := T#3S;

    // HMI当前是否在线，由FB_HmiWatchdog写入
    bHmiOnline : BOOL;

    // HMI通信是否超时，由FB_HmiWatchdog写入
    bHmiTimeout : BOOL;

    // =====================================================
    // TwinCAT及驱动器准备状态
    // 建立NC轴和EtherCAT后，由系统管理功能块更新
    // =====================================================

    // EtherCAT主站和从站是否正常
    bEtherCATReady : BOOL;

    // TwinCAT NC轴是否准备好
    bNcReady : BOOL;

    // 伺服驱动器是否准备好
    bDriveReady : BOOL;

    // =====================================================
    // 安全输入状态
    // 后续应由真实数字量输入或安全系统更新
    // =====================================================

    // 急停是否触发
    // TRUE表示急停已经按下
    bEmergencyStop : BOOL;

    // 安全门是否关闭
    // FALSE表示安全门打开或信号异常
    bSafetyDoorClosed : BOOL;

    // 驱动器STO是否处于激活状态
    // TRUE表示驱动器安全转矩关闭
    bStoActive : BOOL;

    // 安全条件是否全部满足
    // 由FB_SafetyManager计算
    bSafetyReady : BOOL;

    // =====================================================
    // 全局控制状态
    // =====================================================

    // 是否允许所有轴接受新的运动命令
    // 由通信、安全、运行模式、系统准备状态共同决定
    bControlAllowed : BOOL;

    // 全局受控停止请求
    // HMI停止、通信超时、安全条件丢失时置TRUE
    bGlobalStopRequest : BOOL;

    // 全局复位请求
    bGlobalResetRequest : BOOL;

    // =====================================================
    // 整机报警汇总
    // =====================================================

    // 整机是否存在报警
    bMachineError : BOOL;

    // 当前优先级最高的整机报警码
    nMachineErrorID : UDINT;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>