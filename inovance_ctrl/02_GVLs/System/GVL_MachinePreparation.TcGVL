        fDamperYStandby := 95.0,
        fDamperZStandby := 110.0,
        fDamperRotationZero := 0.0,

        // 转台机构
        fClampOpenPosition := 93.0,
        fTurntableZero := 10.5,

        // 螺丝刀机构
        fScrewdriverYZero := 0.0,
        fScrewdriverZSafe := 85.0,

        // 临时调试速度
        fTrayVelocity := 50.0,
        fDamperVelocity := 50.0,
        fDamperRotationVelocity := 30.0,
        fClampVelocity := 15.0,
        fTurntableVelocity := 60.0,
        fScrewdriverVelocity := 10.0,

        fLinearTolerance := 0.01,
        fRotationTolerance := 0.1,

        tReadyTimeout := T#15S,
        tMotionTimeout := T#60S
    );
END_VAR]]></Declaration>
