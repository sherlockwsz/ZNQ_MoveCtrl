<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_AdjustmentProcess" Id="{6be3f419-7e42-4f1c-ad50-7db14f957959}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AdjustmentProcess
VAR_INPUT
    bEnable          : BOOL;
    bAbort           : BOOL;
    bStopRequest     : BOOL;
    bMachinePrepared : BOOL;
    bStartRequest    : BOOL;
    bDoneAck         : BOOL;

    // 与Screwdriver流程之间的保持型业务握手。
    bSecondTightenDone : BOOL;
    bReworkLoosenDone  : BOOL;

    // 保留原输入符号以兼容现有监控；协调器给它与二次拧紧Done相同的值。
    bRetractPermit : BOOL;
END_VAR

VAR_IN_OUT
    ioAdjustGripperAction : FB_GripperAction;
    ioAdjustGripper       : ST_GripperInterface;
    stAxisX               : ST_AxisInterface;
    stAxisY               : ST_AxisInterface;
    stAxisZ               : ST_AxisInterface;
END_VAR

VAR_OUTPUT
    bAdjustmentReady   : BOOL; // 兼容诊断：与二次拧紧请求保持一致
    bAdjustmentDone    : BOOL;
    bAdjustmentBusy    : BOOL;
    bAdjustmentQualified : BOOL;
    bRequestSecondTighten : BOOL;
    bRequestReworkLoosen  : BOOL;
    bVisionTimeout     : BOOL;
    bVisionFault       : BOOL;
    bFallbackUsed      : BOOL;
    eVisionError       : E_VisionError := E_VisionError.None;
    fVisionCoaxiality  : LREAL;
    fCorrectionX       : LREAL;
    fCorrectionY       : LREAL;
    nAdjustCount       : UINT;
    nReworkCount       : UINT;
    bError             : BOOL;
    bGripperError      : BOOL;
    uiErrorAxis        : UINT;
    udErrorCode        : UDINT;
    eStep              : E_AdjustmentStep := E_AdjustmentStep.Idle;
    bAdjustGripperActionExecute : BOOL;
    eAdjustGripperActionCommand : E_GripperCommand := E_GripperCommand.None;
END_VAR

VAR
    fXWork : LREAL;
    fYWork : LREAL;
    fZWork : LREAL;
    fXStandby : LREAL;
    fYStandby : LREAL;
    fZSafe : LREAL;
    fXVelocity : LREAL;
    fYVelocity : LREAL;
    fZVelocity : LREAL;
    fPositionTolerance : LREAL;
    tMoveTimeout : TIME;

    fAdjustTargetX : LREAL;
    fAdjustTargetY : LREAL;
    bVisionWithinTolerance : BOOL;

    fbMoveTimeout : TON;
    fbCoaxVision : FB_CoaxVision;
    bTimerRestart : BOOL;
    eTimedStep : E_AdjustmentStep := E_AdjustmentStep.Idle;
    bTimedMovement : BOOL;
    uiMovingAxis : UINT;

    bXIssued : BOOL;
    bYIssued : BOOL;
    bZIssued : BOOL;
    bXDone : BOOL;
    bYDone : BOOL;
    bZDone : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 沿用现有PositionConfig和MotionConfig；视觉工艺、次数和超时分别来自
// ProcessConfig与CommunicationConfig，FB内部不保存第二套参数源。
fXWork := GVL_PositionConfig.stAdjustment.stWork.X;
fYWork := GVL_PositionConfig.stAdjustment.stWork.Y;
fZWork := GVL_PositionConfig.stAdjustment.stWork.Z;
fXStandby := GVL_PositionConfig.stAdjustment.stReady.X;
fYStandby := GVL_PositionConfig.stAdjustment.stReady.Y;
fZSafe := GVL_PositionConfig.stAdjustment.stReady.Z;
fXVelocity := GVL_MotionConfig.stAdjustment.stX.fVelocity;
fYVelocity := GVL_MotionConfig.stAdjustment.stY.fVelocity;
fZVelocity := GVL_MotionConfig.stAdjustment.stZ.fVelocity;
fPositionTolerance := GVL_MotionConfig.stAdjustment.fPositionTolerance;
tMoveTimeout := GVL_MotionConfig.stAdjustment.tMoveTimeout;

bTimerRestart := (eStep <> eTimedStep);
eTimedStep := eStep;
bTimedMovement :=
    (eStep = E_AdjustmentStep.MoveXYToWork)
    OR (eStep = E_AdjustmentStep.LowerZToWork)
    OR (eStep = E_AdjustmentStep.WaitCorrectionXY)
    OR (eStep = E_AdjustmentStep.LiftZToSafe)
    OR (eStep = E_AdjustmentStep.ReturnXYToStandby);

IF bTimedMovement THEN
    CASE eStep OF
        E_AdjustmentStep.LowerZToWork,
        E_AdjustmentStep.LiftZToSafe:
            uiMovingAxis := GVL_AxisIndex.AdjustmentZ;

        E_AdjustmentStep.MoveXYToWork,
        E_AdjustmentStep.WaitCorrectionXY,
        E_AdjustmentStep.ReturnXYToStandby:
            IF NOT bXDone THEN
                uiMovingAxis := GVL_AxisIndex.AdjustmentX;
            ELSE
                uiMovingAxis := GVL_AxisIndex.AdjustmentY;
            END_IF;
    END_CASE;
END_IF;

fbMoveTimeout(
    IN := bEnable AND NOT bAbort AND bTimedMovement AND NOT bTimerRestart,
    PT := tMoveTimeout
);

stAxisX.AutoCmd.bMoveAbs := FALSE;
stAxisY.AutoCmd.bMoveAbs := FALSE;
stAxisZ.AutoCmd.bMoveAbs := FALSE;
bAdjustGripperActionExecute := FALSE;
eAdjustGripperActionCommand := E_GripperCommand.None;

// Process只保持执行请求并消费强类型结果；ADS、RequestId、ResultId和Timeout
// 全部封装在FB_CoaxVision -> FB_VisionRequest中。
fbCoaxVision(
    bExecute := bEnable
                AND NOT bAbort
                AND
                (
                    (eStep = E_AdjustmentStep.WaitMeasureResult)
                    OR (eStep = E_AdjustmentStep.WaitFinalMeasure)
                ),
    bCancel := bStopRequest OR bAbort
);

IF NOT bEnable OR bAbort THEN
    IF bMachinePrepared THEN
        ioAdjustGripperAction(
            bExecute := FALSE,
            eCommand := E_GripperCommand.None,
            bCancel := bStopRequest OR bAbort,
            tAcceptTimeout := GVL_ProcessConfig.stGripper.tAcceptTimeout,
            tResultTimeout := GVL_ProcessConfig.stGripper.tResultTimeout,
            ioGripper := ioAdjustGripper
        );
    END_IF;

    bAdjustmentReady := FALSE;
    bAdjustmentDone := FALSE;
    bAdjustmentBusy := FALSE;
    bAdjustmentQualified := FALSE;
    bRequestSecondTighten := FALSE;
    bRequestReworkLoosen := FALSE;
    bVisionTimeout := FALSE;
    bVisionFault := FALSE;
    bFallbackUsed := FALSE;
    eVisionError := E_VisionError.None;
    fCorrectionX := 0.0;
    fCorrectionY := 0.0;
    nAdjustCount := 0;
    nReworkCount := 0;
    bError := FALSE;
    bGripperError := FALSE;
    uiErrorAxis := 0;
    udErrorCode := TO_UDINT(E_ScrewdriverErrorCode.None);
    bXIssued := FALSE;
    bYIssued := FALSE;
    bZIssued := FALSE;
    bXDone := FALSE;
    bYDone := FALSE;
    bZDone := FALSE;
    eStep := E_AdjustmentStep.Idle;
    RETURN;
END_IF;

IF (eStep = E_AdjustmentStep.Idle) AND bStartRequest THEN
    bAdjustmentQualified := FALSE;
    bVisionTimeout := FALSE;
    bVisionFault := FALSE;
    bFallbackUsed := FALSE;
    eVisionError := E_VisionError.None;
    bVisionWithinTolerance := FALSE;
    fVisionCoaxiality := 0.0;
    fCorrectionX := 0.0;
    fCorrectionY := 0.0;
    fAdjustTargetX := fXWork;
    fAdjustTargetY := fYWork;
    nAdjustCount := 0;
    nReworkCount := 0;
    bXIssued := FALSE;
    bYIssued := FALSE;
    bXDone := FALSE;
    bYDone := FALSE;
    eStep := E_AdjustmentStep.MoveXYToWork;
END_IF;

// 准备阶段结束后，COM4命令权归本FB；Open持续到最终质量结果确定。
IF bMachinePrepared THEN
    IF eStep = E_AdjustmentStep.OpenGripper THEN
        bAdjustGripperActionExecute := TRUE;
        eAdjustGripperActionCommand := E_GripperCommand.Open;
    ELSIF eStep = E_AdjustmentStep.CloseGripper THEN
        bAdjustGripperActionExecute := TRUE;
        eAdjustGripperActionCommand := E_GripperCommand.Close;
    END_IF;

    ioAdjustGripperAction(
        bExecute := bAdjustGripperActionExecute,
        eCommand := eAdjustGripperActionCommand,
        bCancel := bStopRequest OR bAbort,
        tAcceptTimeout := GVL_ProcessConfig.stGripper.tAcceptTimeout,
        tResultTimeout := GVL_ProcessConfig.stGripper.tResultTimeout,
        ioGripper := ioAdjustGripper
    );
END_IF;

IF stAxisX.Alarm.bError OR stAxisY.Alarm.bError OR stAxisZ.Alarm.bError THEN
    bError := TRUE;
    bGripperError := FALSE;
    eStep := E_AdjustmentStep.Error;
    IF stAxisX.Alarm.bError THEN
        uiErrorAxis := GVL_AxisIndex.AdjustmentX;
        udErrorCode := stAxisX.Alarm.nErrorID;
    ELSIF stAxisY.Alarm.bError THEN
        uiErrorAxis := GVL_AxisIndex.AdjustmentY;
        udErrorCode := stAxisY.Alarm.nErrorID;
    ELSE
        uiErrorAxis := GVL_AxisIndex.AdjustmentZ;
        udErrorCode := stAxisZ.Alarm.nErrorID;
    END_IF;
END_IF;

IF ioAdjustGripperAction.bError
    AND ((eStep = E_AdjustmentStep.OpenGripper)
         OR (eStep = E_AdjustmentStep.CloseGripper))
THEN
    bError := TRUE;
    bGripperError := TRUE;
    uiErrorAxis := 0;
    IF ioAdjustGripperAction.udErrorCode <> 0 THEN
        udErrorCode := ioAdjustGripperAction.udErrorCode;
    ELSE
        udErrorCode := TO_UDINT(E_ScrewdriverErrorCode.AdjustmentGripperFailed);
    END_IF;
    eStep := E_AdjustmentStep.Error;
END_IF;

IF fbMoveTimeout.Q AND NOT bError THEN
    bError := TRUE;
    bGripperError := FALSE;
    uiErrorAxis := uiMovingAxis;
    udErrorCode := TO_UDINT(E_ScrewdriverErrorCode.PositionTimeout);
    eStep := E_AdjustmentStep.Error;
END_IF;

CASE eStep OF
    E_AdjustmentStep.Idle:
        bAdjustmentDone := FALSE;

    E_AdjustmentStep.MoveXYToWork:
        IF NOT bXDone THEN
            bXDone := M_MoveAxisAbsolute(fTarget := fXWork, fVelocity := fXVelocity,
                uiAxis := GVL_AxisIndex.AdjustmentX, ioIssued := bXIssued, ioAxis := stAxisX);
        END_IF;
        IF NOT bYDone THEN
            bYDone := M_MoveAxisAbsolute(fTarget := fYWork, fVelocity := fYVelocity,
                uiAxis := GVL_AxisIndex.AdjustmentY, ioIssued := bYIssued, ioAxis := stAxisY);
        END_IF;
        IF bXDone AND bYDone THEN
            fAdjustTargetX := fXWork;
            fAdjustTargetY := fYWork;
            bZIssued := FALSE;
            bZDone := FALSE;
            eStep := E_AdjustmentStep.LowerZToWork;
        END_IF;

    E_AdjustmentStep.LowerZToWork:
        bZDone := M_MoveAxisAbsolute(fTarget := fZWork, fVelocity := fZVelocity,
            uiAxis := GVL_AxisIndex.AdjustmentZ, ioIssued := bZIssued, ioAxis := stAxisZ);
        IF bZDone THEN
            eStep := E_AdjustmentStep.OpenGripper;
        END_IF;

    E_AdjustmentStep.OpenGripper:
        IF ioAdjustGripperAction.bDone THEN
            eStep := E_AdjustmentStep.PrepareMeasurement;
        END_IF;

    E_AdjustmentStep.PrepareMeasurement:
        fCorrectionX := 0.0;
        fCorrectionY := 0.0;
        bVisionWithinTolerance := FALSE;
        // Simulation与Camera都从FB_CoaxVision的统一结果出口获取数据。
        eStep := E_AdjustmentStep.RequestMeasure;

    E_AdjustmentStep.RequestMeasure:
        fCorrectionX := 0.0;
        fCorrectionY := 0.0;
        bVisionWithinTolerance := FALSE;
        eStep := E_AdjustmentStep.WaitMeasureResult;

    E_AdjustmentStep.WaitMeasureResult:
        IF fbCoaxVision.bDone THEN
            fVisionCoaxiality := fbCoaxVision.stResult.fCoaxiality;
            fCorrectionX := fbCoaxVision.stResult.fDeltaX;
            fCorrectionY := fbCoaxVision.stResult.fDeltaY;

            IF fbCoaxVision.bVisionFault THEN
                bVisionFault := TRUE;
                bFallbackUsed := fbCoaxVision.bFallbackUsed;
                eVisionError := fbCoaxVision.eVisionError;
                bVisionTimeout :=
                    fbCoaxVision.eVisionError = E_VisionError.Timeout;
                // Fallback Delta为0；调试阶段跳过额外XY修正并继续二次拧紧。
                eStep := E_AdjustmentStep.RequestSecondTighten;
            ELSE
                bVisionWithinTolerance :=
                    fVisionCoaxiality <= GVL_ProcessConfig.stAdjustment.fAdjustTolerance;
                eStep := E_AdjustmentStep.EvaluateAdjustment;
            END_IF;
        END_IF;

    E_AdjustmentStep.EvaluateAdjustment:
        IF bVisionWithinTolerance
            OR (nAdjustCount >= GVL_ProcessConfig.stAdjustment.nMaxAdjustCount)
        THEN
            eStep := E_AdjustmentStep.RequestSecondTighten;
        ELSE
            // Vision的Delta是“从当前状态仍需修正的增量”；轴仍使用绝对目标。
            fAdjustTargetX := fAdjustTargetX + fCorrectionX;
            fAdjustTargetY := fAdjustTargetY + fCorrectionY;
            nAdjustCount := nAdjustCount + 1;
            eStep := E_AdjustmentStep.StartCorrectionXY;
        END_IF;

    E_AdjustmentStep.StartCorrectionXY:
        bXIssued := FALSE;
        bYIssued := FALSE;
        bXDone := FALSE;
        bYDone := FALSE;
        eStep := E_AdjustmentStep.WaitCorrectionXY;

    E_AdjustmentStep.WaitCorrectionXY:
        // Z保持工作高度，X/Y同时向累计后的绝对目标运动。
        IF NOT bXDone THEN
            bXDone := M_MoveAxisAbsolute(fTarget := fAdjustTargetX, fVelocity := fXVelocity,
                uiAxis := GVL_AxisIndex.AdjustmentX, ioIssued := bXIssued, ioAxis := stAxisX);
        END_IF;
        IF NOT bYDone THEN
            bYDone := M_MoveAxisAbsolute(fTarget := fAdjustTargetY, fVelocity := fYVelocity,
                uiAxis := GVL_AxisIndex.AdjustmentY, ioIssued := bYIssued, ioAxis := stAxisY);
        END_IF;
        IF bXDone AND bYDone THEN
            eStep := E_AdjustmentStep.RequestMeasure;
        END_IF;

    E_AdjustmentStep.RequestSecondTighten:
        eStep := E_AdjustmentStep.WaitSecondTighten;

    E_AdjustmentStep.WaitSecondTighten:
        IF bSecondTightenDone OR bRetractPermit THEN
            IF bVisionFault THEN
                // 视觉异常与真实测量0值明确区分；当前调试策略是不返调并继续撤离。
                bAdjustmentQualified := FALSE;
                eStep := E_AdjustmentStep.CloseGripper;
            ELSE
                eStep := E_AdjustmentStep.RequestFinalMeasure;
            END_IF;
        END_IF;

    E_AdjustmentStep.RequestFinalMeasure:
        fCorrectionX := 0.0;
        fCorrectionY := 0.0;
        bVisionWithinTolerance := FALSE;
        eStep := E_AdjustmentStep.WaitFinalMeasure;

    E_AdjustmentStep.WaitFinalMeasure:
        IF fbCoaxVision.bDone THEN
            fVisionCoaxiality := fbCoaxVision.stResult.fCoaxiality;
            fCorrectionX := fbCoaxVision.stResult.fDeltaX;
            fCorrectionY := fbCoaxVision.stResult.fDeltaY;

            IF fbCoaxVision.bVisionFault THEN
                bVisionFault := TRUE;
                bFallbackUsed := fbCoaxVision.bFallbackUsed;
                eVisionError := fbCoaxVision.eVisionError;
                bVisionTimeout :=
                    fbCoaxVision.eVisionError = E_VisionError.Timeout;
                bAdjustmentQualified := FALSE;
                eStep := E_AdjustmentStep.CloseGripper;
            ELSE
                bVisionWithinTolerance :=
                    fVisionCoaxiality <= GVL_ProcessConfig.stAdjustment.fQualifiedTolerance;
                eStep := E_AdjustmentStep.EvaluateFinalResult;
            END_IF;
        END_IF;

    E_AdjustmentStep.EvaluateFinalResult:
        IF bVisionWithinTolerance THEN
            bAdjustmentQualified := TRUE;
            eStep := E_AdjustmentStep.CloseGripper;
        ELSIF nReworkCount < GVL_ProcessConfig.stAdjustment.nMaxReworkCount THEN
            bAdjustmentQualified := FALSE;
            nReworkCount := nReworkCount + 1;
            eStep := E_AdjustmentStep.RequestReworkLoosen;
        ELSE
            bAdjustmentQualified := FALSE;
            eStep := E_AdjustmentStep.CloseGripper;
        END_IF;

    E_AdjustmentStep.RequestReworkLoosen:
        eStep := E_AdjustmentStep.WaitReworkLoosen;

    E_AdjustmentStep.WaitReworkLoosen:
        IF bReworkLoosenDone THEN
            // AdjustmentXYZ与COM4始终未撤离；仅重置本轮修正计数并重新检测。
            nAdjustCount := 0;
            fCorrectionX := 0.0;
            fCorrectionY := 0.0;
            bVisionWithinTolerance := FALSE;
            eStep := E_AdjustmentStep.RequestMeasure;
        END_IF;

    E_AdjustmentStep.CloseGripper:
        IF ioAdjustGripperAction.bDone THEN
            bZIssued := FALSE;
            bZDone := FALSE;
            eStep := E_AdjustmentStep.LiftZToSafe;
        END_IF;

    E_AdjustmentStep.LiftZToSafe:
        bZDone := M_MoveAxisAbsolute(fTarget := fZSafe, fVelocity := fZVelocity,
            uiAxis := GVL_AxisIndex.AdjustmentZ, ioIssued := bZIssued, ioAxis := stAxisZ);
        IF bZDone THEN
            bXIssued := FALSE;
            bYIssued := FALSE;
            bXDone := FALSE;
            bYDone := FALSE;
            eStep := E_AdjustmentStep.ReturnXYToStandby;
        END_IF;

    E_AdjustmentStep.ReturnXYToStandby:
        IF NOT bXDone THEN
            bXDone := M_MoveAxisAbsolute(fTarget := fXStandby, fVelocity := fXVelocity,
                uiAxis := GVL_AxisIndex.AdjustmentX, ioIssued := bXIssued, ioAxis := stAxisX);
        END_IF;
        IF NOT bYDone THEN
            bYDone := M_MoveAxisAbsolute(fTarget := fYStandby, fVelocity := fYVelocity,
                uiAxis := GVL_AxisIndex.AdjustmentY, ioIssued := bYIssued, ioAxis := stAxisY);
        END_IF;
        IF bXDone AND bYDone THEN
            bAdjustmentDone := TRUE;
            eStep := E_AdjustmentStep.WaitDoneAck;
        END_IF;

    E_AdjustmentStep.WaitDoneAck:
        bAdjustmentDone := TRUE;
        IF bDoneAck THEN
            bAdjustmentDone := FALSE;
            bAdjustmentQualified := FALSE;
            bXIssued := FALSE;
            bYIssued := FALSE;
            bZIssued := FALSE;
            bXDone := FALSE;
            bYDone := FALSE;
            bZDone := FALSE;
            eStep := E_AdjustmentStep.Idle;
        END_IF;

    E_AdjustmentStep.Error:
        bAdjustmentDone := FALSE;
        bError := TRUE;
END_CASE;

// 保持型握手由状态直接派生，避免单扫描脉冲丢失。
bRequestSecondTighten :=
    (eStep = E_AdjustmentStep.RequestSecondTighten)
    OR (eStep = E_AdjustmentStep.WaitSecondTighten);
bAdjustmentReady := bRequestSecondTighten;
bRequestReworkLoosen :=
    (eStep = E_AdjustmentStep.RequestReworkLoosen)
    OR (eStep = E_AdjustmentStep.WaitReworkLoosen);

IF eStep = E_AdjustmentStep.OpenGripper THEN
    bAdjustGripperActionExecute := TRUE;
    eAdjustGripperActionCommand := E_GripperCommand.Open;
ELSIF eStep = E_AdjustmentStep.CloseGripper THEN
    bAdjustGripperActionExecute := TRUE;
    eAdjustGripperActionCommand := E_GripperCommand.Close;
ELSE
    bAdjustGripperActionExecute := FALSE;
    eAdjustGripperActionCommand := E_GripperCommand.None;
END_IF;

bAdjustmentBusy :=
    (eStep <> E_AdjustmentStep.Idle)
    AND (eStep <> E_AdjustmentStep.Error);]]></ST>
    </Implementation>
    <Method Name="M_MoveAxisAbsolute" Id="{d92a53a5-1112-4138-b128-19cd21bfd66f}">
      <Declaration>METHOD PRIVATE M_MoveAxisAbsolute : BOOL
VAR_INPUT
    fTarget   : LREAL;
    fVelocity : LREAL;
    uiAxis    : UINT;
END_VAR
VAR_IN_OUT
    ioIssued : BOOL;
    ioAxis   : ST_AxisInterface;
END_VAR</Declaration>
      <Implementation>
        <ST><![CDATA[M_MoveAxisAbsolute := FALSE;

IF ioAxis.Alarm.bError THEN
    ioIssued := FALSE;
    RETURN;
END_IF;

IF ioAxis.State.bReady
    AND NOT ioAxis.State.bBusy
    AND NOT ioAxis.State.bActive
    AND (ABS(ioAxis.Data.fActPosition - fTarget) <= fPositionTolerance)
THEN
    ioIssued := FALSE;
    M_MoveAxisAbsolute := TRUE;
    RETURN;
END_IF;

IF NOT ioIssued THEN
    IF NOT ioAxis.State.bReady OR ioAxis.State.bBusy OR ioAxis.State.bActive THEN
        RETURN;
    END_IF;

    ioAxis.AutoSet.Position.fAbsolutePosition := fTarget;
    ioAxis.AutoSet.Position.fVelocity := fVelocity;
    ioAxis.AutoCmd.bMoveAbs := TRUE;
    ioIssued := TRUE;
    RETURN;
END_IF;

IF ioAxis.State.bCmdRejected OR ioAxis.State.bCommandAborted THEN
    bError := TRUE;
    bGripperError := FALSE;
    uiErrorAxis := uiAxis;
    udErrorCode := TO_UDINT(E_ScrewdriverErrorCode.AdjustmentCommandFailed);
    ioIssued := FALSE;
    eStep := E_AdjustmentStep.Error;
    RETURN;
END_IF;

IF ioAxis.State.bReady
    AND NOT ioAxis.State.bBusy
    AND (ABS(ioAxis.Data.fActPosition - fTarget) <= fPositionTolerance)
THEN
    ioIssued := FALSE;
    M_MoveAxisAbsolute := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
