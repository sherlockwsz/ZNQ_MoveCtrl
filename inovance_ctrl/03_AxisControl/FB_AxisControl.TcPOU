VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PrepareCommand" Id="{7f85a792-f6e9-4b73-8d02-924cadcf74bc}">
      <Declaration><![CDATA[//边沿检测、参数限幅、忙碌和错误互锁、命令接受判断
METHOD PRIVATE M_PrepareCommand
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateData" Id="{84000384-9550-4806-a23a-4bd7988cfdb2}">
      <Declaration><![CDATA[//更新位置、速度、转速、位置偏差
METHOD PRIVATE M_UpdateData
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateStateAlarm" Id="{1267e6b4-d7ac-4fd6-a151-1e95cc09de30}">
      <Declaration><![CDATA[//汇总Busy、Done、状态、错误来源和错误码
