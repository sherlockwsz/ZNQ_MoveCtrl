<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_AxisManager" Id="{a5239ea1-599b-4572-87dc-e1890577acbf}" SpecialFunc="None">
    <Declaration><![CDATA[//==============================================================
// 可复用单轴管理器
//
// 每个数组元素管理一根业务轴，由MAIN统一循环调用。
// 未配置轴只清除外部命令，不调用任何PLCopen运动功能块。
//==============================================================

FUNCTION_BLOCK FB_AxisManager

VAR_INPUT
    bAxisConfigured : BOOL;       // 当前数组下标是否已绑定有效NC轴
    bAxisUsedByAuto : BOOL;       // 是否属于当前整机自动流程轴清单
    eMachineMode : E_MachineMode; // 整机唯一运行模式
    bProtectionEnabled : BOOL;    // 是否启用HMI通信保护
    bHmiOnline : BOOL;            // HMI心跳在线状态
    bStopSequenceActive : BOOL;   // 受控停止期间使能权归停止管理器
    stLimit : ST_AxisLimit;       // 当前轴限位配置
END_VAR

VAR_IN_OUT
    AxisRef : AXIS_REF;           // TwinCAT NC轴引用
    stAxis : ST_AxisInterface;    // 单轴ADS接口和运行反馈
END_VAR

VAR_OUTPUT
    bCommandsSafe : BOOL;
    bControlAllowed : BOOL;
    bRequireEnableReset : BOOL;
    eControlOwner : E_AxisControlOwner;
    bOwnerChanged : BOOL;
    bManualCommandRejected : BOOL;
    bAutoCommandRejected : BOOL;
END_VAR

VAR
    fbCommandGuard : FB_AxisCommandGuard;
    fbCommandArbiter : FB_AxisCommandArbiter;
    fbAxisControl : FB_AxisControl;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//==============================================================
// 1. 只保护WPF手动命令源Cmd；自动、回零和Stop有独立通道
//==============================================================
IF bAxisConfigured THEN
    //==========================================================
    // 1. 处理已配置轴的外部命令保护和重新授权
    //==========================================================
    fbCommandGuard(
        bProtectionEnabled := bProtectionEnabled,
        bCommunicationOnline := bHmiOnline,
        bHoldEnableForStop := bStopSequenceActive,
        ioCmd := stAxis.Cmd
    );

    bCommandsSafe := fbCommandGuard.bCommandsSafe;
    bControlAllowed := fbCommandGuard.bControlAllowed;
    bRequireEnableReset := fbCommandGuard.bRequireEnableReset;

ELSE
    bCommandsSafe := TRUE;
    bControlAllowed := FALSE;
    bRequireEnableReset := FALSE;
END_IF;

//==============================================================
// 2. 每根轴只允许一个命令源进入ActiveCmd/ActiveSet
// 未配置轴也调用仲裁器，以持续清除所有来源的残留命令。
//==============================================================
fbCommandArbiter(
    bAxisConfigured := bAxisConfigured,
    bAxisUsedByAuto := bAxisUsedByAuto,
    eMachineMode := eMachineMode,
    stAxis := stAxis
);

eControlOwner := fbCommandArbiter.eOwner;
bOwnerChanged := fbCommandArbiter.bOwnerChanged;
bManualCommandRejected := fbCommandArbiter.bManualCommandRejected;
bAutoCommandRejected := fbCommandArbiter.bAutoCommandRejected;

//==============================================================
// 3. 仅对已映射NC轴执行仲裁后的唯一Active命令
//==============================================================
IF bAxisConfigured THEN
    fbAxisControl(
        bControlAllowed :=
            bControlAllowed
            OR (eControlOwner = E_AxisControlOwner.Stop)
            OR (eControlOwner = E_AxisControlOwner.Recovery),
        stLimit := stLimit,
        AxisRef := AxisRef,
        stAxis := stAxis
    );
END_IF;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
