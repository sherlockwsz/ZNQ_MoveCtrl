<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_ScrewdriverProcess" Id="{69c8edf6-10e2-4dec-a0f5-1fc8ed61fc43}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ScrewdriverProcess
VAR_INPUT
    bEnable            : BOOL;
    bAbort             : BOOL;
    bReset             : BOOL;
    bCycleRequest      : BOOL; // 协调器保持型周期请求
    bWorkpieceSecured  : BOOL; // 工件已可靠固定
    bCycleDoneAck      : BOOL; // 协调器已处理本周期完成信号
    bMachinePrepared   : BOOL;

    // 显式业务握手；请求方保持到相应Done返回。
    bRequestSecondTighten : BOOL;
    bRequestReworkLoosen  : BOOL;
    bProcessDone          : BOOL;

    // 保留原输入符号以兼容现有监控；协调器给它与显式二次拧紧请求相同的值。
    bProcessReady : BOOL;
END_VAR

VAR_IN_OUT
    stAxisY : ST_AxisInterface;
    stAxisZ : ST_AxisInterface;
END_VAR

VAR_OUTPUT
    bRequestAccepted      : BOOL;
    bScrewdriverSafe      : BOOL;
    bBusy                 : BOOL;
    bError                : BOOL;
    uiErrorAxis           : UINT;
    udErrorCode           : UDINT;
    eStep                 : E_ScrewdriverStep := E_ScrewdriverStep.Idle;
    bPreTighteningDone    : BOOL;
    bSecondTighteningDone : BOOL;
    bReworkLoosenDone     : BOOL;
    bScrewdriverStopRequired : BOOL;
    bScrewdriverStopDone  : BOOL;
    bScrewdriverStopError : BOOL;
    uiFaultScrewdriver    : UINT;
    eScrewdriverActionStep : E_DualScrewdriverActionStep := E_DualScrewdriverActionStep.Idle;
END_VAR

VAR
    fYZero : LREAL;
    fYWork : LREAL;
    fZSafe : LREAL;
    fZWork : LREAL;
    fScrewdriverPositionTolerance : LREAL;
    fYVelocity : LREAL;
    fZVelocity : LREAL;
    tScrewdriverMoveTimeout : TIME;

    fbDualScrewdriverAction : FB_DualScrewdriverAction;
    fbMoveTimeout : TON;
    eScrewdriverActionMode : E_ScrewdriverActionMode := E_ScrewdriverActionMode.None;

    bInitialized   : BOOL;
    bCycleAccepted : BOOL;
    bMoveIssued    : BOOL;
    uiMovingAxis   : UINT;
    bTimedMovement : BOOL;
    bTimerRestart  : BOOL;
    eTimedStep     : E_ScrewdriverStep := E_ScrewdriverStep.Idle;
    eInternalStep  : E_ScrewdriverStep := E_ScrewdriverStep.Idle;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 每周期从现有唯一参数源更新执行缓存。
fYZero := GVL_PositionConfig.stScrewdriver.stReady.Y;
fYWork := GVL_PositionConfig.stScrewdriver.stWork.Y;
fZSafe := GVL_PositionConfig.stScrewdriver.stReady.Z;
fZWork := GVL_PositionConfig.stScrewdriver.stWork.Z;
fScrewdriverPositionTolerance := GVL_MotionConfig.stScrewdriver.fPositionTolerance;
fYVelocity := GVL_MotionConfig.stScrewdriver.stY.fVelocity;
fZVelocity := GVL_MotionConfig.stScrewdriver.stZ.fVelocity;
tScrewdriverMoveTimeout := GVL_MotionConfig.stScrewdriver.tMoveTimeout;

// 高层步骤只选择工艺模式；COM5/COM6同步、运行确认、计时和Stop回显
// 继续由现有双机动作FB跨扫描周期完成。
IF eInternalStep = E_ScrewdriverStep.WaitPreTighten THEN
    eScrewdriverActionMode := E_ScrewdriverActionMode.PreTighten;
ELSIF eInternalStep = E_ScrewdriverStep.WaitSecondTighten THEN
    eScrewdriverActionMode := E_ScrewdriverActionMode.FinalTighten;
ELSIF eInternalStep = E_ScrewdriverStep.WaitReworkLoosen THEN
    eScrewdriverActionMode := E_ScrewdriverActionMode.ReworkLoosen;
ELSE
    eScrewdriverActionMode := E_ScrewdriverActionMode.None;
END_IF;

fbDualScrewdriverAction(
    bExecute :=
        bEnable
        AND NOT bAbort
        AND
        (
            (eInternalStep = E_ScrewdriverStep.WaitPreTighten)
            OR (eInternalStep = E_ScrewdriverStep.WaitSecondTighten)
            OR (eInternalStep = E_ScrewdriverStep.WaitReworkLoosen)
        ),
    eMode := eScrewdriverActionMode,
    bCancel := bAbort OR NOT bEnable,
    bReset := bReset,
    tPreTightenDuration := GVL_ProcessConfig.stScrewdriver.tPreTightenDuration,
    tPreLoosenDuration := GVL_ProcessConfig.stScrewdriver.tPreLoosenDuration,
    tFinalTightenDuration := GVL_ProcessConfig.stScrewdriver.tFinalTightenDuration,
    tReworkLoosenDuration := GVL_ProcessConfig.stScrewdriver.tReworkLoosenDuration,
    ioScrewdriver1 := GVL_Screwdriver.stScrewdriver1,
    ioScrewdriver2 := GVL_Screwdriver.stScrewdriver2
);

bScrewdriverStopRequired := fbDualScrewdriverAction.bStopRequired;
bScrewdriverStopDone := fbDualScrewdriverAction.bStopDone;
bScrewdriverStopError := fbDualScrewdriverAction.bStopError;
uiFaultScrewdriver := fbDualScrewdriverAction.uiFaultScrewdriver;
eScrewdriverActionStep := fbDualScrewdriverAction.eStep;

bTimerRestart := (eInternalStep <> eTimedStep);
eTimedStep := eInternalStep;
bTimedMovement :=
    (eInternalStep = E_ScrewdriverStep.InitializeSafeZ)
    OR (eInternalStep = E_ScrewdriverStep.InitializeYZero)
    OR (eInternalStep = E_ScrewdriverStep.MoveYForPreTighten)
    OR (eInternalStep = E_ScrewdriverStep.LowerForPreTighten)
    OR (eInternalStep = E_ScrewdriverStep.LiftAfterPreTighten)
    OR (eInternalStep = E_ScrewdriverStep.RetreatYToSafe)
    OR (eInternalStep = E_ScrewdriverStep.MoveYForSecondTighten)
    OR (eInternalStep = E_ScrewdriverStep.LowerForSecondTighten)
    OR (eInternalStep = E_ScrewdriverStep.LiftAfterSecondTighten)
    OR (eInternalStep = E_ScrewdriverStep.RetreatYAfterSecondTighten)
    OR (eInternalStep = E_ScrewdriverStep.MoveYForReworkLoosen)
    OR (eInternalStep = E_ScrewdriverStep.LowerForReworkLoosen)
    OR (eInternalStep = E_ScrewdriverStep.LiftAfterReworkLoosen)
    OR (eInternalStep = E_ScrewdriverStep.RetreatYAfterReworkLoosen);

IF bTimedMovement THEN
    CASE eInternalStep OF
        E_ScrewdriverStep.InitializeSafeZ,
        E_ScrewdriverStep.LowerForPreTighten,
        E_ScrewdriverStep.LiftAfterPreTighten,
        E_ScrewdriverStep.LowerForSecondTighten,
        E_ScrewdriverStep.LiftAfterSecondTighten,
        E_ScrewdriverStep.LowerForReworkLoosen,
        E_ScrewdriverStep.LiftAfterReworkLoosen:
            uiMovingAxis := GVL_AxisIndex.ScrewdriverZ;

        E_ScrewdriverStep.InitializeYZero,
        E_ScrewdriverStep.MoveYForPreTighten,
        E_ScrewdriverStep.RetreatYToSafe,
        E_ScrewdriverStep.MoveYForSecondTighten,
        E_ScrewdriverStep.RetreatYAfterSecondTighten,
        E_ScrewdriverStep.MoveYForReworkLoosen,
        E_ScrewdriverStep.RetreatYAfterReworkLoosen:
            uiMovingAxis := GVL_AxisIndex.ScrewdriverY;
    END_CASE;
END_IF;

fbMoveTimeout(
    IN := bEnable AND NOT bAbort AND bTimedMovement AND NOT bTimerRestart,
    PT := tScrewdriverMoveTimeout
);

// 本FB只写ScrewdriverY/Z自动命令源。
stAxisY.AutoCmd.bMoveAbs := FALSE;
stAxisZ.AutoCmd.bMoveAbs := FALSE;

IF NOT bEnable OR bAbort THEN
    bRequestAccepted := FALSE;
    bScrewdriverSafe := FALSE;
    bBusy := FALSE;
    bError := FALSE;
    bInitialized := FALSE;
    bCycleAccepted := FALSE;
    bMoveIssued := FALSE;
    bPreTighteningDone := FALSE;
    bSecondTighteningDone := FALSE;
    bReworkLoosenDone := FALSE;
    uiErrorAxis := 0;
    udErrorCode := TO_UDINT(E_ScrewdriverErrorCode.None);
    eInternalStep := E_ScrewdriverStep.Idle;
    eStep := E_ScrewdriverStep.Idle;
    RETURN;
END_IF;

IF bMachinePrepared AND NOT bInitialized AND (eInternalStep = E_ScrewdriverStep.Idle) THEN
    bInitialized := TRUE;
END_IF;

IF bReset AND (eInternalStep = E_ScrewdriverStep.Error) THEN
    bError := FALSE;
    uiErrorAxis := 0;
    udErrorCode := TO_UDINT(E_ScrewdriverErrorCode.None);
    bMoveIssued := FALSE;
    bInitialized := FALSE;
    eInternalStep := E_ScrewdriverStep.Idle;
END_IF;

IF stAxisY.Alarm.bError OR stAxisZ.Alarm.bError THEN
    bError := TRUE;
    eInternalStep := E_ScrewdriverStep.Error;
    IF stAxisY.Alarm.bError THEN
        uiErrorAxis := GVL_AxisIndex.ScrewdriverY;
        udErrorCode := stAxisY.Alarm.nErrorID;
    ELSE
        uiErrorAxis := GVL_AxisIndex.ScrewdriverZ;
        udErrorCode := stAxisZ.Alarm.nErrorID;
    END_IF;
END_IF;

IF fbDualScrewdriverAction.bError AND NOT bError THEN
    bError := TRUE;
    uiErrorAxis := 0;
    udErrorCode := fbDualScrewdriverAction.udErrorCode;
    bMoveIssued := FALSE;
    eInternalStep := E_ScrewdriverStep.Error;
END_IF;

IF fbMoveTimeout.Q AND NOT bError THEN
    bError := TRUE;
    uiErrorAxis := uiMovingAxis;
    udErrorCode := TO_UDINT(E_ScrewdriverErrorCode.PositionTimeout);
    bMoveIssued := FALSE;
    eInternalStep := E_ScrewdriverStep.Error;
END_IF;

CASE eInternalStep OF
    E_ScrewdriverStep.Idle:
        bCycleAccepted := FALSE;
        bPreTighteningDone := FALSE;
        bSecondTighteningDone := FALSE;
        bReworkLoosenDone := FALSE;
        bScrewdriverSafe := bInitialized;

        IF NOT bInitialized THEN
            bScrewdriverSafe := FALSE;
            eInternalStep := E_ScrewdriverStep.InitializeSafeZ;
        ELSIF bCycleRequest AND bWorkpieceSecured THEN
            bCycleAccepted := TRUE;
            bScrewdriverSafe := FALSE;
            eInternalStep := E_ScrewdriverStep.MoveYForPreTighten;
        END_IF;

    E_ScrewdriverStep.InitializeSafeZ:
        IF M_MoveAxisAbsolute(fTarget := fZSafe, fVelocity := fZVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverZ, ioAxis := stAxisZ) THEN
            eInternalStep := E_ScrewdriverStep.InitializeYZero;
        END_IF;

    E_ScrewdriverStep.InitializeYZero:
        IF M_MoveAxisAbsolute(fTarget := fYZero, fVelocity := fYVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverY, ioAxis := stAxisY) THEN
            bInitialized := TRUE;
            bScrewdriverSafe := TRUE;
            eInternalStep := E_ScrewdriverStep.Idle;
        END_IF;

    E_ScrewdriverStep.MoveYForPreTighten:
        IF M_MoveAxisAbsolute(fTarget := fYWork, fVelocity := fYVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverY, ioAxis := stAxisY) THEN
            eInternalStep := E_ScrewdriverStep.LowerForPreTighten;
        END_IF;

    E_ScrewdriverStep.LowerForPreTighten:
        IF M_MoveAxisAbsolute(fTarget := fZWork, fVelocity := fZVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverZ, ioAxis := stAxisZ) THEN
            eInternalStep := E_ScrewdriverStep.WaitPreTighten;
        END_IF;

    E_ScrewdriverStep.WaitPreTighten:
        IF fbDualScrewdriverAction.bDone THEN
            eInternalStep := E_ScrewdriverStep.LiftAfterPreTighten;
        END_IF;

    E_ScrewdriverStep.LiftAfterPreTighten:
        IF M_MoveAxisAbsolute(fTarget := fZSafe, fVelocity := fZVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverZ, ioAxis := stAxisZ) THEN
            eInternalStep := E_ScrewdriverStep.RetreatYToSafe;
        END_IF;

    E_ScrewdriverStep.RetreatYToSafe:
        IF M_MoveAxisAbsolute(fTarget := fYZero, fVelocity := fYVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverY, ioAxis := stAxisY) THEN
            bPreTighteningDone := TRUE;
            bScrewdriverSafe := TRUE;
            eInternalStep := E_ScrewdriverStep.WaitProcessRequest;
        END_IF;

    E_ScrewdriverStep.WaitProcessRequest:
        bPreTighteningDone := TRUE;
        bScrewdriverSafe := TRUE;
        IF bProcessDone THEN
            eInternalStep := E_ScrewdriverStep.WaitDoneAck;
        ELSIF bRequestReworkLoosen THEN
            bReworkLoosenDone := FALSE;
            bScrewdriverSafe := FALSE;
            eInternalStep := E_ScrewdriverStep.MoveYForReworkLoosen;
        ELSIF bRequestSecondTighten OR bProcessReady THEN
            bSecondTighteningDone := FALSE;
            bScrewdriverSafe := FALSE;
            eInternalStep := E_ScrewdriverStep.MoveYForSecondTighten;
        END_IF;

    E_ScrewdriverStep.MoveYForSecondTighten:
        IF M_MoveAxisAbsolute(fTarget := fYWork, fVelocity := fYVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverY, ioAxis := stAxisY) THEN
            eInternalStep := E_ScrewdriverStep.LowerForSecondTighten;
        END_IF;

    E_ScrewdriverStep.LowerForSecondTighten:
        IF M_MoveAxisAbsolute(fTarget := fZWork, fVelocity := fZVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverZ, ioAxis := stAxisZ) THEN
            eInternalStep := E_ScrewdriverStep.WaitSecondTighten;
        END_IF;

    E_ScrewdriverStep.WaitSecondTighten:
        IF fbDualScrewdriverAction.bDone THEN
            eInternalStep := E_ScrewdriverStep.LiftAfterSecondTighten;
        END_IF;

    E_ScrewdriverStep.LiftAfterSecondTighten:
        IF M_MoveAxisAbsolute(fTarget := fZSafe, fVelocity := fZVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverZ, ioAxis := stAxisZ) THEN
            eInternalStep := E_ScrewdriverStep.RetreatYAfterSecondTighten;
        END_IF;

    E_ScrewdriverStep.RetreatYAfterSecondTighten:
        IF M_MoveAxisAbsolute(fTarget := fYZero, fVelocity := fYVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverY, ioAxis := stAxisY) THEN
            bScrewdriverSafe := TRUE;
            bSecondTighteningDone := TRUE;
            eInternalStep := E_ScrewdriverStep.WaitSecondTightenAck;
        END_IF;

    E_ScrewdriverStep.WaitSecondTightenAck:
        bScrewdriverSafe := TRUE;
        bSecondTighteningDone := TRUE;
        IF NOT (bRequestSecondTighten OR bProcessReady) THEN
            bSecondTighteningDone := FALSE;
            eInternalStep := E_ScrewdriverStep.WaitProcessRequest;
        END_IF;

    E_ScrewdriverStep.MoveYForReworkLoosen:
        IF M_MoveAxisAbsolute(fTarget := fYWork, fVelocity := fYVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverY, ioAxis := stAxisY) THEN
            eInternalStep := E_ScrewdriverStep.LowerForReworkLoosen;
        END_IF;

    E_ScrewdriverStep.LowerForReworkLoosen:
        IF M_MoveAxisAbsolute(fTarget := fZWork, fVelocity := fZVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverZ, ioAxis := stAxisZ) THEN
            eInternalStep := E_ScrewdriverStep.WaitReworkLoosen;
        END_IF;

    E_ScrewdriverStep.WaitReworkLoosen:
        IF fbDualScrewdriverAction.bDone THEN
            eInternalStep := E_ScrewdriverStep.LiftAfterReworkLoosen;
        END_IF;

    E_ScrewdriverStep.LiftAfterReworkLoosen:
        IF M_MoveAxisAbsolute(fTarget := fZSafe, fVelocity := fZVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverZ, ioAxis := stAxisZ) THEN
            eInternalStep := E_ScrewdriverStep.RetreatYAfterReworkLoosen;
        END_IF;

    E_ScrewdriverStep.RetreatYAfterReworkLoosen:
        IF M_MoveAxisAbsolute(fTarget := fYZero, fVelocity := fYVelocity,
            uiAxis := GVL_AxisIndex.ScrewdriverY, ioAxis := stAxisY) THEN
            bScrewdriverSafe := TRUE;
            bReworkLoosenDone := TRUE;
            eInternalStep := E_ScrewdriverStep.WaitReworkLoosenAck;
        END_IF;

    E_ScrewdriverStep.WaitReworkLoosenAck:
        bScrewdriverSafe := TRUE;
        bReworkLoosenDone := TRUE;
        IF NOT bRequestReworkLoosen THEN
            bReworkLoosenDone := FALSE;
            eInternalStep := E_ScrewdriverStep.WaitProcessRequest;
        END_IF;

    E_ScrewdriverStep.WaitDoneAck:
        bScrewdriverSafe := TRUE;
        IF bCycleDoneAck THEN
            bScrewdriverSafe := FALSE;
            bPreTighteningDone := FALSE;
            bSecondTighteningDone := FALSE;
            bReworkLoosenDone := FALSE;
            eInternalStep := E_ScrewdriverStep.Idle;
        END_IF;

    E_ScrewdriverStep.Error:
        bScrewdriverSafe := FALSE;
        bError := TRUE;
END_CASE;

bRequestAccepted := bCycleRequest AND bCycleAccepted;
eStep := eInternalStep;
bBusy :=
    (eInternalStep <> E_ScrewdriverStep.Idle)
    AND (eInternalStep <> E_ScrewdriverStep.Error);]]></ST>
    </Implementation>
    <Method Name="M_MoveAxisAbsolute" Id="{bfc0332f-7a5f-4d81-9b60-94a3464198df}">
      <Declaration><![CDATA[METHOD PRIVATE M_MoveAxisAbsolute : BOOL
VAR_INPUT
    fTarget   : LREAL;
    fVelocity : LREAL;
    uiAxis    : UINT;
END_VAR
VAR_IN_OUT
    ioAxis : ST_AxisInterface;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_MoveAxisAbsolute := FALSE;

IF NOT bMoveIssued THEN
    IF NOT ioAxis.State.bReady THEN
        RETURN;
    END_IF;

    IF ABS(ioAxis.Data.fActPosition - fTarget)
       <= fScrewdriverPositionTolerance THEN
        M_MoveAxisAbsolute := TRUE;
        RETURN;
    END_IF;

    ioAxis.AutoSet.Position.fAbsolutePosition := fTarget;
    ioAxis.AutoSet.Position.fVelocity := fVelocity;
    ioAxis.AutoCmd.bMoveAbs := TRUE;
    bMoveIssued := TRUE;
    uiMovingAxis := uiAxis;
    RETURN;
END_IF;

IF ioAxis.State.bCmdRejected OR ioAxis.State.bCommandAborted THEN
    bError := TRUE;
    uiErrorAxis := uiAxis;
    udErrorCode := TO_UDINT(E_ScrewdriverErrorCode.ScrewdriverCommandFailed);
    bMoveIssued := FALSE;
    eInternalStep := E_ScrewdriverStep.Error;
    RETURN;
END_IF;

IF ioAxis.State.bReady
   AND (ABS(ioAxis.Data.fActPosition - fTarget)
        <= fScrewdriverPositionTolerance) THEN
    bMoveIssued := FALSE;
    M_MoveAxisAbsolute := TRUE;
END_IF;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
