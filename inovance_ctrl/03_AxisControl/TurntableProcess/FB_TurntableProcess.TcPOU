<?xml version='1.0' encoding='utf-8'?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_TurntableProcess" Id="{e1cd4f36-8de1-47fb-8826-32ee654f2542}" SpecialFunc="None">
    <Declaration>FUNCTION_BLOCK FB_TurntableProcess

VAR_IN_OUT
    // 已经存在的统一轴接口。
    stTurntableAxis : ST_AxisInterface; // GVL_AxisRef.Turntable
    stClampingAxis  : ST_AxisInterface; // GVL_AxisRef.Clamping

    // 与FB_DamperProcess共享两个物理位置的内容状态。
    eTransferPositionState   : E_DamperSlotState;
    eAdjustmentPositionState : E_DamperSlotState;
END_VAR

VAR_INPUT
    stInput : ST_DamperTurntableInput;
	bMachinePrepared : BOOL;
END_VAR

VAR_OUTPUT
    stStatus : ST_DamperTurntableStatus;
END_VAR

VAR
    //==========================================================
    // 当前均为模拟临时参数，实机调试前必须重新确认。
    //==========================================================
    stConfig : ST_DamperTurntableConfig := (
		bSimulationMode := FALSE,
		// 关闭“转台内部3秒后直接判合格”和“无需受理信号直接通过请求”。
		// 夹紧轴使用实际位置及实际转矩反馈，不使用延时模拟；
		// 三段动作模拟改由FB_ScrewdriverProcess执行。        
		bRequireHomed := FALSE,
        bUseVisionValidation := FALSE,

        fTurntablePosition0 := 0.0,
        fTurntablePosition180 := 0.0,
        fTurntableVelocity := GVL_MotionConfig.stTurntable.fVelocity,
        fTurntableAcceleration := GVL_MotionConfig.stTurntable.fAcceleration,
        fTurntableDeceleration := GVL_MotionConfig.stTurntable.fDeceleration,
        fTurntablePositionTolerance := GVL_MotionConfig.stTurntable.fPositionTolerance,
        tTurntableMoveTimeout := GVL_MotionConfig.stTurntable.tMoveTimeout,

        // 当前夹紧轴测试参数，实机调试后按测量结果修正。
        fClampOpenPosition := 0.0,
        fClampApproachPosition := 0.0,
        fClampMinimumPosition := 0.0,
        fClampPositionVelocity := GVL_MotionConfig.stClamping.fVelocity,
        fClampPositionAcceleration := GVL_MotionConfig.stClamping.fAcceleration,
        fClampPositionDeceleration := GVL_MotionConfig.stClamping.fDeceleration,
        fClampPositionTolerance := GVL_MotionConfig.stClamping.fPositionTolerance,
        tClampPositionTimeout := GVL_MotionConfig.stClamping.tMoveTimeout,

        ClampTorque := (
            // 夹紧方向为负向，初始测试使用额定转矩的10%。
            fTargetTorquePercent := GVL_ProcessConfig.stClamping.stTorque.fTargetTorquePercent,
            fMaxAbsTorquePercent := GVL_ProcessConfig.stClamping.stTorque.fMaxAbsTorquePercent,
            fTorqueRampPercentPerSecond := GVL_ProcessConfig.stClamping.stTorque.fTorqueRampPercentPerSecond,
            fVelocityLimitHigh := GVL_ProcessConfig.stClamping.stTorque.fVelocityLimitHigh,
            fVelocityLimitLow := GVL_ProcessConfig.stClamping.stTorque.fVelocityLimitLow,
            fReachedMinAbsTorquePercent := GVL_ProcessConfig.stClamping.stTorque.fReachedMinAbsTorquePercent,
            tReachedStableTime := GVL_ProcessConfig.stClamping.stTorque.tReachedStableTime,
            tTorqueBuildTimeout := GVL_ProcessConfig.stClamping.stTorque.tTorqueBuildTimeout,
            tModeSwitchTimeout := GVL_ProcessConfig.stClamping.stTorque.tModeSwitchTimeout
        )
    );
	
	// 转矩建立超时监控。
    fbClampTorqueBuildTimeout : TON;
	// 夹紧轴位置运动超时监控。
	fbClampMoveTimeout : TON;
	// 转台位置运动超时监控。
	fbTurntableMoveTimeout : TON;
	// 等待MC_MoveAbsolute完全结束、轴重新Ready的超时。
	fbClampPositionReleaseTimeout : TON;
	
	// 等待MC_TorqueControl进入Active状态的超时。
	fbClampModeSwitchTimeout : TON;
	// 从CST退出、恢复CSP并运动到最小允许位置的总超时。
	fbClampPositionHoldTimeout : TON;
	
	trigReset : R_TRIG;

    bInitialized : BOOL;
    bFinalExchange : BOOL;
	bOwnsAxes : BOOL;
    bTurntableCommandIssued : BOOL;
    bClampCommandIssued     : BOOL;

    // RequestAdjustment步骤使用，确保模拟模式下请求至少保持一个扫描周期。
    bAdjustmentRequestIssued : BOOL;

    fTurntableTargetPosition : LREAL;
    eTurntableTargetPosition : E_DamperTurntablePosition;

    ePositionStateTemp : E_DamperSlotState;
	
	// 转台自动流程使能下降沿。
	// 只在自动流程退出时清理一次自动命令。
	trigDisable : F_TRIG;

END_VAR
</Declaration>
    <Implementation>
      <ST><![CDATA[//==============================================================
// 1. 输入沿与模拟定时器
//==============================================================
stConfig.fTurntablePosition0 := GVL_PositionConfig.stTurntable.fPosition0;
stConfig.fTurntablePosition180 := GVL_PositionConfig.stTurntable.fPosition180;
stConfig.fClampOpenPosition := GVL_PositionConfig.stClamping.fReadyPosition;
stConfig.fClampApproachPosition := GVL_PositionConfig.stClamping.fApproachPosition;
stConfig.fClampMinimumPosition := GVL_SafetyConfig.stClamping.fMinimumAllowedPosition;
trigReset(CLK := stInput.bReset);

trigDisable(
    CLK := stInput.bEnable
);

//==============================================================
// Turntable位置运动超时
//==============================================================
fbTurntableMoveTimeout(
    IN :=
        stInput.bEnable
        AND
        (
            (stStatus.eStep = E_DamperTurntableStep.WaitInitialTurntable)
            OR
            (stStatus.eStep = E_DamperTurntableStep.WaitTurntableInPosition)
        ),
    PT := stConfig.tTurntableMoveTimeout
);

//==============================================================
// Clamping位置运动超时
// 不与退出CST后的恢复位置保持超时重复计时。
//==============================================================
fbClampMoveTimeout(
    IN :=
        stInput.bEnable
        AND
        (
            (stStatus.eStep = E_DamperTurntableStep.WaitInitialClampOpen)
            OR
            (stStatus.eStep = E_DamperTurntableStep.WaitClampOpen)
            OR
            (
                (stStatus.eStep = E_DamperTurntableStep.WaitClampHolding)
                AND
                (stStatus.eClampStep = E_DamperClampStep.WaitApproach)
            )
        ),
    PT := stConfig.tClampPositionTimeout
);

//==============================================================
// 等待位置运动完全释放
//
// 到达接近位置只代表进入位置公差，不代表MC_MoveAbsolute.Busy
// 已经变为FALSE。因此必须等待轴重新Ready。
//==============================================================
fbClampPositionReleaseTimeout(
    IN :=
        (stStatus.eStep = E_DamperTurntableStep.WaitClampHolding)
        AND
        (
            stStatus.eClampStep
            = E_DamperClampStep.WaitPositionReleased
        ),
    PT := stConfig.ClampTorque.tModeSwitchTimeout
);

//==============================================================
// 位置保持转换超时
//
// 当位置先到达最小允许位置时：
// 1. 退出CST；
// 2. 等待恢复CSP；
// 3. 使用位置模式保持最小允许位置。
// 从退出CST开始，到CSP重新定位完成的总超时。
//==============================================================
fbClampPositionHoldTimeout(
    IN :=
        (stStatus.eStep = E_DamperTurntableStep.WaitClampHolding)
        AND
        (
            (
                stStatus.eClampStep
                = E_DamperClampStep.ExitTorqueForPosition
            )
            OR
            (
                stStatus.eClampStep
                = E_DamperClampStep.RestorePositionForHold
            )
            OR
            (
                stStatus.eClampStep
                = E_DamperClampStep.WaitPositionHold
            )
        ),
    PT := stConfig.tClampPositionTimeout
);

//==============================================================
// 等待转矩模式切换完成
//==============================================================
fbClampModeSwitchTimeout(
    IN :=
        (stStatus.eStep = E_DamperTurntableStep.WaitClampHolding)
        AND
        (
            stStatus.eClampStep
            = E_DamperClampStep.SwitchToTorque
        ),
    PT := stConfig.ClampTorque.tModeSwitchTimeout
);


//==============================================================
// 等待夹紧转矩或最深允许位置
//==============================================================
fbClampTorqueBuildTimeout(
    IN :=
        (stStatus.eStep = E_DamperTurntableStep.WaitClampHolding)
        AND
        (
            stStatus.eClampStep
            = E_DamperClampStep.BuildTorque
        ),
    PT := stConfig.ClampTorque.tTorqueBuildTimeout
);


//==============================================================
// 2. 默认清除一次性轴命令
//
// 初始化、交换请求或转台流程执行期间才接管轴命令。
// 空闲状态下不清除WPF的手动运动命令。
//==============================================================
bOwnsAxes :=
	stInput.bEnable
	AND
	(
		NOT bInitialized
		OR stInput.bExchangeRequest
		OR
		(
			stStatus.eStep
			<> E_DamperTurntableStep.Idle
		)
	);

IF bOwnsAxes THEN
	
	stTurntableAxis.AutoCmd.bMoveAbs := FALSE;
	stClampingAxis.AutoCmd.bMoveAbs := FALSE;

	// 每周期默认撤销转矩请求；
	// 只有SwitchToTorque、BuildTorque或HoldTorque步骤重新置位。
	stClampingAxis.AutoCmd.bTorqueControl := FALSE;
END_IF;

//==============================================================
// 自动流程退出或流程复位时，只清理一次自动运动命令
//
// 不能在stInput.bEnable=FALSE期间持续清理，
// 否则会覆盖WPF手动控制命令。
//==============================================================
IF trigDisable.Q OR trigReset.Q THEN
    // 转台轴命令。
    stTurntableAxis.AutoCmd.bMoveAbs := FALSE;
    stTurntableAxis.AutoCmd.bMoveRel := FALSE;
    stTurntableAxis.AutoCmd.bJogPos := FALSE;
    stTurntableAxis.AutoCmd.bJogNeg := FALSE;

    // 夹紧轴命令。
    stClampingAxis.AutoCmd.bMoveAbs := FALSE;
    stClampingAxis.AutoCmd.bMoveRel := FALSE;
    stClampingAxis.AutoCmd.bJogPos := FALSE;
    stClampingAxis.AutoCmd.bJogNeg := FALSE;
    stClampingAxis.AutoCmd.bTorqueControl := FALSE;
END_IF;
//==============================================================
// 3. 模拟或实际调整完成处理
//==============================================================
// 预拧紧已结束且螺丝刀确实撤离后，才显示/进入调整中。
IF stInput.bEnable
   AND stInput.bAdjustmentStarted
   AND
   (eAdjustmentPositionState
    = E_DamperSlotState.PendingAdjustment) THEN
    eAdjustmentPositionState := E_DamperSlotState.Adjusting;
END_IF;

// 实机调整流程预留：根据外部结果更新调整位状态。
IF
    (NOT stConfig.bSimulationMode)
    AND stInput.bAdjustmentDone
    AND
    (
        eAdjustmentPositionState
        = E_DamperSlotState.Adjusting
    )
THEN
    IF stInput.bAdjustmentQualified THEN
        eAdjustmentPositionState := E_DamperSlotState.Qualified;
    ELSE
        eAdjustmentPositionState := E_DamperSlotState.Unqualified;
    END_IF;

    stStatus.bAdjustmentDoneAck := TRUE;
END_IF;

// 完成方撤销bAdjustmentDone后，接收方撤销Ack。
IF NOT stInput.bAdjustmentDone THEN
    stStatus.bAdjustmentDoneAck := FALSE;
END_IF;


//==============================================================
// 4. 禁用或复位
//
// 不清空两个工位的物料状态，避免软件状态与现场物料不一致。
//==============================================================
IF (NOT stInput.bEnable) OR trigReset.Q THEN
    bInitialized := FALSE;
    bFinalExchange := FALSE;

    bTurntableCommandIssued := FALSE;
    bClampCommandIssued := FALSE;
    bAdjustmentRequestIssued := FALSE;

    stStatus.bReady := FALSE;
    stStatus.bBusy := FALSE;
    stStatus.bExchangeDone := FALSE;
    stStatus.bAdjustmentRequest := FALSE;
    stStatus.bFinalUnloadRequest := FALSE;
    stStatus.bReadyForTransferLoad := FALSE;
    stStatus.bTurntableInPosition := FALSE;
    stStatus.bClampOpen := FALSE;
    stStatus.bClampHolding := FALSE;
    stStatus.bComplete := FALSE;
    stStatus.bError := FALSE;
	stStatus.bRotationDone := FALSE;
    stStatus.nErrorID := TO_UDINT(E_TurntableErrorCode.None);

    stStatus.eTurntablePosition :=
        E_DamperTurntablePosition.Unknown;
    stStatus.eClampStep := E_DamperClampStep.Idle;
    stStatus.eStep := E_DamperTurntableStep.Idle;
ELSE
	// 整机准备已经完成夹紧轴松开和转台0°定位。
	// 初始化状态直接同步，不重复运动。
	IF bMachinePrepared
		AND NOT bInitialized
		AND (stStatus.eStep = E_DamperTurntableStep.Idle)
	THEN
		bInitialized := TRUE;
	
		stStatus.bClampOpen := TRUE;
		stStatus.bClampHolding := FALSE;
		stStatus.bTurntableInPosition := TRUE;
	
		stStatus.eClampStep :=
			E_DamperClampStep.Complete;
	
		stStatus.eTurntablePosition :=
			E_DamperTurntablePosition.Position0;
	END_IF;
    //==========================================================
    // 5. 转台、夹紧与调整协调状态机
    //==========================================================
    CASE stStatus.eStep OF

        E_DamperTurntableStep.Idle:
            stStatus.bBusy := FALSE;
            stStatus.bExchangeDone := FALSE;
            stStatus.bComplete := FALSE;

            IF NOT bInitialized THEN
                stStatus.eStep :=
                    E_DamperTurntableStep.InitializeClampOpen;
            ELSIF stInput.bExchangeRequest THEN
                stStatus.eStep :=
                    E_DamperTurntableStep.EvaluatePositionStates;
            END_IF;


        //======================================================
		// 初始化：夹紧轴先运动到松开位置
		//
		// 即使位置反馈等于松开位置，也必须确认轴已经Ready，
		// 防止未使能轴的默认0位置被误认为初始化完成。
		//======================================================
		E_DamperTurntableStep.InitializeClampOpen:
			stStatus.bBusy := TRUE;
			stStatus.bClampOpen := FALSE;
			stStatus.bClampHolding := FALSE;
			stStatus.eClampStep :=
				E_DamperClampStep.MoveToOpen;
		
			IF stClampingAxis.State.bReady THEN
				IF
					ABS(
						stClampingAxis.Data.fActPosition
						- stConfig.fClampOpenPosition
					)
					<= stConfig.fClampPositionTolerance
				THEN
					// 轴已Ready，并且已经位于松开位置。
					bClampCommandIssued := FALSE;
					stStatus.bClampOpen := TRUE;
					stStatus.eClampStep := E_DamperClampStep.Complete;
					stStatus.eStep :=
						E_DamperTurntableStep.InitializeTurntable;
		
				ELSE
					// 轴已Ready，但尚未到达松开位置。
					stClampingAxis.AutoSet.Position.fAbsolutePosition :=
						stConfig.fClampOpenPosition;
		
					stClampingAxis.AutoSet.Position.fVelocity :=
						stConfig.fClampPositionVelocity;
		
					stClampingAxis.AutoSet.Position.fAcceleration :=
						stConfig.fClampPositionAcceleration;
		
					stClampingAxis.AutoSet.Position.fDeceleration :=
						stConfig.fClampPositionDeceleration;
		
					stClampingAxis.AutoCmd.bMoveAbs := TRUE;
					bClampCommandIssued := TRUE;
		
					stStatus.eStep :=
						E_DamperTurntableStep.WaitInitialClampOpen;
				END_IF;
			END_IF;


        E_DamperTurntableStep.WaitInitialClampOpen:
            stStatus.eClampStep := E_DamperClampStep.WaitOpen;

			IF
				stClampingAxis.State.bCmdRejected
				OR stClampingAxis.State.bCommandAborted
			THEN
				bClampCommandIssued := FALSE;
			
				// 等轴重新Ready后再次发送初始化松开命令。
				stStatus.eStep :=
					E_DamperTurntableStep.InitializeClampOpen;
			
			ELSIF
				bClampCommandIssued
				AND
				(
					stClampingAxis.State.bDone
					OR
					(
						ABS(
							stClampingAxis.Data.fActPosition
							- stConfig.fClampOpenPosition
						)
						<= stConfig.fClampPositionTolerance
					)
				)
			THEN
				bClampCommandIssued := FALSE;
				stStatus.bClampOpen := TRUE;
				stStatus.bClampHolding := FALSE;
				stStatus.eClampStep := E_DamperClampStep.Complete;
				stStatus.eStep :=
					E_DamperTurntableStep.InitializeTurntable;
			ELSIF fbClampMoveTimeout.Q THEN
				bClampCommandIssued := FALSE;
				stStatus.bError := TRUE;
				stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.PositionTimeout);
				stStatus.eClampStep := E_DamperClampStep.Error;
				stStatus.eStep := E_DamperTurntableStep.Error;
			END_IF;


        //======================================================
		// 初始化：转台绝对运动到0°
		//
		// 必须同时满足轴Ready和位置进入公差，
		// 才允许确认转台初始化完成。
		//======================================================
		E_DamperTurntableStep.InitializeTurntable:
			stStatus.bTurntableInPosition := FALSE;
		
			IF stTurntableAxis.State.bReady THEN
				IF
					ABS(
						stTurntableAxis.Data.fActPosition
						- stConfig.fTurntablePosition0
					)
					<= stConfig.fTurntablePositionTolerance
				THEN
					// 轴已Ready，并且转台已经位于0°。
					bTurntableCommandIssued := FALSE;
		
					stStatus.eTurntablePosition :=
						E_DamperTurntablePosition.Position0;
		
					stStatus.bTurntableInPosition := TRUE;
					bInitialized := TRUE;
		
					stStatus.eStep :=
						E_DamperTurntableStep.Idle;
		
				ELSE
					// 轴已Ready，但不在0°，发送绝对运动命令。
					stTurntableAxis.AutoSet.Position.fAbsolutePosition :=
						stConfig.fTurntablePosition0;
		
					stTurntableAxis.AutoSet.Position.fVelocity :=
						stConfig.fTurntableVelocity;
		
					stTurntableAxis.AutoSet.Position.fAcceleration :=
						stConfig.fTurntableAcceleration;
		
					stTurntableAxis.AutoSet.Position.fDeceleration :=
						stConfig.fTurntableDeceleration;
		
					stTurntableAxis.AutoCmd.bMoveAbs := TRUE;
					bTurntableCommandIssued := TRUE;
		
					stStatus.eStep :=
						E_DamperTurntableStep.WaitInitialTurntable;
				END_IF;
			END_IF;
		
		
		E_DamperTurntableStep.WaitInitialTurntable:
			IF
				stTurntableAxis.State.bCmdRejected
				OR stTurntableAxis.State.bCommandAborted
			THEN
				// 命令未执行成功，清除锁存并返回发令步骤。
				// 等轴重新Ready后再次发送。
				bTurntableCommandIssued := FALSE;
		
				stStatus.eStep :=
					E_DamperTurntableStep.InitializeTurntable;
		
			ELSIF
				bTurntableCommandIssued
				AND
				(
					stTurntableAxis.State.bDone
					OR
					(
						ABS(
							stTurntableAxis.Data.fActPosition
							- stConfig.fTurntablePosition0
						)
						<= stConfig.fTurntablePositionTolerance
					)
				)
			THEN
				bTurntableCommandIssued := FALSE;
		
				stStatus.eTurntablePosition :=
					E_DamperTurntablePosition.Position0;
		
				stStatus.bTurntableInPosition := TRUE;
				bInitialized := TRUE;
		
				stStatus.eStep :=
					E_DamperTurntableStep.Idle;
			ELSIF fbTurntableMoveTimeout.Q THEN
				bTurntableCommandIssued := FALSE;
				stStatus.bError := TRUE;
				stStatus.nErrorID := TO_UDINT(E_TurntableErrorCode.PositionTimeout);
				stStatus.eStep := E_DamperTurntableStep.Error;
			END_IF;


        //======================================================
        // 根据两个物理工位的内容状态统一判断流程
        //======================================================
        E_DamperTurntableStep.EvaluatePositionStates:
            stStatus.bBusy := TRUE;
			// 新一轮转台交换尚未完成。
    		stStatus.bRotationDone := FALSE;
            // 正常交换：备料位已有下一件。
            IF
                eTransferPositionState
                = E_DamperSlotState.PendingAdjustment
            THEN
                bFinalExchange := FALSE;

                IF
                    eAdjustmentPositionState
                    = E_DamperSlotState.Empty
                THEN
                    // 第一件：调整位为空，可直接旋转。
                    stStatus.eStep :=
                        E_DamperTurntableStep.ReleaseClamp;

                ELSIF
                    (
                        eAdjustmentPositionState
                        = E_DamperSlotState.Qualified
                    )
                    OR
                    (
                        eAdjustmentPositionState
                        = E_DamperSlotState.Unqualified
                    )
                THEN
                    // 上一件已经调整完，可以松开并交换。
                    stStatus.eStep :=
                        E_DamperTurntableStep.ReleaseClamp;
                ELSE
                    // 上一件仍在调整，下一件可以留在备料位等待。
                    stStatus.eStep :=
                        E_DamperTurntableStep.WaitAdjustmentDone;
                END_IF;

            // 最后一件排出：不再有下一件，备料位为空。
            ELSIF
                stInput.bNoMorePartsToLoad
                AND
                (
                    eTransferPositionState
                    = E_DamperSlotState.Empty
                )
                AND
                (
                    (
                        eAdjustmentPositionState
                        = E_DamperSlotState.Qualified
                    )
                    OR
                    (
                        eAdjustmentPositionState
                        = E_DamperSlotState.Unqualified
                    )
                )
            THEN
                bFinalExchange := TRUE;
                stStatus.eStep :=
                    E_DamperTurntableStep.ReleaseClamp;

            ELSIF
                (
                    eAdjustmentPositionState
                    = E_DamperSlotState.Adjusting
                )
            THEN
                stStatus.eStep :=
                    E_DamperTurntableStep.WaitAdjustmentDone;
            ELSE
                stStatus.eStep :=
                    E_DamperTurntableStep.WaitTransferPart;
            END_IF;


        E_DamperTurntableStep.WaitAdjustmentDone:
            IF
                (
                    eAdjustmentPositionState
                    = E_DamperSlotState.Qualified
                )
                OR
                (
                    eAdjustmentPositionState
                    = E_DamperSlotState.Unqualified
                )
            THEN
                stStatus.eStep :=
                    E_DamperTurntableStep.EvaluatePositionStates;
            END_IF;


        // 调整已完成，但下一件还没到备料位时保持夹紧，不提前旋转。
        E_DamperTurntableStep.WaitTransferPart:
            IF
                (
                    eTransferPositionState
                    = E_DamperSlotState.PendingAdjustment
                )
                OR stInput.bNoMorePartsToLoad
            THEN
                stStatus.eStep :=
                    E_DamperTurntableStep.EvaluatePositionStates;
            END_IF;


        //======================================================
		// 请求夹紧轴运动到松开位置
		//======================================================
		E_DamperTurntableStep.ReleaseClamp:
			IF stStatus.bClampOpen THEN
				// 已经确认松开，不重复发送运动命令。
				stStatus.eStep :=
					E_DamperTurntableStep.RotateExchange;

			ELSIF
				stStatus.bClampHolding
				OR stClampingAxis.State.bTorqueControlActive
			THEN
				// 先撤销转矩请求。FB_AxisControl执行受控停止并恢复位置模式。
				stStatus.bClampHolding := FALSE;
				stClampingAxis.AutoCmd.bTorqueControl := FALSE;
				stStatus.eClampStep := E_DamperClampStep.ExitTorque;

			ELSIF NOT stClampingAxis.State.bPositionModeReady THEN
				stStatus.eClampStep :=
					E_DamperClampStep.RestorePositionMode;
		
			ELSIF stClampingAxis.State.bReady THEN
				stStatus.eClampStep :=
					E_DamperClampStep.MoveToOpen;
		
				stClampingAxis.AutoSet.Position.fAbsolutePosition :=
					stConfig.fClampOpenPosition;
		
				stClampingAxis.AutoSet.Position.fVelocity :=
					stConfig.fClampPositionVelocity;
		
				stClampingAxis.AutoSet.Position.fAcceleration :=
					stConfig.fClampPositionAcceleration;
		
				stClampingAxis.AutoSet.Position.fDeceleration :=
					stConfig.fClampPositionDeceleration;
		
				stClampingAxis.AutoCmd.bMoveAbs := TRUE;
				bClampCommandIssued := TRUE;
		
				stStatus.eStep :=
					E_DamperTurntableStep.WaitClampOpen;
			END_IF;
		
		
		E_DamperTurntableStep.WaitClampOpen:
			stStatus.eClampStep :=
				E_DamperClampStep.WaitOpen;
		
			IF
				stClampingAxis.State.bCmdRejected
				OR stClampingAxis.State.bCommandAborted
			THEN
				bClampCommandIssued := FALSE;
		
				// 等夹紧轴重新Ready后再次发送松开命令。
				stStatus.eStep :=
					E_DamperTurntableStep.ReleaseClamp;
		
			ELSIF
				bClampCommandIssued
				AND
				(
					stClampingAxis.State.bDone
					OR
					(
						ABS(
							stClampingAxis.Data.fActPosition
							- stConfig.fClampOpenPosition
						)
						<= stConfig.fClampPositionTolerance
					)
				)
			THEN
				bClampCommandIssued := FALSE;
				stStatus.bClampOpen := TRUE;
				stStatus.bClampHolding := FALSE;
				stStatus.eClampStep :=
					E_DamperClampStep.Complete;
		
				stStatus.eStep :=
					E_DamperTurntableStep.RotateExchange;
			ELSIF fbClampMoveTimeout.Q THEN
				bClampCommandIssued := FALSE;
				stStatus.bError := TRUE;
				stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.PositionTimeout);
				stStatus.eClampStep := E_DamperClampStep.Error;
				stStatus.eStep := E_DamperTurntableStep.Error;
			END_IF;


        //======================================================
        // 转台0°/180°正反交替绝对运动
        //======================================================
        E_DamperTurntableStep.RotateExchange:
            stStatus.bTurntableInPosition := FALSE;

            CASE stStatus.eTurntablePosition OF
                E_DamperTurntablePosition.Position0:
                    fTurntableTargetPosition :=
                        stConfig.fTurntablePosition180;
                    eTurntableTargetPosition :=
                        E_DamperTurntablePosition.Position180;

                E_DamperTurntablePosition.Position180:
                    fTurntableTargetPosition :=
                        stConfig.fTurntablePosition0;
                    eTurntableTargetPosition :=
                        E_DamperTurntablePosition.Position0;

            ELSE
                stStatus.bError := TRUE;
                stStatus.nErrorID := TO_UDINT(E_TurntableErrorCode.InvalidPositionState);
                stStatus.eStep := E_DamperTurntableStep.Error;
            END_CASE;

			// 转台无流程错误，并且轴已经准备好后才发送绝对运动命令。
			IF
				(NOT stStatus.bError)
				AND stTurntableAxis.State.bReady
			THEN
				stTurntableAxis.AutoSet.Position.fAbsolutePosition :=
					fTurntableTargetPosition;
			
				stTurntableAxis.AutoSet.Position.fVelocity :=
					stConfig.fTurntableVelocity;
			
				stTurntableAxis.AutoSet.Position.fAcceleration :=
					stConfig.fTurntableAcceleration;
			
				stTurntableAxis.AutoSet.Position.fDeceleration :=
					stConfig.fTurntableDeceleration;
			
				stTurntableAxis.AutoCmd.bMoveAbs := TRUE;
				bTurntableCommandIssued := TRUE;
			
				stStatus.eStep :=
					E_DamperTurntableStep.WaitTurntableInPosition;
			END_IF;


        E_DamperTurntableStep.WaitTurntableInPosition:
			IF
				stTurntableAxis.State.bCmdRejected
				OR stTurntableAxis.State.bCommandAborted
			THEN
				bTurntableCommandIssued := FALSE;
		
				// 返回后仍按照当前位置决定下一目标：
				// 0°→180°，180°→0°。
				stStatus.eStep :=
					E_DamperTurntableStep.RotateExchange;
		
			ELSIF
				bTurntableCommandIssued
				AND
				(
					stTurntableAxis.State.bDone
					OR
					(
						ABS(
							stTurntableAxis.Data.fActPosition
							- fTurntableTargetPosition
						)
						<= stConfig.fTurntablePositionTolerance
					)
				)
			THEN
				bTurntableCommandIssued := FALSE;
		
				stStatus.eTurntablePosition :=
					eTurntableTargetPosition;
		
				stStatus.bTurntableInPosition := TRUE;
		
				stStatus.eStep :=
					E_DamperTurntableStep.ExchangePositionStates;
			ELSIF fbTurntableMoveTimeout.Q THEN
				bTurntableCommandIssued := FALSE;
				stStatus.bError := TRUE;
				stStatus.nErrorID := TO_UDINT(E_TurntableErrorCode.PositionTimeout);
				stStatus.eStep := E_DamperTurntableStep.Error;
			END_IF;


        //======================================================
        // 只有转台确认到位后，才交换两个物理位置的软件状态
        //======================================================
        E_DamperTurntableStep.ExchangePositionStates:
			// 转台已经物理到位，此时才交换两个位置的软件内容状态。
			ePositionStateTemp := eTransferPositionState;
			eTransferPositionState := eAdjustmentPositionState;
			eAdjustmentPositionState := ePositionStateTemp;
		
			// 从本扫描周期开始：
			// 1. DamperZ可以下降取走取回位的已调整阻尼器；
			// 2. 夹紧轴可以同时夹紧调整位的新阻尼器。
			stStatus.bRotationDone := TRUE;
		
			IF bFinalExchange THEN
				stStatus.bExchangeDone := TRUE;
		
				stStatus.eStep :=
					E_DamperTurntableStep.RequestFinalUnload;
			ELSE
				stStatus.eStep :=
					E_DamperTurntableStep.ClampAdjustmentPart;
			END_IF;


        //======================================================
		// 位置模式运动到夹紧接近位置
		//======================================================
		E_DamperTurntableStep.ClampAdjustmentPart:
			stStatus.bClampOpen := FALSE;
			stStatus.bClampHolding := FALSE;
			stStatus.eClampStep :=
				E_DamperClampStep.MoveToApproach;
		
			IF stClampingAxis.State.bReady THEN
				stClampingAxis.AutoSet.Position.fAbsolutePosition :=
					stConfig.fClampApproachPosition;
		
				stClampingAxis.AutoSet.Position.fVelocity :=
					stConfig.fClampPositionVelocity;
		
				stClampingAxis.AutoSet.Position.fAcceleration :=
					stConfig.fClampPositionAcceleration;
		
				stClampingAxis.AutoSet.Position.fDeceleration :=
					stConfig.fClampPositionDeceleration;
		
				stClampingAxis.AutoCmd.bMoveAbs := TRUE;
				bClampCommandIssued := TRUE;
				stStatus.eClampStep :=
					E_DamperClampStep.WaitApproach;
		
				stStatus.eStep :=
					E_DamperTurntableStep.WaitClampHolding;
			END_IF;
		
		
		E_DamperTurntableStep.WaitClampHolding:
			CASE stStatus.eClampStep OF
				E_DamperClampStep.WaitApproach:
				//==========================================================
				// 等待夹紧轴到达统一配置的接近位置
				//==========================================================
			
				IF
					stClampingAxis.State.bCmdRejected
					OR stClampingAxis.State.bCommandAborted
				THEN
					// 接近位置运动没有正常执行。
					bClampCommandIssued := FALSE;
			
					// 返回发令步骤，等待轴重新Ready后再次发送MoveAbsolute。
					stStatus.eStep :=
						E_DamperTurntableStep.ClampAdjustmentPart;
			
				ELSIF
					bClampCommandIssued
					AND
					(
						stClampingAxis.State.bDone
						OR
						(
							ABS(
								stClampingAxis.Data.fActPosition
								- stConfig.fClampApproachPosition
							)
							<= stConfig.fClampPositionTolerance
						)
					)
				THEN
					// 已经进入接近位置公差。
					//
					// 注意：
					// 位置进入公差不代表MC_MoveAbsolute.Busy已经为FALSE，
					// 因此这里只结束接近位置阶段，不立即请求转矩控制。
					bClampCommandIssued := FALSE;
			
					// 转入等待位置功能块完全释放的步骤。
					stStatus.eClampStep :=
						E_DamperClampStep.WaitPositionReleased;
				ELSIF fbClampMoveTimeout.Q THEN
					bClampCommandIssued := FALSE;
					stStatus.bError := TRUE;
					stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.PositionTimeout);
					stStatus.eClampStep := E_DamperClampStep.Error;
					stStatus.eStep := E_DamperTurntableStep.Error;
				END_IF;
					
				E_DamperClampStep.WaitPositionReleased:
					// 本步骤不下发MoveAbs，也不下发TorqueControl。
					// 等待上一条定位命令完全结束。
				
					IF stClampingAxis.Alarm.bError THEN
						// 等待期间轴本身产生错误。
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.PositionCommandNotReleased);
						stStatus.eClampStep := E_DamperClampStep.Error;
						stStatus.eStep := E_DamperTurntableStep.Error;
				
					ELSIF fbClampPositionReleaseTimeout.Q THEN
						// 到达接近位置后，定位功能块在规定时间内没有释放。
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.PositionCommandNotReleased);
						stStatus.eClampStep := E_DamperClampStep.Error;
						stStatus.eStep := E_DamperTurntableStep.Error;
				
					ELSIF
						// bReady内部已经包含：
						// 1. 轴已使能；
						// 2. 没有轴报警；
						// 3. MC_MoveAbsolute不再Busy；
						// 4. 定位Execute锁存已经撤销。
						stClampingAxis.State.bReady
				
						// 确认轴仍然处于位置模式。
						AND stClampingAxis.State.bPositionModeReady
				
						// 避免轴仍有残余速度时直接切换CST。
						AND
						(
							ABS(stClampingAxis.Data.fActVelocity)
							<= GVL_SafetyConfig.stClamping.fModeSwitchVelocityMax
						)
					THEN
						// 只有位置运动完全释放后才下发转矩参数。
						stClampingAxis.AutoSet.Torque :=
							stConfig.ClampTorque;
				
						stClampingAxis.AutoCmd.bTorqueControl :=
							TRUE;
				
						stStatus.eClampStep :=
							E_DamperClampStep.SwitchToTorque;
					END_IF;	

				E_DamperClampStep.SwitchToTorque:
					// 转矩控制属于持续型命令，在整个切换阶段必须保持TRUE。
					stClampingAxis.AutoSet.Torque :=
						stConfig.ClampTorque;
				
					stClampingAxis.AutoCmd.bTorqueControl :=
						TRUE;
				
					IF
						stClampingAxis.State.bCmdRejected
						OR stClampingAxis.State.bCommandAborted
						OR stClampingAxis.Alarm.bError
					THEN
						// 已经等待位置运动完全释放后仍被拒绝，
						// 此时需要检查转矩参数、NC配置或驱动器映射。
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.TorqueCommandRejected);
						stStatus.eClampStep := E_DamperClampStep.Error;
						stStatus.eStep := E_DamperTurntableStep.Error;
				
					ELSIF stClampingAxis.State.bTorqueControlActive THEN
						// MC_TorqueControl已经取得轴控制权。
						stStatus.eClampStep :=
							E_DamperClampStep.BuildTorque;
				
					ELSIF fbClampModeSwitchTimeout.Q THEN
						// 在规定时间内没有进入转矩模式。
						// 仿真轴不支持CST时预计会进入此分支。
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.EnterTorqueModeTimeout);
						stStatus.eClampStep := E_DamperClampStep.Error;
						stStatus.eStep := E_DamperTurntableStep.Error;
					END_IF;

				E_DamperClampStep.BuildTorque:
					//==========================================================
					// CST模式下建立夹紧转矩
					//==========================================================
					stClampingAxis.AutoSet.Torque :=
						stConfig.ClampTorque;
				
					// 在BuildTorque期间持续保持转矩控制请求。
					stClampingAxis.AutoCmd.bTorqueControl :=
						TRUE;
				
					IF stClampingAxis.Alarm.bError THEN
						// 夹紧轴在转矩建立过程中发生错误。
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.AxisFaultDuringTorqueBuild);
						stStatus.eClampStep :=
							E_DamperClampStep.Error;
						stStatus.eStep :=
							E_DamperTurntableStep.Error;
				
					ELSIF stClampingAxis.State.bTorqueReached THEN
						//======================================================
						// 分支1：实际转矩先达到夹紧阈值
						//
						// 保持CST以及-10%目标转矩，并进入下一步。
						//======================================================
						stStatus.bClampOpen := FALSE;
						stStatus.bClampHolding := TRUE;
				
						stStatus.eClampStep :=
							E_DamperClampStep.HoldTorque;
				
						bAdjustmentRequestIssued := FALSE;
				
						stStatus.eStep :=
							E_DamperTurntableStep.RequestAdjustment;
				
					ELSIF
						stClampingAxis.Data.fActPosition
						<=
						(
							stConfig.fClampMinimumPosition
							+ stConfig.fClampPositionTolerance
						)
					THEN
						//======================================================
						// 分支2：位置先到达最小允许位置
						//
						// 此时不能继续保持负转矩，否则无工件或仿真时
						// 夹紧轴会继续向负方向运动。
						//
						// 先撤销CST请求，FB_AxisControl将通过MC_Stop
						// 受控退出转矩模式。
						//======================================================
						stClampingAxis.AutoCmd.bTorqueControl :=
							FALSE;
				
						bClampCommandIssued := FALSE;
				
						stStatus.eClampStep :=
							E_DamperClampStep.ExitTorqueForPosition;
				
					ELSIF fbClampTorqueBuildTimeout.Q THEN
						// 规定时间内既没有达到转矩，也没有到达最小允许位置。
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.TorqueBuildTimeout);
						stStatus.eClampStep :=
							E_DamperClampStep.Error;
						stStatus.eStep :=
							E_DamperTurntableStep.Error;
					END_IF;
				E_DamperClampStep.ExitTorqueForPosition:
					//==========================================================
					// 位置先到达最小允许位置后，等待MC_TorqueControl退出
					//==========================================================
				
					// 明确保持转矩请求为FALSE。
					stClampingAxis.AutoCmd.bTorqueControl :=
						FALSE;
				
					IF stClampingAxis.Alarm.bError THEN
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.AxisFaultRestoringPosition);
						stStatus.eClampStep :=
							E_DamperClampStep.Error;
						stStatus.eStep :=
							E_DamperTurntableStep.Error;
				
					ELSIF NOT stClampingAxis.State.bTorqueControlActive THEN
						// MC_TorqueControl已经不再控制轴。
						// 下一步等待MC_Stop释放并确认恢复CSP。
						stStatus.eClampStep :=
							E_DamperClampStep.RestorePositionForHold;
				
					ELSIF fbClampPositionHoldTimeout.Q THEN
						// 转矩控制没有在规定时间内退出。
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.RestorePositionModeTimeout);
						stStatus.eClampStep :=
							E_DamperClampStep.Error;
						stStatus.eStep :=
							E_DamperTurntableStep.Error;
					END_IF;
					
				E_DamperClampStep.RestorePositionForHold:
					//==========================================================
					// 等待轴恢复位置模式
					//
					// bPositionModeReady表示已经退出CST；
					// bReady表示MC_Stop、MC_TorqueControl及其他运动功能块
					// 均已释放，可以接受新的定位命令。
					//==========================================================
				
					stClampingAxis.AutoCmd.bTorqueControl :=
						FALSE;
				
					IF stClampingAxis.Alarm.bError THEN
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.AxisFaultRestoringPosition);
						stStatus.eClampStep :=
							E_DamperClampStep.Error;
						stStatus.eStep :=
							E_DamperTurntableStep.Error;
				
					ELSIF
						stClampingAxis.State.bPositionModeReady
						AND stClampingAxis.State.bReady
					THEN
						// 使用CSP绝对定位到最小允许位置。
						// 即使退出转矩时产生少量位置偏移，也会回到配置位置。
						stClampingAxis.AutoSet.Position.fAbsolutePosition :=
							stConfig.fClampMinimumPosition;
				
						stClampingAxis.AutoSet.Position.fVelocity :=
							stConfig.fClampPositionVelocity;
				
						stClampingAxis.AutoSet.Position.fAcceleration :=
							stConfig.fClampPositionAcceleration;
				
						stClampingAxis.AutoSet.Position.fDeceleration :=
							stConfig.fClampPositionDeceleration;
				
						stClampingAxis.AutoCmd.bMoveAbs :=
							TRUE;
				
						bClampCommandIssued := TRUE;
				
						stStatus.eClampStep :=
							E_DamperClampStep.WaitPositionHold;
				
					ELSIF fbClampPositionHoldTimeout.Q THEN
						// 规定时间内没有恢复位置模式。
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.RestorePositionModeTimeout);
						stStatus.eClampStep :=
							E_DamperClampStep.Error;
						stStatus.eStep :=
							E_DamperTurntableStep.Error;
					END_IF;
				E_DamperClampStep.WaitPositionHold:
					//==========================================================
					// 等待CSP重新定位到最小允许位置
					//==========================================================
				
					IF
						stClampingAxis.State.bCmdRejected
						OR stClampingAxis.State.bCommandAborted
						OR stClampingAxis.Alarm.bError
					THEN
						bClampCommandIssued := FALSE;
				
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.HoldPositionCommandFailed);
						stStatus.eClampStep :=
							E_DamperClampStep.Error;
						stStatus.eStep :=
							E_DamperTurntableStep.Error;
				
					ELSIF
						bClampCommandIssued
						AND
						(
							stClampingAxis.State.bDone
							OR
							(
								ABS(
									stClampingAxis.Data.fActPosition
									- stConfig.fClampMinimumPosition
								)
								<= stConfig.fClampPositionTolerance
							)
						)
					THEN
						//======================================================
						// 最小允许位置保持建立完成
						//
						// MC_MoveAbsolute完成后，NC轴继续在CSP中保持目标位置，
						// 不需要持续保持bMoveAbs为TRUE。
						//======================================================
						bClampCommandIssued := FALSE;
				
						stStatus.bClampOpen := FALSE;
						stStatus.bClampHolding := TRUE;
				
						stStatus.eClampStep :=
							E_DamperClampStep.HoldPosition;
				
						bAdjustmentRequestIssued := FALSE;
				
						stStatus.eStep :=
							E_DamperTurntableStep.RequestAdjustment;
				
					ELSIF fbClampPositionHoldTimeout.Q THEN
						bClampCommandIssued := FALSE;
				
						stStatus.bError := TRUE;
						stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.PositionTimeout);
						stStatus.eClampStep :=
							E_DamperClampStep.Error;
						stStatus.eStep :=
							E_DamperTurntableStep.Error;
					END_IF;
			ELSE
				stStatus.bError := TRUE;
				stStatus.nErrorID := TO_UDINT(E_ClampingErrorCode.InvalidProcessStep);
				stStatus.eClampStep := E_DamperClampStep.Error;
				stStatus.eStep := E_DamperTurntableStep.Error;
			END_CASE;


        //======================================================
        // 调整启动保持型握手
        //======================================================
        E_DamperTurntableStep.RequestAdjustment:
            stStatus.bAdjustmentRequest := TRUE;

            IF NOT bAdjustmentRequestIssued THEN
                // 先让请求至少保持一个完整扫描周期。
                bAdjustmentRequestIssued := TRUE;

            ELSIF stInput.bAdjustmentAccepted THEN
            
                stStatus.bAdjustmentRequest := FALSE;
                bAdjustmentRequestIssued := FALSE;

                // 转台已到位且夹紧完成，此时才确认本轮交换完成。
                stStatus.bExchangeDone := TRUE;
                stStatus.eStep :=
                    E_DamperTurntableStep.ExchangeComplete;
            END_IF;


        //======================================================
        // 最终取回请求
        //======================================================
        E_DamperTurntableStep.RequestFinalUnload:
            stStatus.bFinalUnloadRequest := TRUE;
            stStatus.eStep :=
                E_DamperTurntableStep.WaitFinalUnloadDone;


        E_DamperTurntableStep.WaitFinalUnloadDone:
            // bExchangeDone在请求方撤销bExchangeRequest后撤销。
			IF NOT stInput.bExchangeRequest THEN
				stStatus.bRotationDone := FALSE;
				stStatus.bExchangeDone := FALSE;
			END_IF;
            IF stInput.bFinalUnloadDone THEN
                stStatus.bFinalUnloadRequest := FALSE;
                stStatus.bComplete := TRUE;
                stStatus.eStep :=
                    E_DamperTurntableStep.ProcessComplete;
            END_IF;


        //======================================================
        // 普通交换四相握手结束
        //======================================================
        E_DamperTurntableStep.ExchangeComplete:
			IF NOT stInput.bExchangeRequest THEN
				stStatus.bRotationDone := FALSE;
				stStatus.bExchangeDone := FALSE;
		
				stStatus.eStep :=
					E_DamperTurntableStep.Idle;
			END_IF;


        E_DamperTurntableStep.ProcessComplete:
            stStatus.bBusy := FALSE;
            stStatus.bComplete := TRUE;

            // 最终搬运完成方看到bFinalUnloadRequest撤销后，
            // 会撤销bFinalUnloadDone；随后自动回到Idle，允许下一批重新启动。
            IF NOT stInput.bFinalUnloadDone THEN
                stStatus.bComplete := FALSE;
                bFinalExchange := FALSE;
                stStatus.eStep := E_DamperTurntableStep.Idle;
            END_IF;


        E_DamperTurntableStep.Error:
            stStatus.bBusy := FALSE;
            stStatus.bReady := FALSE;
            stStatus.bExchangeDone := FALSE;
            stStatus.bAdjustmentRequest := FALSE;
            stStatus.bFinalUnloadRequest := FALSE;
			// 故障时撤销“转台已经旋转完成”状态，
			// 防止Damper流程读取到残留的并行启动条件。
			stStatus.bRotationDone := FALSE;

    ELSE
        stStatus.bError := TRUE;
        stStatus.nErrorID := TO_UDINT(E_TurntableErrorCode.InvalidProcessStep);
        stStatus.eStep := E_DamperTurntableStep.Error;
    END_CASE;

//==============================================================
// 两种夹紧保持方式
//
// HoldTorque：
// 持续保持MC_TorqueControl请求。
//
// HoldPosition：
// 不再发送转矩请求；NC轴保持在CSP，并保持最后一次
// MC_MoveAbsolute的最小允许目标位置。
//==============================================================
    IF
        stStatus.bClampHolding
        AND
        (stStatus.eClampStep = E_DamperClampStep.HoldTorque)
    THEN
        stClampingAxis.AutoSet.Torque := stConfig.ClampTorque;
        stClampingAxis.AutoCmd.bTorqueControl := TRUE;
    END_IF;


    //==========================================================
    // 6. 汇总对外状态
    //==========================================================
    stStatus.bReady := bInitialized AND NOT stStatus.bError;

    stStatus.bBusy :=
        (stStatus.eStep <> E_DamperTurntableStep.Idle)
        AND
        (stStatus.eStep <> E_DamperTurntableStep.ProcessComplete)
        AND
        (stStatus.eStep <> E_DamperTurntableStep.Error);

    // 调整时允许机械手把下一件放到空的备料位。
    // 转台运动、最终取回以及流程故障时不允许放料。
    stStatus.bReadyForTransferLoad :=
        stStatus.bReady
        AND
        (
            eTransferPositionState
            = E_DamperSlotState.Empty
        )
        AND stStatus.bTurntableInPosition
        AND NOT stStatus.bFinalUnloadRequest
        AND NOT stStatus.bComplete
        AND
        (
            stStatus.eStep
            <> E_DamperTurntableStep.RotateExchange
        )
        AND
        (
            stStatus.eStep
            <> E_DamperTurntableStep.WaitTurntableInPosition
        );
END_IF;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
