<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_ScrewAngleVision" Id="{29DCA67A-2801-41C3-9B72-C67781A6A997}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ScrewAngleVision
VAR_INPUT
    bExecute : BOOL;
    bCancel : BOOL;
END_VAR
VAR_OUTPUT
    stResult : ST_ScrewAngleVisionResult;
    bBusy : BOOL;
    bDone : BOOL;
    bVisionFault : BOOL;
    bFallbackUsed : BOOL;
    eVisionError : E_VisionError := E_VisionError.None;
END_VAR
VAR
    // 本FB独占实例；不会与同轴度视觉共享事务状态。
    fbRequest : FB_VisionRequest;
    fbSimulationDelay : TON;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[GVL_ScrewVision.stInterface.bUseScrewVision :=
    GVL_ProcessConfig.stVision.eMode = E_VisionMode.Camera;

IF GVL_ProcessConfig.stVision.eMode = E_VisionMode.Simulation THEN
    fbRequest(
        bExecute := FALSE,
        bCancel := bCancel,
        bOnline := GVL_ScrewVision.stInterface.bOnline,
        bResultValid := GVL_ScrewVision.stInterface.bResultValid,
        udiResultId := GVL_ScrewVision.stInterface.udiResultId,
        bResultInvalid := GVL_ScrewVision.stInterface.bResultInvalid,
        bServiceFault := GVL_ScrewVision.stInterface.bServiceFault,
        tTimeout := GVL_CommunicationConfig.stScrewVision.tResultTimeout
    );
    GVL_ScrewVision.stInterface.bMeasureRequest := FALSE;
    GVL_ScrewVision.stInterface.udiRequestId := fbRequest.udiRequestId;
    GVL_ScrewVision.stInterface.bTimeout := FALSE;

    IF NOT bExecute THEN
        fbSimulationDelay(IN := FALSE, PT := GVL_ProcessConfig.stVision.tDetectionDelay);
        stResult.bValid := FALSE;
        stResult.fAngle := 0.0;
        stResult.bDetected := FALSE;
        stResult.fConfidence := 0.0;
        bBusy := FALSE;
        bDone := FALSE;
        bVisionFault := FALSE;
        bFallbackUsed := FALSE;
        eVisionError := E_VisionError.None;
    ELSIF bCancel THEN
        fbSimulationDelay(IN := FALSE, PT := GVL_ProcessConfig.stVision.tDetectionDelay);
        stResult.bValid := FALSE;
        stResult.fAngle := 0.0;
        stResult.bDetected := FALSE;
        stResult.fConfidence := 0.0;
        bBusy := FALSE;
        bDone := TRUE;
        bVisionFault := TRUE;
        bFallbackUsed := TRUE;
        eVisionError := E_VisionError.Cancelled;
    ELSE
        fbSimulationDelay(
            IN := NOT bDone,
            PT := GVL_ProcessConfig.stVision.tDetectionDelay
        );

        IF fbSimulationDelay.Q THEN
            stResult.bValid := TRUE;
            stResult.fAngle := GVL_ProcessConfig.stVision.fSimulatedAngle;
            stResult.bDetected := GVL_ProcessConfig.stVision.bSimulatedDetected;
            stResult.fConfidence := GVL_ProcessConfig.stVision.fSimulatedConfidence;
            bBusy := FALSE;
            bDone := TRUE;
            bVisionFault := FALSE;
            bFallbackUsed := FALSE;
            eVisionError := E_VisionError.None;
        ELSE
            bBusy := NOT bDone;
        END_IF;
    END_IF;
ELSE
    fbSimulationDelay(IN := FALSE, PT := GVL_ProcessConfig.stVision.tDetectionDelay);
    fbRequest(
        bExecute := bExecute,
        bCancel := bCancel,
        bOnline := GVL_ScrewVision.stInterface.bOnline,
        bResultValid := GVL_ScrewVision.stInterface.bResultValid,
        udiResultId := GVL_ScrewVision.stInterface.udiResultId,
        bResultInvalid := GVL_ScrewVision.stInterface.bResultInvalid,
        bServiceFault := GVL_ScrewVision.stInterface.bServiceFault,
        tTimeout := GVL_CommunicationConfig.stScrewVision.tResultTimeout
    );

    GVL_ScrewVision.stInterface.bMeasureRequest := fbRequest.bRequest;
    GVL_ScrewVision.stInterface.udiRequestId := fbRequest.udiRequestId;
    GVL_ScrewVision.stInterface.bTimeout :=
        fbRequest.bFault AND (fbRequest.eError = E_VisionError.Timeout);

    IF NOT bExecute THEN
        stResult.bValid := FALSE;
        stResult.fAngle := 0.0;
        stResult.bDetected := FALSE;
        stResult.fConfidence := 0.0;
        bBusy := FALSE;
        bDone := FALSE;
        bVisionFault := FALSE;
        bFallbackUsed := FALSE;
        eVisionError := E_VisionError.None;
    ELSIF fbRequest.bDone THEN
        stResult.bValid := TRUE;
        stResult.fAngle := GVL_ScrewVision.stInterface.fAngle;
        stResult.bDetected := GVL_ScrewVision.stInterface.bDetected;
        stResult.fConfidence := GVL_ScrewVision.stInterface.fConfidence;
        bBusy := FALSE;
        bDone := TRUE;
        bVisionFault := FALSE;
        bFallbackUsed := FALSE;
        eVisionError := E_VisionError.None;
    ELSIF fbRequest.bFault THEN
        stResult.bValid := FALSE;
        stResult.fAngle := 0.0;
        stResult.bDetected := FALSE;
        stResult.fConfidence := 0.0;
        bBusy := FALSE;
        bDone := TRUE;
        bVisionFault := TRUE;
        bFallbackUsed := TRUE;
        eVisionError := fbRequest.eError;
    ELSE
        bBusy := fbRequest.bBusy;
        bDone := FALSE;
        bVisionFault := FALSE;
        bFallbackUsed := FALSE;
        eVisionError := E_VisionError.None;
    END_IF;
END_IF;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
