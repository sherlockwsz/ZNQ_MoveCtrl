<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_AutoProcessCoordinator" Id="{40395fc0-80f0-4ed1-95be-597e4ef209f6}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_AutoProcessCoordinator
VAR_INPUT
    // 来自 FB_AutoStartCoordinator；全部轴就绪后保持 TRUE。
    bStart : BOOL;

    // 整机停止／流程中止。
    bAbort : BOOL;

    // 用于取消正在执行的COM3/COM4夹爪动作。
    bStopRequest : BOOL;

    // 原 MAIN 中保留的在线坐标重初始化请求。
    bReinitializeCoordinates : BOOL;
	
	bMachinePrepared : BOOL;
END_VAR

VAR_IN_OUT
    // 实例继续声明在 MAIN，保留原 ADS 符号路径。
    ioTrayProcess       : FB_TrayProcess;
    ioDamperProcess     : FB_DamperProcess;
    ioTurntableUnit     : FB_TurntableUnit;
    ioGripperAction     : FB_GripperAction;
    ioAdjustGripperAction : FB_GripperAction;

    ioGripper : ST_GripperInterface;
	ioAdjustGripper : ST_GripperInterface;
	ioScrewdriverProcess : FB_ScrewdriverProcess;
    ioAdjustmentProcess : FB_AdjustmentProcess;
    // 复用统一轴数组，不在协调器中重新定义轴。
    aAxes : ARRAY[1..GVL_Constants.cMaxAxisCount] OF ST_AxisInterface;
END_VAR

VAR_OUTPUT
    bBusy : BOOL; // 任一自动流程或夹爪动作正在执行
    bDone : BOOL; // 第五盘放回、Tray 最终复位完成

    // 本扫描检测到夹爪动作失败；交给 MAIN 锁存并启动 Stop 链路。
    bGripperActionFault : BOOL;
	bAdjustGripperActionFault : BOOL;
	bTurntableFault : BOOL;
    udGripperActionError : UDINT;
	udAdjustGripperActionError : UDINT;
	bScrewdriverFault : BOOL;
	uiScrewdriverErrorAxis : UINT;
	udScrewdriverError : UDINT;
END_VAR

VAR
    // 本周期供 Damper 流程使用的 Abort。
    // COM3 动作本周期报错时，Damper 可在同周期收到 TRUE。
    bEffectiveAbort : BOOL;
	stTurntableInputForThisScan : ST_DamperTurntableInput;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// ============================================================
// 调用顺序不可随意交换：
// 1. Tray 读取 Damper 上一周期保持的请求；
// 2. COM3 动作读取 Damper 上一周期保持的动作请求；
// 3. Damper 读取本周期 Tray、COM3 的反馈；
// 4. Adjustment读取Screwdriver上一周期保持的握手并管理COM4；
// 5. Coordinator将本周期Adjustment反馈转换为Screwdriver通用许可；
// 6. TurntableUnit读取本周期各流程生成的保持型请求。
// ============================================================

bGripperActionFault := FALSE;
bAdjustGripperActionFault := FALSE;
bEffectiveAbort := bAbort;

// ------------------------------------------------------------
// 1. 五层料盘流程
// ------------------------------------------------------------
ioTrayProcess(
    bStart := bStart,
    bAbort := bAbort,

    bDamperPrePositionDone :=
        ioDamperProcess.bPrePositionDone,

    bTrayChangeRequest :=
        ioDamperProcess.bTrayChangeRequest,

    bDamperProcessDone :=
        ioDamperProcess.bDone,

    stAxisX := aAxes[GVL_AxisIndex.TrayX],
    stAxisZ := aAxes[GVL_AxisIndex.TrayZ]
);

// ------------------------------------------------------------
// 2. COM3上下料夹爪动作
//
// 机构尚未准备完成时，COM3命令权属于FB_MachinePreparation。
// 准备完成后，命令权才交给Damper自动流程。
// 保证同一个FB_GripperAction每周期最多调用一次。
// ------------------------------------------------------------
IF bMachinePrepared THEN
    ioGripperAction(
        bExecute := ioDamperProcess.bGripperActionExecute,
        eCommand := ioDamperProcess.eGripperActionCommand,
        bCancel := bStopRequest OR bAbort,
        tAcceptTimeout := GVL_ProcessConfig.stGripper.tAcceptTimeout,
        tResultTimeout := GVL_ProcessConfig.stGripper.tResultTimeout,
        ioGripper := ioGripper
    );

    // 只在正式Damper流程运行期间升级夹爪动作故障。
    IF ioGripperAction.bError
        AND ioDamperProcess.bBusy
        AND NOT bAbort
    THEN
        bGripperActionFault := TRUE;
        udGripperActionError := ioGripperAction.udErrorCode;
        bEffectiveAbort := TRUE;
    END_IF;
END_IF;

// ------------------------------------------------------------
// 3. 阻尼器五盘上下料流程
// COM3 本周期报错时，用 bEffectiveAbort 当周期中止 Damper。
// 实际轴停止仍由 MAIN 后续的 FB_AutoStopManager 完成。
// ------------------------------------------------------------
ioDamperProcess(
    bStart := bStart,
    bAbort := bEffectiveAbort,
	bMachinePrepared := bMachinePrepared,
	// 使用上一扫描保持的请求：第一次提出请求后，下一扫描返回Done。
	// 仿真由FB_GripperManager统一完成Accepted/Completed握手；
	// 本协调器始终执行同一条自动动作链。
	bGripperActionDone := ioGripperAction.bDone,
	bGripperActionError := ioGripperAction.bError,
		
    bReinitializeCoordinates :=
        bReinitializeCoordinates,

    bTrayAtDamperPosition :=
        ioTrayProcess.bTrayAtDamperPosition,

    bTrayChangeDone :=
        ioTrayProcess.bTrayChangeDone,

    nTrayAtDamperLayer :=
        ioTrayProcess.nCurrentLayer,

    stTurntableStatus :=
        ioTurntableUnit.stStatus,

    stAxisX :=
        aAxes[GVL_AxisIndex.DamperX],

    stAxisY :=
        aAxes[GVL_AxisIndex.DamperY],

    stAxisZ :=
        aAxes[GVL_AxisIndex.DamperZ],

    stAxisRotation :=
        aAxes[GVL_AxisIndex.DamperRotation]
);

// ------------------------------------------------------------
// 4. 调整机构流程
// 管理AdjustmentXYZ与COM4；只通过握手读取螺丝刀流程状态。
// 放在螺丝刀流程之前，保持原有跨扫描动作时序。
// ------------------------------------------------------------
ioAdjustmentProcess(
    bEnable := bStart,
    bAbort := bEffectiveAbort,
    bStopRequest := bStopRequest,
    bMachinePrepared := bMachinePrepared,
    bStartRequest := ioScrewdriverProcess.bPreTighteningDone,
    bRetractPermit := ioScrewdriverProcess.bSecondTighteningDone,
    bDoneAck := ioTurntableUnit.stStatus.bAdjustmentDoneAck,

    ioAdjustGripperAction := ioAdjustGripperAction,
    ioAdjustGripper := ioAdjustGripper,
    stAxisX := aAxes[GVL_AxisIndex.AdjustmentX],
    stAxisY := aAxes[GVL_AxisIndex.AdjustmentY],
    stAxisZ := aAxes[GVL_AxisIndex.AdjustmentZ]
);

IF ioAdjustmentProcess.bGripperError
    AND ioAdjustmentProcess.bError
    AND NOT bAbort
THEN
    bAdjustGripperActionFault := TRUE;
    udAdjustGripperActionError := ioAdjustmentProcess.udErrorCode;
END_IF;

// ------------------------------------------------------------
// 5. 螺丝刀流程
// 只管理ScrewdriverY/Z与两次拧紧；Adjustment信息通过握手反馈。
// ------------------------------------------------------------

ioScrewdriverProcess(
    bEnable := bStart,
    bAbort := bEffectiveAbort,
    bMachinePrepared := bMachinePrepared,

    bCycleRequest :=
        ioTurntableUnit.stStatus.bAdjustmentRequest,

    bWorkpieceSecured :=
        ioTurntableUnit.stStatus.bClampHolding,

    bCycleDoneAck :=
        ioTurntableUnit.stStatus.bAdjustmentDoneAck,

    bProcessReady := ioAdjustmentProcess.bAdjustmentReady,
    bProcessDone := ioAdjustmentProcess.bAdjustmentDone,

    // 螺丝刀机构
    stAxisY := aAxes[GVL_AxisIndex.ScrewdriverY],
    stAxisZ := aAxes[GVL_AxisIndex.ScrewdriverZ]
);

IF bAdjustGripperActionFault THEN
    bEffectiveAbort := TRUE;
END_IF;

stTurntableInputForThisScan := ioDamperProcess.stTurntableInput;
stTurntableInputForThisScan.bAdjustmentAccepted :=
    ioScrewdriverProcess.bRequestAccepted;
stTurntableInputForThisScan.bAdjustmentStarted :=
    (ioAdjustmentProcess.eStep = E_AdjustmentStep.WaitAdjustment)
    AND NOT ioAdjustmentProcess.bAdjustmentReady;
stTurntableInputForThisScan.bAdjustmentDone :=
    ioAdjustmentProcess.bAdjustmentDone
    AND NOT ioScrewdriverProcess.bError
	AND ioScrewdriverProcess.bScrewdriverSafe
    AND
    (
        (ioScrewdriverProcess.eStep = E_ScrewdriverStep.LiftAfterSecondTighten)
        OR (ioScrewdriverProcess.eStep = E_ScrewdriverStep.WaitDoneAck)
    );

// 当前模拟流程按合格反馈；今后可由真实调整结果替换。
stTurntableInputForThisScan.bAdjustmentQualified := TRUE;

bScrewdriverFault :=
    bStart
    AND (ioScrewdriverProcess.bError OR ioAdjustmentProcess.bError)
    AND NOT bAbort;

// 保持原有整机故障通道：Screwdriver自身故障优先，
// Adjustment轴/流程故障仍由同一Supervisor输入发布。
IF ioScrewdriverProcess.bError THEN
    uiScrewdriverErrorAxis := ioScrewdriverProcess.uiErrorAxis;
    udScrewdriverError := ioScrewdriverProcess.udErrorCode;
ELSE
    uiScrewdriverErrorAxis := ioAdjustmentProcess.uiErrorAxis;
    udScrewdriverError := ioAdjustmentProcess.udErrorCode;
END_IF;
// ------------------------------------------------------------
// 6. 转台与夹紧轴流程
// 保持两个物理位置状态仍存于 MAIN.fbDamperProcess，
// 避免改变现有 ADS/WPF 读取路径。
// ------------------------------------------------------------
ioTurntableUnit(
	bMachinePrepared := bMachinePrepared,
    stInput := stTurntableInputForThisScan,

    stTurntableAxis :=
        aAxes[GVL_AxisIndex.Turntable],

    stClampingAxis :=
        aAxes[GVL_AxisIndex.Clamping],

    eTransferPositionState :=
        ioDamperProcess.eTransferPositionState,

    eAdjustmentPositionState :=
        ioDamperProcess.eAdjustmentPositionState
);
bTurntableFault :=
    bStart
    AND ioTurntableUnit.stStatus.bError
    AND NOT bAbort;
// ------------------------------------------------------------
// 5. 整机流程状态
// Done 仍以 Tray 最终复位为准，不以 Damper 单独完成为准。
// 启动等待阶段由 MAIN 的 fbAutoStart.bEnabling 补入 Busy。
// ------------------------------------------------------------
bBusy :=
    ioTrayProcess.bBusy
    OR ioDamperProcess.bBusy
    OR ioTurntableUnit.stStatus.bBusy
    OR ioGripperAction.bBusy
	OR ioAdjustGripperAction.bBusy
	OR ioScrewdriverProcess.bBusy
    OR ioAdjustmentProcess.bAdjustmentBusy;
bDone := ioTrayProcess.bDone;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>