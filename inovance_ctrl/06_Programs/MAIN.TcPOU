<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{de82ff6c-f728-4f8e-8227-437e5e880436}" SpecialFunc="None">
    <Declaration><![CDATA[//==============================================================
// PLC顶层主程序
//
// MAIN只负责按确定顺序调用顶层功能块并发布公共状态。
// 具体心跳、命令保护和运动控制均在各自FB内部完成。
//==============================================================

PROGRAM MAIN
VAR
    fbHmiWatchdog : FB_HmiWatchdog;
    aAxisManagers : ARRAY[1..GVL_Constants.cMaxAxisCount] OF FB_AxisManager;

    uiAxisIndex : UINT;
    bAnyAxisConfigured : BOOL;
    bAllAxesControlAllowed : BOOL;
    bAnyAxisRequireEnableReset : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//==============================================================
// 1. 更新HMI心跳状态
//==============================================================
fbHmiWatchdog(
    bEnable := GVL_System.bUseHmiWatchdog,
    udiHeartbeat := GVL_HMI.Comm.udiHeartbeat,
    tTimeout := GVL_System.tHmiWatchdogTimeout
);


//==============================================================
// 2. 统一管理14轴
//
// 所有轴引用、配置、运行数据和管理器实例使用同一个业务下标。
// DamperGripper[7]当前bConfigured=FALSE，
// 管理器会清除该轴命令且不会调用NC运动控制。
//==============================================================
bAnyAxisConfigured := FALSE;
bAllAxesControlAllowed := TRUE;
bAnyAxisRequireEnableReset := FALSE;

FOR uiAxisIndex := 1 TO GVL_Constants.cMaxAxisCount DO
    aAxisManagers[uiAxisIndex](
        bAxisConfigured := GVL_AxisConfig.AxisLimits[uiAxisIndex].bConfigured,
        bProtectionEnabled := GVL_System.bUseHmiWatchdog,
        bHmiOnline := fbHmiWatchdog.bOnline,
        stLimit := GVL_AxisConfig.AxisLimits[uiAxisIndex],
        AxisRef := GVL_AxisRef.AxisRefs[uiAxisIndex],
        stAxis := GVL_AxisRuntime.Axes[uiAxisIndex]
    );

    IF GVL_AxisConfig.AxisLimits[uiAxisIndex].bConfigured THEN
        bAnyAxisConfigured := TRUE;
        bAllAxesControlAllowed :=
            bAllAxesControlAllowed
            AND aAxisManagers[uiAxisIndex].bControlAllowed;
        bAnyAxisRequireEnableReset :=
            bAnyAxisRequireEnableReset
            OR aAxisManagers[uiAxisIndex].bRequireEnableReset;
    END_IF;
END_FOR;


//==============================================================
// 3. 发布HMI通信与全轴汇总状态
//==============================================================
GVL_HMI.Comm.bOnline := fbHmiWatchdog.bOnline;
GVL_HMI.Comm.bTimeout := fbHmiWatchdog.bTimeout;
GVL_HMI.Comm.bControlAllowed :=
    bAnyAxisConfigured AND bAllAxesControlAllowed;
GVL_HMI.Comm.bRequireEnableReset :=
    bAnyAxisRequireEnableReset;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>