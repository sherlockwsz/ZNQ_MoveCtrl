<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{de82ff6c-f728-4f8e-8227-437e5e880436}" SpecialFunc="None">
    <Declaration><![CDATA[//==============================================================
// PLC顶层主程序
//
// MAIN只负责按确定顺序调用顶层功能块并发布公共状态。
// 具体心跳、命令保护和运动控制均在各自FB内部完成。
//==============================================================

PROGRAM MAIN
VAR
    fbHmiWatchdog : FB_HmiWatchdog;
    aAxisManagers : ARRAY[1..GVL_Constants.cMaxAxisCount] OF FB_AxisManager;

    uiAxisIndex : UINT;
    bAnyAxisConfigured : BOOL;
    bAllAxesControlAllowed : BOOL;
    bAnyAxisRequireEnableReset : BOOL;
	
	fbTrayProcess : FB_TrayProcess;//料盘自动运送流程
	bControlAuto : BOOL;//料盘自动运送开始标志
	
	// 阻尼器料位数据和初始化管理。
	// 当前只管理数据，不产生任何轴运动命令。
	fbDamperProcess : FB_DamperProcess;
	// 转台与夹紧轴协调流程。
	fbTurntableProcess : FB_TurntableProcess;
	
	// 在线调试时置TRUE产生一次上升沿，重新计算全部坐标。
	// 使用后应恢复FALSE，再次使用时重新产生上升沿。
	bReinitializeDamperCoordinates : BOOL;
		
	// 整套五盘联动流程状态。
	bAutoProcessBusy : BOOL;
	bAutoProcessDone : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[//==============================================================
// 1. 更新HMI心跳状态
//==============================================================
fbHmiWatchdog(
    bEnable := GVL_System.bUseHmiWatchdog,
    udiHeartbeat := GVL_HMI.Comm.udiHeartbeat,
    tTimeout := GVL_System.tHmiWatchdogTimeout
);
//==============================================================
// 1. 料盘流程
//
// 读取FB_DamperProcess上一扫描周期的请求和完成状态。
//==============================================================
fbTrayProcess(
    bStart := bControlAuto,
	
    // Damper三轴完成启动预定位后，
    // 才允许Tray机构开始取第一盘。
    bDamperPrePositionDone :=
        fbDamperProcess.bPrePositionDone,
		
    bTrayChangeRequest :=
        fbDamperProcess.bTrayChangeRequest,

    bDamperProcessDone :=
        fbDamperProcess.bDone,

    stAxisX :=
        GVL_AxisRuntime.Axes[GVL_AxisIndex.TrayX],

    stAxisZ :=
        GVL_AxisRuntime.Axes[GVL_AxisIndex.TrayZ]
);


//==============================================================
// 2. 阻尼器上下料流程
//
// 读取FB_TrayProcess本扫描周期发布的料盘状态。
//==============================================================
fbDamperProcess(
    bStart := bControlAuto,

    bReinitializeCoordinates :=
        bReinitializeDamperCoordinates,

    bTrayAtDamperPosition :=
        fbTrayProcess.bTrayAtDamperPosition,

    bTrayChangeDone :=
        fbTrayProcess.bTrayChangeDone,

    nTrayAtDamperLayer :=
        fbTrayProcess.nCurrentLayer,

    stTurntableStatus :=
        fbTurntableProcess.stStatus,

    stAxisX :=
        GVL_AxisRuntime.Axes[GVL_AxisIndex.DamperX],

    stAxisY :=
        GVL_AxisRuntime.Axes[GVL_AxisIndex.DamperY],

    stAxisZ :=
        GVL_AxisRuntime.Axes[GVL_AxisIndex.DamperZ],

    // 新增：阻尼器夹爪旋转轴。
    stAxisRotation :=
        GVL_AxisRuntime.Axes[
            GVL_AxisIndex.DamperRotation
        ]
);
//==============================================================
// 转台夹紧流程测试
//
//==============================================================

fbTurntableProcess(
    // 读取上下料FB本周期生成的保持型请求。
    stInput := fbDamperProcess.stTurntableInput,

    stTurntableAxis :=
        GVL_AxisRuntime.Axes[GVL_AxisIndex.Turntable],

    stClampingAxis :=
        GVL_AxisRuntime.Axes[GVL_AxisIndex.Clamping],

    // 两个状态继续保存在fbDamperProcess下，保持现有ADS/WPF符号路径。
    eTransferPositionState :=
        fbDamperProcess.eTransferPositionState,

    eAdjustmentPositionState :=
        fbDamperProcess.eAdjustmentPositionState
);

	bAutoProcessBusy :=
		fbTrayProcess.bBusy
		OR fbDamperProcess.bBusy
		OR fbTurntableProcess.stStatus.bBusy;
	
	// 最终Done只能以料盘机构完成最终复位为准。
	bAutoProcessDone :=
		fbTrayProcess.bDone;
//==============================================================
// 4. 统一管理14轴
//
// 所有轴引用、配置、运行数据和管理器实例使用同一个业务下标。
// DamperGripper[7]当前bConfigured=FALSE，
// 管理器会清除该轴命令且不会调用NC运动控制。
//==============================================================
bAnyAxisConfigured := FALSE;
bAllAxesControlAllowed := TRUE;
bAnyAxisRequireEnableReset := FALSE;

FOR uiAxisIndex := 1 TO GVL_Constants.cMaxAxisCount DO
    aAxisManagers[uiAxisIndex](
        bAxisConfigured := GVL_AxisConfig.AxisLimits[uiAxisIndex].bConfigured,
        bProtectionEnabled := GVL_System.bUseHmiWatchdog,
        bHmiOnline := fbHmiWatchdog.bOnline,
        stLimit := GVL_AxisConfig.AxisLimits[uiAxisIndex],
        AxisRef := GVL_AxisRef.AxisRefs[uiAxisIndex],
        stAxis := GVL_AxisRuntime.Axes[uiAxisIndex]
    );

    IF GVL_AxisConfig.AxisLimits[uiAxisIndex].bConfigured THEN
        bAnyAxisConfigured := TRUE;
        bAllAxesControlAllowed :=
            bAllAxesControlAllowed
            AND aAxisManagers[uiAxisIndex].bControlAllowed;
        bAnyAxisRequireEnableReset :=
            bAnyAxisRequireEnableReset
            OR aAxisManagers[uiAxisIndex].bRequireEnableReset;
    END_IF;
END_FOR;


//==============================================================
// 5. 发布HMI通信与全轴汇总状态
//==============================================================
GVL_HMI.Comm.bOnline := fbHmiWatchdog.bOnline;
GVL_HMI.Comm.bTimeout := fbHmiWatchdog.bTimeout;
GVL_HMI.Comm.bControlAllowed :=
    bAnyAxisConfigured AND bAllAxesControlAllowed;
GVL_HMI.Comm.bRequireEnableReset :=
    bAnyAxisRequireEnableReset;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>