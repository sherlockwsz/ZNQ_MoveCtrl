<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="MAIN" Id="{de82ff6c-f728-4f8e-8227-437e5e880436}" SpecialFunc="None">
    <Declaration><![CDATA[//==============================================================
// PLC顶层主程序
//
// MAIN只负责按确定顺序调用顶层功能块并发布公共状态。
// 具体心跳、命令保护和运动控制均在各自FB内部完成。
//==============================================================

PROGRAM MAIN
VAR
    fbHmiWatchdog : FB_HmiWatchdog;
    aAxisManagers : ARRAY[1..GVL_Constants.cMaxAxisCount] OF FB_AxisManager;//14轴声明
	fbDamperGripperManager : FB_GripperManager;//上下料夹爪
    fbAdjustGripperManager : FB_GripperManager;//调整轴夹爪

    uiAxisIndex : UINT;
    uiAutoAxisItem : DINT;
    bAxisInAutoProcess : BOOL;
    bAnyAxisConfigured : BOOL;
    bAllAxesControlAllowed : BOOL;
    bAnyAxisRequireEnableReset : BOOL;
	
	fbTrayProcess : FB_TrayProcess;//料盘自动运送流程
	
	// 阻尼器料位数据和初始化管理。
	// 当前只管理数据，不产生任何轴运动命令。
	fbDamperProcess : FB_DamperProcess;
	// 转台与夹紧轴协调流程。
	// 保留实例名以维持现有ADS诊断路径，类型升级为统一机械单元。
	fbTurntableProcess : FB_TurntableUnit;
	fbScrewdriverProcess : FB_ScrewdriverProcess;
	fbAdjustmentProcess : FB_AdjustmentProcess;
	fbDamperGripperAction : FB_GripperAction; // COM3唯一的自动动作实例
	fbAdjustGripperAction : FB_GripperAction; // COM4唯一的自动动作实例
	fbAutoProcessCoordinator : FB_AutoProcessCoordinator;
	// 在线调试时置TRUE产生一次上升沿，重新计算全部坐标。
	// 使用后应恢复FALSE，再次使用时重新产生上升沿。
	bReinitializeDamperCoordinates : BOOL;
		
	// 整套五盘联动流程状态。
	bAutoProcessBusy : BOOL;
	bAutoProcessDone : BOOL;
	//==============================================================
	// 自动启停控制
	//==============================================================
	
	// WPF启动时写TRUE。
	// 正常完成、人工停止或看门狗超时时由PLC清FALSE。
	bControlAuto : BOOL;
	
	// WPF停止按钮写TRUE。
	// PLC接受后WPF可以恢复FALSE。
	bControlStop : BOOL;
	// WPF一键整机准备命令。
	// 建议WPF只写TRUE，完成或失败后PLC自动清FALSE。
	bControlPrepare : BOOL;

	// WPF单轴回零入口：先写uiHomingAxisIndex，再将bControlHoming置TRUE。
	bControlHoming : BOOL;
	bHomingBusy : BOOL;
	uiHomingAxisIndex : UINT := 1;
	fbSingleAxisHoming : FB_SingleAxisHoming;
	bHomingDone : BOOL;
	bHomingError : BOOL;
	bHomingTimeout : BOOL;
	bHomingRequestRejected : BOOL;
	bHomingAborted : BOOL;
	udiHomingErrorCode : UDINT;
	
	
	//==============================================================
	// 自动停止内部状态
	//==============================================================
	fbAutoStopManager : FB_AutoStopManager;
	fbAutoStart : FB_AutoStartCoordinator; // 自动启动、使能及就绪协调
	fbMachineSupervisor : FB_MachineSupervisor; // 整机第一故障监控与汇总
	fbMachineModeManager : FB_MachineModeManager; // 整机唯一运行模式
	trigStopRequest : R_TRIG;
	trigResetMachineFault : R_TRIG; // 故障复位只接受一次上升沿
	
	// 人工停止或看门狗超时的组合请求。
	bStopRequestRaw : BOOL;
	
	// 停止请求锁存。
	// 从接受停止开始保持到FB_AutoStopManager完成。
	bAbortProcesses : BOOL;
	
	// 对WPF发布的状态。
	bAutoStopping : BOOL;
	bAutoStopDone : BOOL;
	bAutoStopError : BOOL;
	bAutoStopTimeout : BOOL;
	uiAutoStopErrorAxis : UINT;
	nAutoStopErrorID : UDINT;

	//==============================================================
	// 整机统一故障状态
	//==============================================================
	// WPF/在线调试产生一个脉冲；仅当源故障已消失且Stop不在执行时复位。
	bResetMachineFault : BOOL;
	bMachineFault : BOOL;
	bMachineFaultResetBlocked : BOOL;
	eMachineFaultSource : E_MachineFaultSource;
	uiMachineFaultAxis : UINT;
	udiMachineFaultCode : UDINT;

	// 整机模式与命令所有权状态（供ADS/WPF读取）。
	eMachineMode : E_MachineMode;
	bMachineModeChanged : BOOL;
	bManualModeActive : BOOL;
	bAutoModeActive : BOOL;
	bHomingModeActive : BOOL;
	bStopOwnerActive : BOOL;
	bRecoveryModeActive : BOOL;
	
	
	
	bDamperGripperActionFault : BOOL; // 锁存供在线诊断；人工确认后再复位
	udDamperGripperActionError : UDINT;	
	bDamperGripperAutoReady     : BOOL;
	bDamperGripperRequired      : BOOL; // COM3正在参与启动、流程或动作
	bDamperGripperStartRejected : BOOL; // 供在线诊断；人工确认后清除
	bAdjustGripperActionFault : BOOL;
	udAdjustGripperActionError : UDINT;
	bAdjustGripperAutoReady : BOOL;
	bAdjustGripperRequired : BOOL;
	bAdjustGripperStartRejected : BOOL;
	bExternalGrippersStopRequired : BOOL;
	bExternalGrippersStopDone : BOOL;
	bExternalGrippersStopError : BOOL;
	udiExternalGrippersStopError : UDINT;
	bScrewdriverGroupStopRequired : BOOL;
	bScrewdriverGroupStopDone : BOOL;
	bScrewdriverGroupStopError : BOOL;
	
	fbMachinePreparation : FB_MachinePreparation;

	
	bPreparationStartRequest : BOOL;
	bMachinePreparationBusy  : BOOL;
	bMachinePreparationDone  : BOOL;
	bMachinePreparationError : BOOL;
	bMachinePreparationTimeout : BOOL;
	uiMachinePreparationErrorAxis : UINT;
	udiMachinePreparationError : UDINT;
	
	bPreparationModeActive : BOOL;
	
	// TRUE：夹爪只做通信联调，异常不触发整机停机。
    // 正式运行前必须恢复为FALSE。
    bDebugBypassDamperGripper : BOOL := TRUE;
	
	stPreparationConfig : ST_MachinePreparationConfig;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================
// 更新现场数字量输入
// 必须位于所有设备控制和自动流程之前
// =============================================================
PRG_IO_ReadInputs();

//==============================================================
// 1. 更新HMI心跳状态
//==============================================================
fbHmiWatchdog(
    bEnable := GVL_System.bUseHmiWatchdog,
    udiHeartbeat := GVL_HMI.Comm.udiHeartbeat,
    tTimeout := GVL_CommunicationConfig.stHmi.tWatchdogTimeout
);

//==============================================================
// 2. 组合并锁存停止请求
//
// 触发来源：
// 1. WPF停止设备按钮；
// 2. HMI心跳超时。
//
// 不使用NOT fbHmiWatchdog.bOnline作为条件，
// 避免PLC刚启动且尚未收到第一个心跳时误触发停止。
//==============================================================
bStopRequestRaw :=
    bControlStop
    OR
    (
        GVL_System.bUseHmiWatchdog
        AND fbHmiWatchdog.bTimeout
    );

trigStopRequest(
    CLK := bStopRequestRaw
);
// 防止WPF或在线调试长时间保持复位位：
// 只有FALSE->TRUE的边沿才允许执行一次故障复位。
trigResetMachineFault(CLK := bResetMachineFault);

IF trigStopRequest.Q THEN
    // 清除上一次停止完成反馈。
    bAutoStopDone := FALSE;

    // 清除自动运行请求。
    bControlAuto := FALSE;
	bControlPrepare := FALSE;
    bControlHoming := FALSE;

    // 锁存流程中止和全轴停止。
    bAbortProcesses := TRUE;
END_IF;

//==============================================================
// 停止请求存在或停止过程未完成时，禁止启动自动流程
//
// 防止停止过程中出现无效的bStart上升沿，
// 也防止bControlStop尚未释放时重新启动。
//==============================================================
IF
    bStopRequestRaw
    OR bAbortProcesses
    OR fbMachineSupervisor.stFault.bActive
    OR bControlHoming
    OR fbSingleAxisHoming.bBusy
    OR (fbMachineModeManager.eMode = E_MachineMode.Homing)
THEN
    bControlAuto := FALSE;
	bControlPrepare := FALSE;
END_IF;

// 启动条件由夹爪管理层统一发布，MAIN不再重复读取底层有效位。
bDamperGripperAutoReady :=
    GVL_DamperGripper.stDamperGripper.State.bAutoReady;
bAdjustGripperAutoReady :=
    GVL_DamperGripper.stAdjustGripper.State.bAutoReady;

//==============================================================
// 选中单轴回零
//
// 新请求只允许从Manual模式进入。进入Homing后，FB持续持有
// 自己锁存的轴号和配置，不受WPF中途改写选择轴号影响。
//==============================================================
fbSingleAxisHoming(
    bStart := bControlHoming,
    bAbort :=
        bStopRequestRaw
        OR bAbortProcesses
        OR bMachineFault,
    bReset := trigResetMachineFault.Q,
    bModeGranted := fbMachineModeManager.bHomingAllowed,
    bControlAllowed :=
        GVL_HMI.Comm.bControlAllowed
        AND
        (
            (fbMachineModeManager.eMode = E_MachineMode.Manual)
            OR fbSingleAxisHoming.bBusy
        )
        AND NOT bControlAuto
        AND NOT bControlPrepare
        AND NOT fbMachinePreparation.bBusy
        AND NOT fbAutoStart.bEnabling
        AND NOT fbAutoProcessCoordinator.bBusy,
    bSimulationMode := GVL_AxisHoming.bSimulationMode,
    uiSelectedAxis := uiHomingAxisIndex,
    aConfig := GVL_AxisHoming.AxisConfig,
    aAxes := GVL_AxisRuntime.Axes
);

bHomingBusy := fbSingleAxisHoming.bBusy;
bHomingDone := fbSingleAxisHoming.bDone;
bHomingError := fbSingleAxisHoming.bError;
bHomingTimeout := fbSingleAxisHoming.bTimeout;
bHomingRequestRejected := fbSingleAxisHoming.bRequestRejected;
bHomingAborted := fbSingleAxisHoming.bAborted;
udiHomingErrorCode := fbSingleAxisHoming.udiErrorCode;

// 发布稳定ADS状态，WPF无需读取FB实例内部变量。
GVL_AxisHoming.Status.bBusy := bHomingBusy;
GVL_AxisHoming.Status.bDone := bHomingDone;
GVL_AxisHoming.Status.bError := bHomingError;
GVL_AxisHoming.Status.bTimeout := bHomingTimeout;
GVL_AxisHoming.Status.bRequestRejected := bHomingRequestRejected;
GVL_AxisHoming.Status.bAborted := bHomingAborted;
GVL_AxisHoming.Status.bSimulationActive :=
    GVL_AxisHoming.bSimulationMode AND bHomingBusy;
GVL_AxisHoming.Status.uiRequestedAxis := uiHomingAxisIndex;
GVL_AxisHoming.Status.uiActiveAxis := fbSingleAxisHoming.uiActiveAxis;
GVL_AxisHoming.Status.eStep := fbSingleAxisHoming.eStep;
GVL_AxisHoming.Status.eStrategy := fbSingleAxisHoming.eStrategy;
GVL_AxisHoming.Status.eDirection := fbSingleAxisHoming.eDirection;
GVL_AxisHoming.Status.udiErrorCode := udiHomingErrorCode;

// 回零完成后返回Manual，并保持该轴使能，便于继续单轴调试。
IF bControlHoming AND bHomingDone THEN
    IF (fbSingleAxisHoming.uiActiveAxis >= 1)
        AND (fbSingleAxisHoming.uiActiveAxis <= GVL_Constants.cMaxAxisCount) THEN
        GVL_AxisRuntime.Axes[
            fbSingleAxisHoming.uiActiveAxis
        ].Cmd.bEnable := TRUE;
    END_IF;
    bControlHoming := FALSE;
END_IF;

IF bControlHoming
    AND
    (
        bHomingError
        OR bHomingRequestRejected
        OR bHomingAborted
    )
THEN
    bControlHoming := FALSE;
END_IF;

	// 必须放在 Stop 请求处理、COM3 就绪计算之后，
	// 且必须放在 Tray/Damper/Turntable 流程调用之前。
	fbAutoStart(
		bMachinePreparationDone :=
			fbMachinePreparation.bDone,
		
		bMachinePreparationError :=
			fbMachinePreparation.bError,
		bRequest := bControlAuto,
		bCancel := bStopRequestRaw
				   OR bAbortProcesses
				   OR fbAutoStopManager.bError
				   OR fbMachineSupervisor.stFault.bActive
				   OR bControlHoming
				   OR fbSingleAxisHoming.bBusy
				   OR (fbMachineModeManager.eMode = E_MachineMode.Homing),
		bHmiOnline := fbHmiWatchdog.bOnline,
		bControlAllowed := GVL_HMI.Comm.bControlAllowed,
		bGripperReady :=
			bDamperGripperAutoReady AND bAdjustGripperAutoReady,
		bGripperActionFault :=
			bDamperGripperActionFault OR bAdjustGripperActionFault,
		bProcessDone := bAutoProcessDone,
		tEnableTimeout := GVL_SafetyConfig.stStartup.tEnableTimeout,
		aAxes := GVL_AxisRuntime.Axes
	);
	
	IF fbAutoStart.bStartRejected THEN
		// 沿用 WPF 当前直接读写的请求位：拒绝后由 PLC 清除。
		bControlAuto := FALSE;
	
		IF fbAutoStart.uiErrorCode = TO_UINT(E_AutoStartErrorCode.GripperNotReady) THEN
			IF NOT bDamperGripperAutoReady THEN
				bDamperGripperStartRejected := TRUE;
			END_IF;
			IF NOT bAdjustGripperAutoReady THEN
				bAdjustGripperStartRejected := TRUE;
			END_IF;
		END_IF;
	END_IF;
	
	
//==============================================================
// 操作员一键准备准入
//
// 只允许在Manual模式并且自动流程未运行时受理。
// 已经进入准备流程后，允许请求保持到Done/Error。
//==============================================================
IF bControlPrepare
    AND NOT fbMachinePreparation.bBusy
    AND
    (
        (fbMachineModeManager.eMode <> E_MachineMode.Manual)
        OR bControlAuto
        OR fbAutoStart.bEnabling
        OR fbAutoStart.bProcessStart
        OR fbAutoProcessCoordinator.bBusy
        OR bControlHoming
    )
THEN
    // 当前模式不允许一键准备，拒绝本次请求。
    bControlPrepare := FALSE;
END_IF;
// 自动启动和操作员一键准备共用同一个FB实例。
// 禁止分别建立两个FB_MachinePreparation实例。
bPreparationStartRequest :=
    (
        // 自动启动协调器发出的内部准备请求。
        fbAutoStart.bMachinePreparationRequest

        OR

        // 操作员请求只允许从Manual模式进入。
        (
            bControlPrepare
            AND
            (
                (fbMachineModeManager.eMode = E_MachineMode.Manual)
                OR fbMachinePreparation.bBusy
            )
        )
    )
    AND NOT bStopRequestRaw
    AND NOT bAbortProcesses
    AND NOT bMachineFault
    AND NOT bControlHoming
    AND fbHmiWatchdog.bOnline
    AND GVL_HMI.Comm.bControlAllowed;

stPreparationConfig.fTrayXStandby := GVL_PositionConfig.stTray.fLiftStationX;
stPreparationConfig.fTrayZStandby := GVL_PositionConfig.stTray.fStandbyZ;
stPreparationConfig.fDamperXStandby := GVL_PositionConfig.stDamper.stGrid.stOrigin.X + GVL_PositionConfig.stDamper.stGrid.aSlotOffset[1, 1].X;
stPreparationConfig.fDamperYStandby := GVL_PositionConfig.stDamper.stGrid.stOrigin.Y + GVL_PositionConfig.stDamper.stGrid.aSlotOffset[1, 1].Y;
stPreparationConfig.fDamperZStandby := GVL_PositionConfig.stDamper.fSafeZ;
stPreparationConfig.fDamperRotationZero := GVL_PositionConfig.stDamper.fRotationZero;
stPreparationConfig.fClampOpenPosition := GVL_PositionConfig.stClamping.fReadyPosition;
stPreparationConfig.fTurntableZero := GVL_PositionConfig.stTurntable.fPosition0;
stPreparationConfig.fAdjustmentXStandby := GVL_PositionConfig.stAdjustment.stReady.X;
stPreparationConfig.fAdjustmentYStandby := GVL_PositionConfig.stAdjustment.stReady.Y;
stPreparationConfig.fAdjustmentZStandby := GVL_PositionConfig.stAdjustment.stReady.Z;
stPreparationConfig.fScrewdriverYZero := GVL_PositionConfig.stScrewdriver.stReady.Y;
stPreparationConfig.fScrewdriverZSafe := GVL_PositionConfig.stScrewdriver.stReady.Z;
stPreparationConfig.fTrayVelocity := GVL_MotionConfig.stPreparation.stTray.fVelocity;
stPreparationConfig.fDamperVelocity := GVL_MotionConfig.stPreparation.stDamperLinear.fVelocity;
stPreparationConfig.fDamperRotationVelocity := GVL_MotionConfig.stPreparation.stDamperRotation.fVelocity;
stPreparationConfig.fClampVelocity := GVL_MotionConfig.stPreparation.stClamping.fVelocity;
stPreparationConfig.fTurntableVelocity := GVL_MotionConfig.stPreparation.stTurntable.fVelocity;
stPreparationConfig.fAdjustmentVelocity := GVL_MotionConfig.stPreparation.stAdjustment.fVelocity;
stPreparationConfig.fScrewdriverVelocity := GVL_MotionConfig.stPreparation.stScrewdriver.fVelocity;
stPreparationConfig.fLinearTolerance := GVL_MotionConfig.stPreparation.fLinearPositionTolerance;
stPreparationConfig.fRotationTolerance := GVL_MotionConfig.stPreparation.fRotationPositionTolerance;
stPreparationConfig.tReadyTimeout := GVL_MotionConfig.stPreparation.tReadyTimeout;
stPreparationConfig.tMotionTimeout := GVL_MotionConfig.stPreparation.tMoveTimeout;

fbMachinePreparation(
    bStart := bPreparationStartRequest,

    bAbort :=
        bStopRequestRaw
        OR bAbortProcesses
        OR bMachineFault,

    bReset := trigResetMachineFault.Q,

    stConfig := stPreparationConfig,

    aAxes := GVL_AxisRuntime.Axes,

    // 与正式Damper流程复用同一个COM3自动动作实例。
    ioGripperAction := fbDamperGripperAction,
    ioGripper := GVL_DamperGripper.stDamperGripper,

    // 与正式调整流程复用同一个COM4自动动作实例。
    ioAdjustGripperAction := fbAdjustGripperAction,
    ioAdjustGripper := GVL_DamperGripper.stAdjustGripper
);
bMachinePreparationBusy :=
    fbMachinePreparation.bBusy;

bMachinePreparationDone :=
    fbMachinePreparation.bDone;

bMachinePreparationError :=
    fbMachinePreparation.bError;

bMachinePreparationTimeout :=
    fbMachinePreparation.bTimeout;

uiMachinePreparationErrorAxis :=
    fbMachinePreparation.uiErrorAxis;

udiMachinePreparationError :=
    fbMachinePreparation.udiErrorCode;


// 操作员一键准备完成后返回手动模式。
// 将十根轴的手动使能保持为TRUE，避免模式切换时立即掉使能。
IF bControlPrepare
    AND fbMachinePreparation.bDone
THEN
    FOR uiAutoAxisItem := 1 TO
        UPPER_BOUND(GVL_AxisIndex.AutoProcessAxes, 1)
    DO
        uiAxisIndex :=
            GVL_AxisIndex.AutoProcessAxes[uiAutoAxisItem];

        GVL_AxisRuntime.Axes[
            uiAxisIndex
        ].Cmd.bEnable := TRUE;
    END_FOR;

    bControlPrepare := FALSE;
END_IF;

IF bControlPrepare
    AND fbMachinePreparation.bError
THEN
    bControlPrepare := FALSE;
END_IF;	

//==============================================================
// 自动流程使用轴的自动使能
//
// 只有以下条件全部满足才自动使能：
// 1. WPF请求自动运行；
// 2. 没有执行停止过程；
// 3. HMI心跳在线；
// 4. CommandGuard已经重新开放控制。
//
// 自动流程FB会等待各轴State.bReady，
// 因此不需要在同一扫描周期立即开始运动。
//==============================================================
IF fbAutoStart.bEnableAxes
    AND NOT bStopRequestRaw
    AND NOT bAbortProcesses
    AND fbHmiWatchdog.bOnline
    AND GVL_HMI.Comm.bControlAllowed
THEN
    // 与启动检查、运行监控共用同一份自动轴清单。
    FOR uiAutoAxisItem := LOWER_BOUND(GVL_AxisIndex.AutoProcessAxes, 1) TO UPPER_BOUND(GVL_AxisIndex.AutoProcessAxes, 1) DO
        uiAxisIndex := GVL_AxisIndex.AutoProcessAxes[uiAutoAxisItem];
        // 自动启动只写Auto通道，不覆盖WPF手动Cmd。
        GVL_AxisRuntime.Axes[uiAxisIndex].AutoCmd.bEnable := TRUE;
    END_FOR;
END_IF;


// ============================================================
// 1.整机五盘流程协调
// 必须在八轴使能请求之后、FB_AutoStopManager 之前调用。
// ============================================================
fbAutoProcessCoordinator(
    bStart := fbAutoStart.bProcessStart,
    bAbort := bAbortProcesses OR bStopRequestRaw,
    bReset := trigResetMachineFault.Q,
    bStopRequest := bStopRequestRaw,
	bMachinePrepared := fbMachinePreparation.bDone,
	
    bReinitializeCoordinates := bReinitializeDamperCoordinates,

    ioTrayProcess := fbTrayProcess,
    ioDamperProcess := fbDamperProcess,
    ioTurntableUnit := fbTurntableProcess,
    ioGripperAction := fbDamperGripperAction,
    ioAdjustGripperAction := fbAdjustGripperAction,

    ioGripper := GVL_DamperGripper.stDamperGripper,
	ioAdjustGripper := GVL_DamperGripper.stAdjustGripper,
	ioScrewdriverProcess := fbScrewdriverProcess,
	ioAdjustmentProcess := fbAdjustmentProcess,
    aAxes := GVL_AxisRuntime.Axes
);

// 启动准备阶段由启动协调器负责；运行阶段由流程协调器负责。
bAutoProcessBusy :=
    fbAutoStart.bEnabling
    OR fbAutoProcessCoordinator.bBusy;

bAutoProcessDone :=
    fbAutoProcessCoordinator.bDone
    AND NOT fbAutoStart.bEnabling;

// 启动请求不满足条件时由FB_AutoStartCoordinator执行“拒绝”，
// 只有进入启动/运行/动作阶段后，COM3健康才升级为整机运行条件。
bDamperGripperRequired :=
    fbAutoStart.bEnabling
    OR fbAutoStart.bProcessStart
	OR fbMachinePreparation.bBusy
    OR fbAutoProcessCoordinator.bBusy
    OR fbDamperGripperAction.bBusy;

bAdjustGripperRequired :=
    fbAutoStart.bEnabling
    OR fbAutoStart.bProcessStart
    OR fbMachinePreparation.bBusy
    OR fbAutoProcessCoordinator.bBusy
    OR fbAdjustGripperAction.bBusy;

// ============================================================
// 整机自动运行故障监控与第一故障汇总
// 必须位于流程协调器之后、Stop管理器之前：
// 本周期产生的COM3/转台故障可在本周期进入Stop首扫覆盖。
// ============================================================

fbMachineSupervisor(
    bReset := trigResetMachineFault.Q
              AND NOT bAbortProcesses
              AND NOT fbAutoStopManager.bBusy,

			  
    bAutoActive := bControlAuto
                   OR fbAutoStart.bEnabling
                   OR fbAutoStart.bProcessStart
				   OR fbAutoProcessCoordinator.bBusy
				   OR fbMachinePreparation.bBusy
				   OR bControlPrepare
                   OR fbSingleAxisHoming.bBusy
                   OR bControlHoming,
    bHmiWatchdogTimeout :=
        GVL_System.bUseHmiWatchdog AND fbHmiWatchdog.bTimeout,


	bMachinePreparationFault :=
    fbMachinePreparation.bError,

	uiMachinePreparationErrorAxis :=
		fbMachinePreparation.uiErrorAxis,
	
	udiMachinePreparationError :=
		fbMachinePreparation.udiErrorCode,

    bAxisHomingFault := fbSingleAxisHoming.bError,
    uiAxisHomingErrorAxis := fbSingleAxisHoming.uiActiveAxis,
    udiAxisHomingError := fbSingleAxisHoming.udiErrorCode,
    bAutoStartErrorPulse := fbAutoStart.bErrorPulse,
    bAutoStartTimeout := fbAutoStart.bTimeout,
    uiAutoStartErrorAxis := fbAutoStart.uiErrorAxisIndex,
    uiAutoStartErrorCode := fbAutoStart.uiErrorCode,

	// 调试旁路打开时，对Supervisor报告夹爪健康，
	// 但底层真实反馈和诊断变量仍继续更新。
	bDamperGripperHealthOK :=
		bDebugBypassDamperGripper
		OR GVL_DamperGripper.stDamperGripper.State.bHealthy,
	
	// 调试旁路打开时，不把夹爪健康作为整机运行条件。
	bDamperGripperRequired :=
		bDamperGripperRequired
		AND NOT bDebugBypassDamperGripper,
	
	// 调试旁路打开时，夹爪动作错误不升级为整机故障。
	bDamperGripperFault :=
		fbAutoProcessCoordinator.bGripperActionFault
		AND NOT bDebugBypassDamperGripper,
	
	udiDamperGripperError :=
		fbAutoProcessCoordinator.udGripperActionError,
	bAdjustGripperHealthOK :=
		GVL_DamperGripper.stAdjustGripper.State.bHealthy,
	bAdjustGripperRequired := bAdjustGripperRequired,
	bAdjustGripperFault :=
		fbAutoProcessCoordinator.bAdjustGripperActionFault,
	udiAdjustGripperError :=
		fbAutoProcessCoordinator.udAdjustGripperActionError,
    bTurntableFault := fbAutoProcessCoordinator.bTurntableFault,
    udiTurntableError := fbTurntableProcess.stStatus.nErrorID,
	bScrewdriverFault :=
    fbAutoProcessCoordinator.bScrewdriverFault,
	uiScrewdriverErrorAxis :=
		fbAutoProcessCoordinator.uiScrewdriverErrorAxis,
	udiScrewdriverError :=
		fbAutoProcessCoordinator.udScrewdriverError,
    // Stop管理器在本调用之后执行，因此这里读取其上一扫描周期状态。
    bAutoStopFault := fbAutoStopManager.bError,
    bAutoStopTimeout := fbAutoStopManager.bTimeout,
    uiAutoStopErrorAxis := fbAutoStopManager.uiErrorAxisIndex,
    udiAutoStopError := fbAutoStopManager.nErrorID,

    aAxes := GVL_AxisRuntime.Axes
);

// 发布稳定的ADS诊断符号。
bMachineFault := fbMachineSupervisor.stFault.bActive;
bMachineFaultResetBlocked := fbMachineSupervisor.bResetBlocked;
eMachineFaultSource := fbMachineSupervisor.stFault.eSource;
uiMachineFaultAxis := fbMachineSupervisor.stFault.uiAxisIndex;
udiMachineFaultCode := fbMachineSupervisor.stFault.udiErrorCode;

// 保留原有COM3诊断符号路径，数值改由统一第一故障状态派生。
bDamperGripperActionFault :=
    bMachineFault
    AND (eMachineFaultSource = E_MachineFaultSource.DamperGripper);

IF bDamperGripperActionFault THEN
    udDamperGripperActionError := udiMachineFaultCode;
ELSIF trigResetMachineFault.Q AND NOT bMachineFault THEN
    udDamperGripperActionError := 0;
END_IF;

bAdjustGripperActionFault :=
    bMachineFault
    AND (eMachineFaultSource = E_MachineFaultSource.AdjustGripper);

IF bAdjustGripperActionFault THEN
    udAdjustGripperActionError := udiMachineFaultCode;
ELSIF trigResetMachineFault.Q AND NOT bMachineFault THEN
    udAdjustGripperActionError := 0;
END_IF;

IF trigResetMachineFault.Q AND NOT bMachineFault THEN
    bDamperGripperStartRejected := FALSE;
	bAdjustGripperStartRejected := FALSE;
END_IF;

// 新运行故障统一进入现有受控Stop链路。
IF fbMachineSupervisor.bStopRequestPulse
    AND NOT bAbortProcesses THEN

    bControlAuto := FALSE;
    bAbortProcesses := TRUE;
END_IF;

// 锁存故障期间禁止WPF重新拉起自动流程。
IF bMachineFault THEN
    bControlAuto := FALSE;
    bControlPrepare := FALSE;
    bControlHoming := FALSE;
END_IF;
// ============================================================
// 自动流程正常完成
// 只有不存在任何流程故障时才允许发布正常完成。
// ============================================================
IF bAutoProcessDone
    AND fbAutoStart.bProcessStart
    AND NOT bAbortProcesses
    AND NOT bMachineFault
THEN
    bControlAuto := FALSE;
END_IF;
//==============================================================
// 全轴停止覆盖
//
// 必须放在Tray、Damper、Turntable之后，
// 确保可以覆盖本扫描周期内流程FB产生的命令。
//
// 必须放在FB_AxisManager之前，
// 让轴管理器在同一扫描周期收到bStop。
//==============================================================
// 非NC外部设备必须确认本轮Stop；仿真夹爪通道不要求真实回执。
bScrewdriverGroupStopRequired :=
    fbScrewdriverProcess.bScrewdriverStopRequired;
bScrewdriverGroupStopDone :=
    fbScrewdriverProcess.bScrewdriverStopDone;
bScrewdriverGroupStopError :=
    fbScrewdriverProcess.bScrewdriverStopError;

bExternalGrippersStopRequired :=
    NOT GVL_SequenceConfig.bSkipDamperGripperForSimulation
    OR NOT GVL_SequenceConfig.bSkipAdjustGripperForSimulation
    OR bScrewdriverGroupStopRequired;
bExternalGrippersStopDone :=
    (GVL_SequenceConfig.bSkipDamperGripperForSimulation
     OR GVL_DamperGripper.stDamperGripper.State.bStopAcknowledged)
    AND
    (GVL_SequenceConfig.bSkipAdjustGripperForSimulation
     OR GVL_DamperGripper.stAdjustGripper.State.bStopAcknowledged)
    AND
    (NOT bScrewdriverGroupStopRequired
     OR bScrewdriverGroupStopDone);
bExternalGrippersStopError :=
    (NOT GVL_SequenceConfig.bSkipDamperGripperForSimulation
     AND GVL_DamperGripper.stDamperGripper.State.bStopError)
    OR
    (NOT GVL_SequenceConfig.bSkipAdjustGripperForSimulation
     AND GVL_DamperGripper.stAdjustGripper.State.bStopError)
    OR
    (bScrewdriverGroupStopRequired
     AND bScrewdriverGroupStopError);

udiExternalGrippersStopError := 0;
IF NOT GVL_SequenceConfig.bSkipDamperGripperForSimulation
    AND GVL_DamperGripper.stDamperGripper.State.bStopError
THEN
    udiExternalGrippersStopError :=
        GVL_DamperGripper.stDamperGripper.State.udStopErrorCode;
ELSIF NOT GVL_SequenceConfig.bSkipAdjustGripperForSimulation
    AND GVL_DamperGripper.stAdjustGripper.State.bStopError
THEN
    udiExternalGrippersStopError :=
        GVL_DamperGripper.stAdjustGripper.State.udStopErrorCode;
ELSIF bScrewdriverGroupStopRequired
    AND bScrewdriverGroupStopError
THEN
    udiExternalGrippersStopError :=
        TO_UDINT(E_ScrewdriverErrorCode.ProcessFaultWithoutDetail);
END_IF;

fbAutoStopManager(
	bExecute := bAbortProcesses,
	tStopTimeout := GVL_SafetyConfig.stStop.tTimeout,
	bExternalStopRequired := bExternalGrippersStopRequired,
	bExternalStopDone := bExternalGrippersStopDone,
	bExternalStopError := bExternalGrippersStopError,
	udiExternalStopError := udiExternalGrippersStopError,
	aAxes := GVL_AxisRuntime.Axes
);


//==============================================================
// 发布停止状态
//==============================================================
bAutoStopping :=
	fbAutoStopManager.bBusy;

bAutoStopError :=
	fbAutoStopManager.bError;

bAutoStopTimeout :=
	fbAutoStopManager.bTimeout;

uiAutoStopErrorAxis :=
	fbAutoStopManager.uiErrorAxisIndex;

nAutoStopErrorID :=
	fbAutoStopManager.nErrorID;

//==============================================================
// 锁存停止完成反馈
//
// MAIN继续锁存停止完成，直到下一次自动启动。
// Stop管理器自身的Done保持到停止请求撤销。
//==============================================================
IF fbAutoStopManager.bDone THEN
	bAutoStopDone := TRUE;
END_IF;

// 下一次自动启动时清除上一次停止完成反馈。
IF bControlAuto THEN
	bAutoStopDone := FALSE;
END_IF;

//==============================================================
// 整机唯一运行模式
// 使用本周期最新的自动、故障和Stop反馈；模式只负责授权，
// 实际命令由后面的逐轴Arbiter选择。
//==============================================================
fbMachineModeManager(
    bControlAllowed := GVL_HMI.Comm.bControlAllowed,
	bPreparationRequest :=
		bPreparationStartRequest
		AND
		(
			NOT fbMachinePreparation.bDone
			OR fbAutoStart.bMachinePreparationRequest
		),
	bPreparationBusy := fbMachinePreparation.bBusy,
    bAutoRequest := bControlAuto,
    bAutoEnabling := fbAutoStart.bEnabling,
    bAutoRunning :=
        fbAutoStart.bProcessStart
        OR fbAutoProcessCoordinator.bBusy,
	bHomingRequest :=
        bControlHoming
        OR fbSingleAxisHoming.bModeRequest,
	bHomingBusy := fbSingleAxisHoming.bBusy,
    bStopActive :=
        bStopRequestRaw
        OR bAbortProcesses
        OR fbAutoStopManager.bBusy
        OR fbAutoStopManager.bError,
    bMachineFault := bMachineFault
);

eMachineMode := fbMachineModeManager.eMode;
bMachineModeChanged := fbMachineModeManager.bModeChanged;
bManualModeActive := fbMachineModeManager.bManualAllowed;
bAutoModeActive := fbMachineModeManager.bAutoAllowed;
bHomingModeActive := fbMachineModeManager.bHomingAllowed;
bStopOwnerActive := fbMachineModeManager.bStopOwnerActive;
bRecoveryModeActive := fbMachineModeManager.bRecoveryModeActive;
bPreparationModeActive := fbMachineModeManager.bPreparationAllowed;

//==============================================================
// 两个RS485夹爪的统一管理层
// 必须位于模式管理器之后，使用本周期最新的命令所有权。
//==============================================================
// COM3：阻尼器上下料夹爪，参与当前自动流程和整机Stop。
fbDamperGripperManager(
    bEnableComm := NOT GVL_SequenceConfig.bSkipDamperGripperForSimulation,
    bSimulationMode := GVL_SequenceConfig.bSkipDamperGripperForSimulation,
    bStopRequested := bStopRequestRaw OR bAbortProcesses,
    bControlAllowed := GVL_HMI.Comm.bControlAllowed,
    eMachineMode := eMachineMode,
    ioGripper := GVL_DamperGripper.stDamperGripper
);

// COM4：调整流程夹爪；独立串口、Manager和自动Action实例。
fbAdjustGripperManager(
    bEnableComm := NOT GVL_SequenceConfig.bSkipAdjustGripperForSimulation,
    bSimulationMode := GVL_SequenceConfig.bSkipAdjustGripperForSimulation,
    bStopRequested := bStopRequestRaw OR bAbortProcesses,
    bControlAllowed := GVL_HMI.Comm.bControlAllowed,
    eMachineMode := eMachineMode,
    ioGripper := GVL_DamperGripper.stAdjustGripper
);
//==============================================================
// 停止管理器完成后解除流程Abort
//
// 本周期流程FB已经先读取过bAbortProcesses=TRUE，
// 只有Stop解除锁定、所有已配置轴确认掉使能后才解除。
// 停止失败/超时保持Abort和故障锁存，禁止自动重启。
//==============================================================
IF fbAutoStopManager.bDone AND NOT bStopRequestRaw THEN
	bAbortProcesses := FALSE;
END_IF;
//==============================================================
// 4. 统一管理14轴
//
// 所有轴引用、配置、运行数据和管理器实例使用同一个业务下标。
// DamperGripper[7]当前bConfigured=FALSE，
// 管理器会清除该轴命令且不会调用NC运动控制。
//==============================================================
bAnyAxisConfigured := FALSE;
bAllAxesControlAllowed := TRUE;
bAnyAxisRequireEnableReset := FALSE;

FOR uiAxisIndex := 1 TO GVL_Constants.cMaxAxisCount DO
    // 自动模式下只有清单中的八根轴能够取得Auto所有权。
    bAxisInAutoProcess := FALSE;
    FOR uiAutoAxisItem := LOWER_BOUND(GVL_AxisIndex.AutoProcessAxes, 1) TO UPPER_BOUND(GVL_AxisIndex.AutoProcessAxes, 1) DO
        IF uiAxisIndex = GVL_AxisIndex.AutoProcessAxes[uiAutoAxisItem] THEN
            bAxisInAutoProcess := TRUE;
            EXIT;
        END_IF;
    END_FOR;

    aAxisManagers[uiAxisIndex](
        bAxisConfigured := GVL_AxisConfig.AxisLimits[uiAxisIndex].bConfigured,
        bAxisUsedByAuto := bAxisInAutoProcess,
        bAxisSelectedForHoming :=
            fbSingleAxisHoming.bBusy
            AND (uiAxisIndex = fbSingleAxisHoming.uiActiveAxis),
        eMachineMode := eMachineMode,
        bProtectionEnabled := GVL_System.bUseHmiWatchdog,
        bHmiOnline := fbHmiWatchdog.bOnline,
        // 看门狗失联期间，Stop管理器拥有使能控制权；
        // Guard仍清除普通运动命令，不能提前撤使能。
        bStopSequenceActive := bAbortProcesses OR fbAutoStopManager.bError,
        stLimit := GVL_AxisConfig.AxisLimits[uiAxisIndex],
        AxisRef := GVL_AxisRef.AxisRefs[uiAxisIndex],
        stAxis := GVL_AxisRuntime.Axes[uiAxisIndex]
    );

    IF GVL_AxisConfig.AxisLimits[uiAxisIndex].bConfigured THEN
        bAnyAxisConfigured := TRUE;
        bAllAxesControlAllowed :=
            bAllAxesControlAllowed
            AND aAxisManagers[uiAxisIndex].bControlAllowed;
        bAnyAxisRequireEnableReset :=
            bAnyAxisRequireEnableReset
            OR aAxisManagers[uiAxisIndex].bRequireEnableReset;
    END_IF;
END_FOR;


//==============================================================
// 5. 发布HMI通信与全轴汇总状态
//==============================================================
GVL_HMI.Comm.bOnline := fbHmiWatchdog.bOnline;
GVL_HMI.Comm.bTimeout := fbHmiWatchdog.bTimeout;
GVL_HMI.Comm.bControlAllowed :=
    bAnyAxisConfigured AND bAllAxesControlAllowed;
GVL_HMI.Comm.bRequireEnableReset :=
    bAnyAxisRequireEnableReset;

// =============================================================
// COM5/COM6独立通信实例；自动工艺由FB_ScrewdriverProcess中的
// FB_DualScrewdriverAction通过GVL接口同步发布命令。
// =============================================================
PRG_ScrewdriverManager();
	
// =============================================================
// 3.最后写入物理输出
// 必须放在本周期所有控制逻辑之后
// =============================================================
PRG_IO_WriteOutputs();
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
