<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{de82ff6c-f728-4f8e-8227-437e5e880436}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    fbAxis1 : FB_AxisControl;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
    最小单轴调试主程序

    初期直接使用GVL_AxisRuntime.Axis1作为ADS接口：
    上位机写入Cmd和Set；
    上位机读取Data、State和Alarm。
*)

fbAxis1(
    bControlAllowed := TRUE,//可以被控制
    stLimit         := GVL_AxisConfig.Axis1Limit,// 当前轴的软件限位配置
    AxisRef         := GVL_AxisRef.Axis1Ref,// 当前NC轴引用
    stAxis          := GVL_AxisRuntime.Axis1// 当前轴命令、参数和反馈接口
);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>