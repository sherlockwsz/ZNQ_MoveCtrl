<?xml version='1.0' encoding='utf-8'?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_GripperControl" Id="{8e3568c7-5d0a-4f76-b3af-00ac6d89a6e2}" SpecialFunc="None">
    <Declaration>FUNCTION_BLOCK FB_GripperControl
VAR_INPUT
    bEnableComm : BOOL; // TRUE：打开并轮询本实例的COM口
	bStopRequested : BOOL; // MAIN发来的整机停止请求
END_VAR

VAR_IN_OUT
    ioGripper : ST_GripperInterface; // 一台电机对应一个完整接口
END_VAR

VAR
    fbSerialPort   : FB_SerialPort;
    fbProtocol     : FB_GripperProtocol;
    stSerialConfig : ST_SerialConfig;
    fbPollInterval : TON;
    fbFeedbackTimeout : TON; // 有效反馈看门狗；单帧错误只丢弃
	// 0=选请求；10=发送；20=等回复；90=通信错误
	eStep : E_GripperCommStep := E_GripperCommStep.SelectRequest;

    nPollKind      : INT := 1;   // 1=位置；2=电流；3=故障
    nActiveKind    : INT;        // 当前正在等待的请求种类

    nExpectedLen   : UINT;
    bPortConfigOk  : BOOL;
	bSerialFrameComplete : BOOL;
	bSerialAbortTransaction : BOOL;
	eProtocolResult : E_GripperProtocolResult;
	bProtocolBuildOk : BOOL;
		
	// 下标与 nActiveKind 一致：1=位置，2=电流，3=电机故障码。
	// 0 表示该项没有尚未恢复的 Modbus 异常。
	aModbusException : ARRAY[1..3] OF BYTE;
	
	fbMoveTimeout  : TON;
	fbResetTimeout : TON;

	bWriteActive   : BOOL; // 当前等待的是写入回执，而非读取回执
	bInternalStop  : BOOL; // 运动超时/故障后的尽力停止，不对应新Cmd编号
	bStopPending   : BOOL;
	bMoveActive    : BOOL; // 目标已发送，正在等待实际位置/电流确认
	bResetActive   : BOOL; // 复位写回执已确认，等待0x603F实际清零
	
	bCmdInitialized : BOOL;
	bStopSignalSeen : BOOL; // 用于识别本次停止请求的上升沿
	udiLastSeenId    : UDINT; // 防止同一编号每周期重复发送
	udiActiveId      : UDINT; // 已锁存的本次命令编号
	eActiveCommand   : E_GripperCommand;
	diActiveTarget   : DINT;  // 命令受理时锁存目标，执行中修改Set不影响本次
	
	udRejectCode     : UDINT;
	liPositionError  : LINT;
	
	
	
	uiLastCommErrorReason : UINT;
    udiReplyTimeoutCount  : UDINT;
    udiBadFrameCount      : UDINT;
    udiCrcErrorCount      : UDINT;
    udiReplyMismatchCount : UDINT;
	
	uiConsecutiveCommErrors : UINT;
	bValidFramePulse         : BOOL;  // 成功解析位置/电流/故障反馈时置位一周期
	udiDiscardedFrameCount   : UDINT; // 被丢弃的超时、坏帧或不匹配回复数量
END_VAR</Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================
// 1. 映射现有唯一参数源，并周期调用公共串口层
// =============================================================
stSerialConfig.stPortConfig := ioGripper.Port;
stSerialConfig.tAdsTimeout := GVL_CommunicationConfig.stGripper.tAdsTimeout;
stSerialConfig.tReplyTimeout := ioGripper.Set.tReplyTimeout;

fbSerialPort(
    bEnable := bEnableComm,
    stConfig := stSerialConfig,
    aTxBuffer := fbProtocol.aTxBuffer,
    uiTxLength := fbProtocol.uiTxLength,
    bSend := (eStep = E_GripperCommStep.SendRequest),
    bAbortTransaction := bSerialAbortTransaction,
    bRxFrameComplete := bSerialFrameComplete,
    bCheckCrc16 := TRUE
);
bSerialAbortTransaction := FALSE;
bSerialFrameComplete := FALSE;

bPortConfigOk :=
    fbSerialPort.Runtime.bConfigValid
    AND (ioGripper.Set.nStationId >= 1)
    AND (ioGripper.Set.nStationId <= 247);

fbPollInterval(
    IN := (eStep = E_GripperCommStep.SelectRequest),
    PT := GVL_CommunicationConfig.stGripper.tPollInterval
);

fbMoveTimeout(
    IN := bMoveActive,
    PT := ioGripper.Set.tMoveTimeout
);

fbResetTimeout(
    IN := bResetActive,
    PT := ioGripper.Set.tMoveTimeout
);

// 通信健康只依据“最近是否收到过有效反馈数据”。
// bValidFramePulse由上一扫描的成功解析结果保持到本扫描，用于复位TON；
// 随后清FALSE，当前扫描若再次成功解析会在报文处理处重新置TRUE。
fbFeedbackTimeout(
    IN := bEnableComm
          AND bPortConfigOk
          AND fbSerialPort.Runtime.bPortOpened
          AND NOT bValidFramePulse,
    PT := ioGripper.Set.tFeedbackTimeout
);
bValidFramePulse := FALSE;

// 第一次扫描仅记住已有编号，防止PLC重启后重发旧命令。
IF NOT bCmdInitialized THEN
    udiLastSeenId := ioGripper.Cmd.udiRequestId;
    bCmdInitialized := TRUE;
END_IF;
// 整机停止只入队一次；当前串口事务结束后，优先发送Stop。
// 停止请求到来时，取消原Open/Close的完成判定。
// Stop报文仍由bStopPending排队，在当前串口事务结束后发送。
IF bStopRequested AND NOT bStopSignalSeen THEN
    bStopPending := TRUE;
    ioGripper.Feedback.bStopAcknowledged := FALSE;
    ioGripper.Feedback.bStopError := FALSE;
    ioGripper.Feedback.udStopErrorCode := TO_UDINT(E_GripperErrorCode.None);

    IF bMoveActive OR bResetActive
        OR (bWriteActive
            AND ((eActiveCommand = E_GripperCommand.Open)
              OR (eActiveCommand = E_GripperCommand.Close)
              OR (eActiveCommand = E_GripperCommand.ResetFault))) THEN

        bMoveActive := FALSE;
        bResetActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.bOpen := FALSE;
        ioGripper.Feedback.bClosed := FALSE;
        ioGripper.Feedback.bPositionReached := FALSE;
        ioGripper.Feedback.bCurrentReached := FALSE;
        ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.InterruptedByMachineStop); // 动作被整机停止中断
    END_IF;
END_IF;
bStopSignalSeen := bStopRequested;

// 停止期间消费新Cmd编号，避免停止解除后执行积压的Open/Close。
// 此期间的人工Stop也由上面的内部Stop请求代为执行。
IF bStopRequested
    AND (ioGripper.Cmd.udiRequestId <> udiLastSeenId) THEN
    udiLastSeenId := ioGripper.Cmd.udiRequestId;
	ioGripper.Feedback.udiRejectedId := ioGripper.Cmd.udiRequestId;
    ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.MachineStopping); // 整机停止中，拒绝新命令
END_IF;
// 未启用或串口未打开时，不发布“在线”与有效实时数据。
IF NOT bEnableComm OR NOT bPortConfigOk OR NOT fbSerialPort.Runtime.bPortOpened THEN
    ioGripper.Feedback.bOnline := FALSE;
	M_InvalidateFeedback(stFeedback := ioGripper.Feedback);
    IF fbSerialPort.Runtime.eError = E_SerialError.SerialBlockError THEN
        ioGripper.Feedback.bCommFault := TRUE;
        ioGripper.Feedback.udCommErrorCode := fbSerialPort.Runtime.udErrorId;
    END_IF;

    eStep := E_GripperCommStep.SelectRequest;
    nExpectedLen := 0;
	
	// 串口不可用时，本次动作不能宣告完成。
	// 重新连接后必须由上层递增编号，明确发起新命令。
	IF ioGripper.Feedback.bBusy THEN
		ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
	END_IF;
	
	ioGripper.Feedback.bBusy := FALSE;
	bWriteActive := FALSE;
	bMoveActive := FALSE;
	bResetActive := FALSE;
	bInternalStop := FALSE;
	
	// 命令不能静默消失；动作FB需要知道本次编号未受理。
	IF ioGripper.Cmd.udiRequestId <> udiLastSeenId THEN
    ioGripper.Feedback.udiRejectedId := ioGripper.Cmd.udiRequestId;
    ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
	END_IF;
	
	udiLastSeenId := ioGripper.Cmd.udiRequestId;
    RETURN;
END_IF;

// 公共层统一发布打开、发送、接收、超时和CRC异常。
IF fbSerialPort.Runtime.bTransactionError THEN
    CASE fbSerialPort.Runtime.eError OF
        E_SerialError.SerialBlockError:
            uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.SerialBlockError);
        E_SerialError.SendError:
            uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.SendError);
        E_SerialError.ReplyTimeout:
            uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.ReplyTimeout);
            udiReplyTimeoutCount := udiReplyTimeoutCount + 1;
        E_SerialError.CrcMismatch:
            uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.CrcMismatch);
            udiCrcErrorCount := udiCrcErrorCount + 1;
        ELSE
            uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.BadFrameOrReceiveError);
            udiBadFrameCount := udiBadFrameCount + 1;
    END_CASE;
    eStep := E_GripperCommStep.CommError;
END_IF;

// 帧边界属于夹爪Modbus协议；公共串口层只累计原始接收字节。
IF (eStep = E_GripperCommStep.WaitReply)
    AND fbSerialPort.Runtime.bNewData THEN
    nExpectedLen := fbProtocol.M_GetExpectedReplyLength(
        aRxBuffer := fbSerialPort.aRxBuffer,
        uiRxLength := fbSerialPort.Runtime.uiRxLength
    );

    IF (nExpectedLen > 32)
        OR ((nExpectedLen <> 0)
            AND (fbSerialPort.Runtime.uiRxLength > nExpectedLen)) THEN
        uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.BadFrameOrReceiveError);
        udiBadFrameCount := udiBadFrameCount + 1;
        eStep := E_GripperCommStep.CommError;
    ELSIF (nExpectedLen <> 0)
        AND (fbSerialPort.Runtime.uiRxLength = nExpectedLen) THEN
        bSerialFrameComplete := TRUE;
    END_IF;
END_IF;

// =============================================================
// 3. 一次只发送一个请求，收到回复或超时后才进入下一项
// =============================================================
CASE eStep OF
    E_GripperCommStep.SelectRequest: // 写命令优先；无新命令才轮询读取
    IF bStopPending THEN
        // 故障/超时后的尽力停止。不修改用户命令编号。
        bStopPending := FALSE;
        bInternalStop := TRUE;
        bWriteActive := TRUE;
        eActiveCommand := E_GripperCommand.Stop;

    ELSIF ioGripper.Cmd.udiRequestId <> udiLastSeenId THEN
        // 编号是一次性触发器；先消费编号，再检查是否准许执行。
        udiLastSeenId := ioGripper.Cmd.udiRequestId;
        udRejectCode := TO_UDINT(E_GripperErrorCode.None);

        CASE ioGripper.Cmd.eCommand OF
            E_GripperCommand.Open,
            E_GripperCommand.Close:
                IF ioGripper.Feedback.bBusy THEN
                    udRejectCode := TO_UDINT(E_GripperErrorCode.Busy);
                ELSIF NOT ioGripper.Set.bParametersVerified
                    OR (ioGripper.Set.diPositionTolerance < 0)
                    OR (ioGripper.Set.tFeedbackTimeout <= T#0MS)
                    OR (ioGripper.Set.tMoveTimeout <= T#0MS) THEN
                    udRejectCode := TO_UDINT(E_GripperErrorCode.InvalidParameters);
                ELSIF NOT ioGripper.Feedback.bOnline
                    OR ioGripper.Feedback.bCommFault
                    OR NOT ioGripper.Feedback.bPositionValid
                    OR NOT ioGripper.Feedback.bFaultCodeValid
                    OR ioGripper.Feedback.bFault THEN
                    udRejectCode := TO_UDINT(E_GripperErrorCode.NotReady);
                ELSIF (ioGripper.Cmd.eCommand = E_GripperCommand.Close)
                    AND ((ioGripper.Set.uiCloseCurrentMin = 0)
                         OR NOT ioGripper.Feedback.bCurrentValid) THEN
                    udRejectCode := TO_UDINT(E_GripperErrorCode.CloseCurrentInvalid);
                END_IF;

            E_GripperCommand.Stop:
                // Stop可中断正在判定的动作；但仍须串口已打开。
                udRejectCode := TO_UDINT(E_GripperErrorCode.None);

            E_GripperCommand.ResetFault:
                IF ioGripper.Feedback.bBusy THEN
                    udRejectCode := TO_UDINT(E_GripperErrorCode.Busy);
                ELSIF NOT ioGripper.Feedback.bOnline THEN
                    udRejectCode := TO_UDINT(E_GripperErrorCode.NotReady);
                END_IF;

            E_GripperCommand.None:
                udRejectCode := TO_UDINT(E_GripperErrorCode.InvalidCommand);

        ELSE
            udRejectCode := TO_UDINT(E_GripperErrorCode.InvalidCommand);
        END_CASE;

        IF udRejectCode <> TO_UDINT(E_GripperErrorCode.None) THEN
			ioGripper.Feedback.udiRejectedId := ioGripper.Cmd.udiRequestId;
            // 未受理：AcceptedId不变。在线调试时检查此错误码。
            ioGripper.Feedback.udCommandErrorCode := udRejectCode;
        ELSE
            bInternalStop := FALSE;
            bWriteActive := TRUE;
            eActiveCommand := ioGripper.Cmd.eCommand;
            udiActiveId := ioGripper.Cmd.udiRequestId;

            // Set的目标在受理时锁存，防止发送过程中在线修改。
            IF eActiveCommand = E_GripperCommand.Open THEN
                diActiveTarget := ioGripper.Set.diOpenPosition;
            ELSIF eActiveCommand = E_GripperCommand.Close THEN
                diActiveTarget := ioGripper.Set.diClosePosition;
            END_IF;

            IF eActiveCommand = E_GripperCommand.Stop THEN
                // 原Open/Close不再可能报完成。
                bMoveActive := FALSE;
                ioGripper.Feedback.bOpen := FALSE;
                ioGripper.Feedback.bClosed := FALSE;
            END_IF;

            ioGripper.Feedback.bBusy := TRUE;
            ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.None);
            ioGripper.Feedback.udiAcceptedId := udiActiveId;
        END_IF;
    END_IF;

    IF bWriteActive THEN
        bProtocolBuildOk := fbProtocol.M_BuildCommand(
            nStationId := ioGripper.Set.nStationId,
            eCommand := eActiveCommand,
            diTarget := diActiveTarget
        );
        nExpectedLen := 0;
        IF bProtocolBuildOk THEN
            eStep := E_GripperCommStep.SendRequest;
        ELSE
            uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.SendError);
            eStep := E_GripperCommStep.CommError;
        END_IF;

    ELSIF fbPollInterval.Q THEN
        nActiveKind := nPollKind;
        bProtocolBuildOk := fbProtocol.M_BuildPoll(
            nStationId := ioGripper.Set.nStationId,
            nPollKind := nActiveKind
        );
        nExpectedLen := 0;
        IF bProtocolBuildOk THEN
            eStep := E_GripperCommStep.SendRequest;
        ELSE
            uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.SendError);
            eStep := E_GripperCommStep.CommError;
        END_IF;

        nPollKind := nPollKind + 1;
        IF nPollKind > 3 THEN nPollKind := 1; 
		END_IF;
    END_IF;

	E_GripperCommStep.SendRequest:
		IF fbSerialPort.Runtime.bSendDone THEN
			eStep := E_GripperCommStep.WaitReply;
		END_IF;
    E_GripperCommStep.WaitReply: // 等待并校验当前请求的完整应答
		IF fbSerialPort.Runtime.bFrameReady THEN
			eProtocolResult := fbProtocol.M_ParseReply(
				nStationId := ioGripper.Set.nStationId,
				bWrite := bWriteActive,
				nActiveKind := nActiveKind,
				aRxBuffer := fbSerialPort.aRxBuffer,
				uiRxLength := fbSerialPort.Runtime.uiRxLength
			);

			IF eProtocolResult = E_GripperProtocolResult.StationMismatch THEN
				// 返回帧站号不是当前夹爪
				uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.StationMismatch);
				udiReplyMismatchCount := udiReplyMismatchCount + 1;
				eStep := E_GripperCommStep.CommError;

			ELSIF bWriteActive THEN
			// 写请求不能走读取分支，否则会误用
			// aModbusException[nActiveKind]。
			IF eProtocolResult = E_GripperProtocolResult.ModbusException THEN
			    // 已收到完整有效的Modbus异常回复，通信链路正常。
				uiConsecutiveCommErrors := 0;
				// 从站明确拒绝写请求：保留协议异常用于诊断，
				// 但不把一次Modbus异常升级为通信离线。
				ioGripper.Feedback.udCommErrorCode :=
					TO_UDINT(E_GripperErrorCode.ModbusExceptionBase) + BYTE_TO_UDINT(fbProtocol.byExceptionCode);
		
				IF NOT bInternalStop THEN
					ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
					ioGripper.Feedback.bBusy := FALSE;
				ELSE
					ioGripper.Feedback.bStopError := TRUE;
					ioGripper.Feedback.udStopErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
				END_IF;
		
				bMoveActive := FALSE;
				bWriteActive := FALSE;
				bInternalStop := FALSE;
				eStep := E_GripperCommStep.SelectRequest;
		
			ELSIF eProtocolResult = E_GripperProtocolResult.WriteAcknowledged THEN
		
				// 10回执核对地址及数量；06回执核对地址及写入值。
				// 写回执不是位置/电流/故障反馈，因此不用于刷新在线看门狗。
				uiConsecutiveCommErrors := 0;
		
				CASE eActiveCommand OF
					E_GripperCommand.Open,
					E_GripperCommand.Close:
				
						IF bStopPending OR bStopRequested THEN
							// 写命令可能已经被夹爪接收，
							// 但整机已经请求停止，不能继续进行到位判断。
							bMoveActive := FALSE;
							ioGripper.Feedback.bBusy := FALSE;
				
							ioGripper.Feedback.bOpen := FALSE;
							ioGripper.Feedback.bClosed := FALSE;
							ioGripper.Feedback.bPositionReached := FALSE;
							ioGripper.Feedback.bCurrentReached := FALSE;
				
							ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.InterruptedByMachineStop);
				
						ELSE
							// 写命令回执正常，开始监视实际位置和电流。
							bMoveActive := TRUE;
				
							// 新动作开始，清除上一次动作的完成判断。
							ioGripper.Feedback.bOpen := FALSE;
							ioGripper.Feedback.bClosed := FALSE;
							ioGripper.Feedback.bPositionReached := FALSE;
							ioGripper.Feedback.bCurrentReached := FALSE;
				
							(*
								这里不能调用 M_InvalidateFeedback。
				
								写入目标位置后，串口仍然在线，
								原有位置、电流、故障反馈仍是上一轮成功读取的数据。
								下一轮03轮询会自动更新这些数据。
				
								如果清除三个Valid，Manager会把夹爪判定为不健康，
								从而触发整机停止。
							*)
						END_IF;
		
					E_GripperCommand.Stop:
						IF bInternalStop THEN
							// 整机停止链路只接受有效Stop回执作为确认。
							ioGripper.Feedback.bStopAcknowledged := TRUE;
							ioGripper.Feedback.bStopError := FALSE;
							ioGripper.Feedback.udStopErrorCode := TO_UDINT(E_GripperErrorCode.None);
						ELSE
							// 仅表示停止写命令已得到回执；
							// 没有速度反馈，不能证明机械已完全停止。
							ioGripper.Feedback.bBusy := FALSE;
							ioGripper.Feedback.udiCompletedId := udiActiveId;
						END_IF;
		
					E_GripperCommand.ResetFault:
						// 回执仅表示复位写入成功；继续保持Busy，
						// 直到随后0x603F有效读回且故障码真正清零。
						ioGripper.Feedback.bFaultCodeValid := FALSE;
						bResetActive := TRUE;
				END_CASE;
		
				bWriteActive := FALSE;
				bInternalStop := FALSE;
				eStep := E_GripperCommStep.SelectRequest;
		
			ELSE
                (*
                    写回执与本次请求不一致。

                    可能包括：
                    1. 回复功能码不是06或10；
                    2. 回复寄存器地址与请求不一致；
                    3. 10功能码回复的寄存器数量不一致；
                    4. 06功能码回复的写入值不一致；
                    5. 收到了上一笔事务迟到的回复。
                *)
                uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.WriteReplyMismatch);

                IF udiReplyMismatchCount < UDINT#4294967295 THEN
                    udiReplyMismatchCount :=
                        udiReplyMismatchCount + 1;
                END_IF;

                eStep := E_GripperCommStep.CommError;
			END_IF;
		
		ELSIF eProtocolResult = E_GripperProtocolResult.ModbusException THEN
			    // 已收到完整有效的Modbus异常回复，链路没有中断。
				uiConsecutiveCommErrors := 0;
				// CRC 和站号已校验：电机在线，但拒绝了本项读取。
				// 这是协议异常，不是 0x603F 所表示的电机故障。
				aModbusException[nActiveKind] := fbProtocol.byExceptionCode;
				// 单项读取异常只使该项数据无效，不立即改变整机通信健康状态。
				ioGripper.Feedback.udCommErrorCode :=
					TO_UDINT(E_GripperErrorCode.ModbusExceptionBase) + BYTE_TO_UDINT(fbProtocol.byExceptionCode);
			
				// 单次异常不清除上一轮有效值，避免bHealthy瞬间变FALSE导致停机。
				// 若持续没有任何有效反馈，统一由3秒在线看门狗清除全部有效位。
				// 不修改bFault或udFaultCode；它们只能由成功读取0x603F更新。
				eStep := E_GripperCommStep.SelectRequest;
			ELSIF eProtocolResult = E_GripperProtocolResult.UnexpectedFunctionCode THEN
				(*
					当前发送的是03读取请求，
					但收到的既不是03正常回复，也不是83异常回复。
			
					常见原因是：
					1. 收到了上一笔06/10写事务的迟到回复；
					2. 串口接收缓冲区存在旧帧；
					3. 从站返回了错误的功能码。
				*)
				uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.UnexpectedFunctionCode);
			
				IF udiReplyMismatchCount < UDINT#4294967295 THEN
					udiReplyMismatchCount :=
						udiReplyMismatchCount + 1;
				END_IF;
			
				eStep := E_GripperCommStep.CommError;
            ELSE
				// 回复的数据字节数由协议层统一校验。
				IF eProtocolResult = E_GripperProtocolResult.InvalidByteCount THEN
					(*
						nActiveKind=1：位置，期望4字节；
						nActiveKind=2：电流，期望2字节；
						nActiveKind=3：故障码，期望4字节。
					*)
					uiLastCommErrorReason := TO_UINT(E_GripperCommErrorReason.InvalidByteCount);
				
					IF udiReplyMismatchCount < UDINT#4294967295 THEN
						udiReplyMismatchCount :=
							udiReplyMismatchCount + 1;
					END_IF;
				
					eStep := E_GripperCommStep.CommError;
				
				ELSE
					CASE eProtocolResult OF
						E_GripperProtocolResult.PositionData:
							ioGripper.Feedback.diActualPosition := fbProtocol.diPosition;
							ioGripper.Feedback.bPositionValid := TRUE;

						E_GripperProtocolResult.CurrentData:
							ioGripper.Feedback.iActualCurrent := fbProtocol.iCurrent;
							ioGripper.Feedback.bCurrentValid := TRUE;

						E_GripperProtocolResult.FaultData:
							ioGripper.Feedback.udFaultCode := fbProtocol.udFaultCode;
							ioGripper.Feedback.bFault := (fbProtocol.udFaultCode <> 0);
							ioGripper.Feedback.bFaultCodeValid := TRUE;
					END_CASE;
					
					// 只有“先前报异常的同一项”成功读回，才清除该项异常。
					aModbusException[nActiveKind] := 0;
					
					ioGripper.Feedback.bOnline := TRUE;
					ioGripper.Feedback.bCommFault := FALSE;
					ioGripper.Feedback.udCommErrorCode := TO_UDINT(E_GripperErrorCode.None);
					uiConsecutiveCommErrors := 0;
					bValidFramePulse := TRUE;
					
					eStep := E_GripperCommStep.SelectRequest;
                END_IF;
            END_IF;
        END_IF;

		E_GripperCommStep.CommError:
			bSerialAbortTransaction := TRUE;

			// 单次超时、坏帧、CRC、站号或回执不匹配只记录并丢弃。
			// 是否真正失联由fbFeedbackTimeout统一判断，避免偶发串口抖动停机。
			IF uiConsecutiveCommErrors < UINT#65535 THEN
				uiConsecutiveCommErrors := uiConsecutiveCommErrors + 1;
			END_IF;
			IF udiDiscardedFrameCount < UDINT#4294967295 THEN
				udiDiscardedFrameCount := udiDiscardedFrameCount + 1;
			END_IF;

			IF (fbSerialPort.Runtime.eError = E_SerialError.SerialBlockError)
				AND (fbSerialPort.Runtime.udErrorId <> 0) THEN
				ioGripper.Feedback.udCommErrorCode := fbSerialPort.Runtime.udErrorId;
			ELSE
				ioGripper.Feedback.udCommErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnknown);
			END_IF;

			nExpectedLen := 0;

			IF bWriteActive THEN
				CASE eActiveCommand OF
					E_GripperCommand.Open,
					E_GripperCommand.Close:
						IF (uiLastCommErrorReason = TO_UINT(E_GripperCommErrorReason.SendError))
							OR (uiLastCommErrorReason = TO_UINT(E_GripperCommErrorReason.SerialBlockError)) THEN
							// SendData或串口底层明确报错时，不能认为命令已送达。
							ioGripper.Feedback.bBusy := FALSE;
							ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
							bMoveActive := FALSE;
						ELSE
							// 写回复超时或不匹配时不重发目标；设备可能已经收到命令。
							// 转为轮询实际位置/电流，由动作超时给出最终结果。
							bMoveActive := TRUE;
							ioGripper.Feedback.bPositionReached := FALSE;
							ioGripper.Feedback.bCurrentReached := FALSE;
						END_IF;

					E_GripperCommand.Stop:
						// Stop仍要求有效回执，不能仅凭收到任意数据确认停止。
						IF bInternalStop THEN
							ioGripper.Feedback.bStopAcknowledged := FALSE;
							ioGripper.Feedback.bStopError := TRUE;
							ioGripper.Feedback.udStopErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
						ELSE
							ioGripper.Feedback.bBusy := FALSE;
							ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
						END_IF;

					E_GripperCommand.ResetFault:
						IF (uiLastCommErrorReason = TO_UINT(E_GripperCommErrorReason.SendError))
							OR (uiLastCommErrorReason = TO_UINT(E_GripperCommErrorReason.SerialBlockError)) THEN
							ioGripper.Feedback.bBusy := FALSE;
							ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
							bResetActive := FALSE;
						ELSE
							// 复位回执丢失时继续轮询0x603F确认是否真正清零。
							bResetActive := TRUE;
						END_IF;

					ELSE
						ioGripper.Feedback.bBusy := FALSE;
						ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
				END_CASE;

				bWriteActive := FALSE;
				bInternalStop := FALSE;
			END_IF;

			eStep := E_GripperCommStep.SelectRequest;
END_CASE;

// 只有持续收不到任何有效位置/电流/故障反馈，才发布通信离线。
// 偶发的超时、坏帧、CRC或不匹配回复不会进入这里。
IF bValidFramePulse THEN
    ioGripper.Feedback.bOnline := TRUE;
    ioGripper.Feedback.bCommFault := FALSE;
    ioGripper.Feedback.udCommErrorCode := TO_UDINT(E_GripperErrorCode.None);
ELSIF fbFeedbackTimeout.Q THEN
    ioGripper.Feedback.bOnline := FALSE;
    ioGripper.Feedback.bCommFault := TRUE;
    ioGripper.Feedback.udCommErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
    M_InvalidateFeedback(stFeedback := ioGripper.Feedback);
END_IF;

IF bMoveActive THEN
    IF NOT ioGripper.Feedback.bOnline
        OR ioGripper.Feedback.bCommFault THEN

        bMoveActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
        bStopPending := fbSerialPort.Runtime.bPortOpened;

    ELSIF ioGripper.Feedback.bFaultCodeValid
        AND ioGripper.Feedback.bFault THEN

        bMoveActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.DeviceFaultOrResetTimeout);
        bStopPending := fbSerialPort.Runtime.bPortOpened;

    ELSIF fbMoveTimeout.Q THEN
        bMoveActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.MotionTimeout);
        bStopPending := fbSerialPort.Runtime.bPortOpened;

    ELSIF ioGripper.Feedback.bFaultCodeValid
        AND ioGripper.Feedback.bPositionValid THEN

        // 用LINT计算差值，避免32位位置相减溢出。
        liPositionError :=
            DINT_TO_LINT(ioGripper.Feedback.diActualPosition)
            - DINT_TO_LINT(diActiveTarget);
        IF liPositionError < 0 THEN
            liPositionError := -liPositionError;
        END_IF;

        ioGripper.Feedback.bPositionReached :=
            liPositionError
            <= DINT_TO_LINT(ioGripper.Set.diPositionTolerance);

        ioGripper.Feedback.bCurrentReached := FALSE;
        IF ioGripper.Feedback.bCurrentValid THEN
            // 先转DINT，避免INT最小值取绝对值时溢出。
            ioGripper.Feedback.bCurrentReached :=
                ABS(INT_TO_DINT(ioGripper.Feedback.iActualCurrent))
                >= UINT_TO_DINT(ioGripper.Set.uiCloseCurrentMin);
        END_IF;

        IF ioGripper.Feedback.bPositionReached
            AND NOT ioGripper.Feedback.bFault THEN

            CASE eActiveCommand OF
                E_GripperCommand.Open:
                    ioGripper.Feedback.bOpen := TRUE;
                    ioGripper.Feedback.bClosed := FALSE;
                    ioGripper.Feedback.bBusy := FALSE;
                    ioGripper.Feedback.udiCompletedId := udiActiveId;
                    bMoveActive := FALSE;

                E_GripperCommand.Close:
                    // 夹紧必须同时满足位置及实际电流阈值。
                    IF ioGripper.Feedback.bCurrentReached THEN
                        ioGripper.Feedback.bClosed := TRUE;
                        ioGripper.Feedback.bOpen := FALSE;
                        ioGripper.Feedback.bBusy := FALSE;
                        ioGripper.Feedback.udiCompletedId := udiActiveId;
                        bMoveActive := FALSE;
                    END_IF;
            END_CASE;
        END_IF;
    END_IF;
END_IF;

// 故障复位必须由0x603F的有效反馈确认，不能把写回执当作复位完成。
IF bResetActive THEN
    IF NOT ioGripper.Feedback.bOnline
        OR ioGripper.Feedback.bCommFault THEN
        bResetActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.CommunicationUnavailable);
    ELSIF fbResetTimeout.Q THEN
        bResetActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.DeviceFaultOrResetTimeout);
    ELSIF ioGripper.Feedback.bFaultCodeValid
        AND NOT ioGripper.Feedback.bFault THEN
        bResetActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.udCommandErrorCode := TO_UDINT(E_GripperErrorCode.None);
        ioGripper.Feedback.udiCompletedId := udiActiveId;
    END_IF;
END_IF;]]></ST>
    </Implementation>
    <Method Name="M_InvalidateFeedback" Id="{fc8c9ecb-5ea8-49b5-9258-c3192a7570f8}">
      <Declaration>METHOD PRIVATE M_InvalidateFeedback
VAR_IN_OUT
    stFeedback : ST_GripperFeedback;
END_VAR</Declaration>
      <Implementation>
        <ST>stFeedback.bPositionValid := FALSE;
stFeedback.bCurrentValid := FALSE;
stFeedback.bFaultCodeValid := FALSE;
stFeedback.bOpen := FALSE;
stFeedback.bClosed := FALSE;
stFeedback.bPositionReached := FALSE;
stFeedback.bCurrentReached := FALSE;</ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
