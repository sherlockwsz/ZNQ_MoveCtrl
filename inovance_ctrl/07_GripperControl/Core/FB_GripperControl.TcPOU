<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_GripperControl" Id="{8e3568c7-5d0a-4f76-b3af-00ac6d89a6e2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GripperControl
VAR_INPUT
    bEnableComm : BOOL; // TRUE：打开并轮询本实例的COM口
	bStopRequested : BOOL; // MAIN发来的整机停止请求
END_VAR

VAR_IN_OUT
    ioGripper : ST_GripperInterface; // 一台电机对应一个完整接口
END_VAR

VAR
    fbSerial       : SerialLineControlADS;
    fbSend         : SendData;
    fbReceiveByte  : ReceiveByte;
    fbReplyTimeout : TON;
    fbPollInterval : TON;

    stTxBuffer     : ComBuffer;
    stRxBuffer     : ComBuffer;

	aTx            : ARRAY[0..12] OF BYTE; // 10写两个寄存器：最长13字节
    aRx            : ARRAY[0..31] OF BYTE; // 保留异常帧及扩展余量
	// 0=选请求；10=发送；20=等回复；90=通信错误
	eStep : E_GripperCommStep := E_GripperCommStep.SelectRequest;

    nPollKind      : INT := 1;   // 1=位置；2=电流；3=故障
    nActiveKind    : INT;        // 当前正在等待的请求种类

    nRxLength      : UINT;
    nExpectedLen   : UINT;
    nIndex         : INT;
    wCrc           : WORD;
    wRxCrc         : WORD;
    dwValue        : DWORD;
    wCurrentRaw    : WORD;
    bBadFrame      : BOOL;
    bPortConfigOk  : BOOL;
		
	// 下标与 nActiveKind 一致：1=位置，2=电流，3=电机故障码。
	// 0 表示该项没有尚未恢复的 Modbus 异常。
	aModbusException : ARRAY[1..3] OF BYTE;
	nErrorKind       : INT;
	
	fbMoveTimeout  : TON;

	nTxLength      : UINT; // 当前请求实际长度：读取/06写=8；10写=13
	bWriteActive   : BOOL; // 当前等待的是写入回执，而非读取回执
	bInternalStop  : BOOL; // 运动超时/故障后的尽力停止，不对应新Cmd编号
	bStopPending   : BOOL;
	bMoveActive    : BOOL; // 写入回执已确认，正在等待实际到位
	
	bCmdInitialized : BOOL;
	bStopSignalSeen : BOOL; // 用于识别本次停止请求的上升沿
	udiLastSeenId    : UDINT; // 防止同一编号每周期重复发送
	udiActiveId      : UDINT; // 已锁存的本次命令编号
	eActiveCommand   : E_GripperCommand;
	diActiveTarget   : DINT;  // 命令受理时锁存目标，执行中修改Set不影响本次
	dwTarget         : DWORD;
	
	udRejectCode     : UDINT;
	liPositionError  : LINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// =============================================================
// 1. 检查基本配置，并周期调用TF6340串口功能块
// =============================================================
bPortConfigOk :=
    (ioGripper.Port.ComPort >= 1)
    AND (ioGripper.Port.ComPort <= 255)
    AND (ioGripper.Set.nStationId >= 1)
    AND (ioGripper.Set.nStationId <= 247);

fbSerial(
    Connect   := bEnableComm AND bPortConfigOk,
    SerialCfg := ioGripper.Port,
    NetId     := '',
    Timeout   := T#2S, // ADS操作超时；不同于电机报文应答超时
    TxBuffer  := stTxBuffer,
    RxBuffer  := stRxBuffer
);

fbReplyTimeout(
    IN := (eStep = E_GripperCommStep.WaitReply),
    PT := ioGripper.Set.tReplyTimeout
);

fbPollInterval(
    IN := (eStep = E_GripperCommStep.SelectRequest),
    PT := T#50MS
);

fbMoveTimeout(
    IN := bMoveActive,
    PT := ioGripper.Set.tMoveTimeout
);

// 第一次扫描仅记住已有编号，防止PLC重启后重发旧命令。
IF NOT bCmdInitialized THEN
    udiLastSeenId := ioGripper.Cmd.udiRequestId;
    bCmdInitialized := TRUE;
END_IF;
// 整机停止只入队一次；当前串口事务结束后，优先发送Stop。
// 停止请求到来时，取消原Open/Close的完成判定。
// Stop报文仍由bStopPending排队，在当前串口事务结束后发送。
IF bStopRequested AND NOT bStopSignalSeen THEN
    bStopPending := TRUE;

    IF bMoveActive
        OR (bWriteActive
            AND ((eActiveCommand = E_GripperCommand.Open)
              OR (eActiveCommand = E_GripperCommand.Close))) THEN

        bMoveActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.bOpen := FALSE;
        ioGripper.Feedback.bClosed := FALSE;
        ioGripper.Feedback.bPositionReached := FALSE;
        ioGripper.Feedback.bCurrentReached := FALSE;
        ioGripper.Feedback.udCommandErrorCode := 16#2004; // 动作被整机停止中断
    END_IF;
END_IF;
bStopSignalSeen := bStopRequested;

// 停止期间消费新Cmd编号，避免停止解除后执行积压的Open/Close。
// 此期间的人工Stop也由上面的内部Stop请求代为执行。
IF bStopRequested
    AND (ioGripper.Cmd.udiRequestId <> udiLastSeenId) THEN
    udiLastSeenId := ioGripper.Cmd.udiRequestId;
	ioGripper.Feedback.udiRejectedId := ioGripper.Cmd.udiRequestId;
    ioGripper.Feedback.udCommandErrorCode := 6; // 整机停止中，拒绝新命令
END_IF;
// 未启用或串口未打开时，不发布“在线”与有效实时数据。
IF NOT bEnableComm OR NOT bPortConfigOk OR NOT fbSerial.PortOpened THEN
    ioGripper.Feedback.bOnline := FALSE;
	M_InvalidateFeedback(stFeedback := ioGripper.Feedback);
    IF fbSerial.Error THEN
        ioGripper.Feedback.bCommFault := TRUE;
        ioGripper.Feedback.udCommErrorCode := fbSerial.ErrorID;
    END_IF;

    eStep := E_GripperCommStep.SelectRequest;
    nRxLength := 0;
    nExpectedLen := 0;
	
	// 串口不可用时，本次动作不能宣告完成。
	// 重新连接后必须由上层递增编号，明确发起新命令。
	IF ioGripper.Feedback.bBusy THEN
		ioGripper.Feedback.udCommandErrorCode := 16#2003;
	END_IF;
	
	ioGripper.Feedback.bBusy := FALSE;
	bWriteActive := FALSE;
	bMoveActive := FALSE;
	bInternalStop := FALSE;
	
	// 命令不能静默消失；动作FB需要知道本次编号未受理。
	IF ioGripper.Cmd.udiRequestId <> udiLastSeenId THEN
    ioGripper.Feedback.udiRejectedId := ioGripper.Cmd.udiRequestId;
    ioGripper.Feedback.udCommandErrorCode := 16#2003;
	END_IF;
	
	udiLastSeenId := ioGripper.Cmd.udiRequestId;
    RETURN;
END_IF;

IF fbSerial.Error THEN
    ioGripper.Feedback.bCommFault := TRUE;
    ioGripper.Feedback.udCommErrorCode := fbSerial.ErrorID;
    eStep := E_GripperCommStep.CommError;
END_IF;

// =============================================================
// 2. 排空本周期已经收到的字节
// USB虚拟COM可能在一个PLC扫描周期送来一整帧，不能每扫描只取1字节。
// 只在等待应答状态组帧；其他状态丢弃迟到的旧数据。
// =============================================================
FOR nIndex := 0 TO 31 DO
    fbReceiveByte(RxBuffer := stRxBuffer);

    IF fbReceiveByte.Error <> 0 THEN
        bBadFrame := TRUE;
        EXIT;
    END_IF;

    IF NOT fbReceiveByte.ByteReceived THEN
        EXIT;
    END_IF;

    IF eStep = E_GripperCommStep.WaitReply THEN
        IF nRxLength >= 32 THEN
            bBadFrame := TRUE;
            EXIT;
        END_IF;

        aRx[nRxLength] := fbReceiveByte.ReceivedByte;
        nRxLength := nRxLength + 1;

        // Modbus异常应答：站号、功能码|80、异常码、CRC，共5字节。
        IF (nRxLength >= 2)
            AND (aRx[1] = 16#83) THEN
            nExpectedLen := 5;
        END_IF;

        // 功能码03正常应答：站号、03、字节数、数据、CRC。
        IF (nRxLength >= 3)
            AND (aRx[1] = 16#03) THEN
            nExpectedLen := BYTE_TO_UINT(aRx[2]) + 5;
        END_IF;

		// 06/10正常写入回执均为8字节。
		IF (nRxLength >= 2)
			AND ((aRx[1] = 16#06) OR (aRx[1] = 16#10)) THEN
			nExpectedLen := 8;
		END_IF;
		
		// 06/10的异常回复：功能码最高位置1，共5字节。
		IF (nRxLength >= 2)
			AND ((aRx[1] = 16#86) OR (aRx[1] = 16#90)) THEN
			nExpectedLen := 5;
		END_IF;

        IF (nExpectedLen > 32)
            OR ((nExpectedLen <> 0) AND (nRxLength > nExpectedLen)) THEN
            bBadFrame := TRUE;
            EXIT;
        END_IF;
    END_IF;
END_FOR;

// =============================================================
// 3. 一次只发送一个请求，收到回复或超时后才进入下一项
// =============================================================
CASE eStep OF
    E_GripperCommStep.SelectRequest: // 写命令优先；无新命令才轮询读取
    IF bStopPending THEN
        // 故障/超时后的尽力停止。不修改用户命令编号。
        bStopPending := FALSE;
        bInternalStop := TRUE;
        bWriteActive := TRUE;
        eActiveCommand := E_GripperCommand.Stop;

    ELSIF ioGripper.Cmd.udiRequestId <> udiLastSeenId THEN
        // 编号是一次性触发器；先消费编号，再检查是否准许执行。
        udiLastSeenId := ioGripper.Cmd.udiRequestId;
        udRejectCode := 0;

        CASE ioGripper.Cmd.eCommand OF
            E_GripperCommand.Open,
            E_GripperCommand.Close:
                IF ioGripper.Feedback.bBusy THEN
                    udRejectCode := 3;
                ELSIF NOT ioGripper.Set.bParametersVerified
                    OR (ioGripper.Set.diPositionTolerance < 0)
                    OR (ioGripper.Set.tMoveTimeout <= T#0MS) THEN
                    udRejectCode := 1;
                ELSIF NOT ioGripper.Feedback.bOnline
                    OR ioGripper.Feedback.bCommFault
                    OR NOT ioGripper.Feedback.bPositionValid
                    OR NOT ioGripper.Feedback.bCurrentValid
                    OR NOT ioGripper.Feedback.bFaultCodeValid
                    OR ioGripper.Feedback.bFault THEN
                    udRejectCode := 2;
                ELSIF (ioGripper.Cmd.eCommand = E_GripperCommand.Close)
                    AND (ioGripper.Set.uiCloseCurrentMin = 0) THEN
                    udRejectCode := 5;
                END_IF;

            E_GripperCommand.Stop:
                // Stop可中断正在判定的动作；但仍须串口已打开。
                udRejectCode := 0;

            E_GripperCommand.ResetFault:
                IF ioGripper.Feedback.bBusy THEN
                    udRejectCode := 3;
                ELSIF NOT ioGripper.Feedback.bOnline THEN
                    udRejectCode := 2;
                END_IF;

            E_GripperCommand.None:
                udRejectCode := 4;

        ELSE
            udRejectCode := 4;
        END_CASE;

        IF udRejectCode <> 0 THEN
			ioGripper.Feedback.udiRejectedId := ioGripper.Cmd.udiRequestId;
            // 未受理：AcceptedId不变。在线调试时检查此错误码。
            ioGripper.Feedback.udCommandErrorCode := udRejectCode;
        ELSE
            bInternalStop := FALSE;
            bWriteActive := TRUE;
            eActiveCommand := ioGripper.Cmd.eCommand;
            udiActiveId := ioGripper.Cmd.udiRequestId;

            // Set的目标在受理时锁存，防止发送过程中在线修改。
            IF eActiveCommand = E_GripperCommand.Open THEN
                diActiveTarget := ioGripper.Set.diOpenPosition;
            ELSIF eActiveCommand = E_GripperCommand.Close THEN
                diActiveTarget := ioGripper.Set.diClosePosition;
            END_IF;

            IF eActiveCommand = E_GripperCommand.Stop THEN
                // 原Open/Close不再可能报完成。
                bMoveActive := FALSE;
                ioGripper.Feedback.bOpen := FALSE;
                ioGripper.Feedback.bClosed := FALSE;
            END_IF;

            ioGripper.Feedback.bBusy := TRUE;
            ioGripper.Feedback.udCommandErrorCode := 0;
            ioGripper.Feedback.udiAcceptedId := udiActiveId;
        END_IF;
    END_IF;

    IF bWriteActive THEN
        aTx[0] := ioGripper.Set.nStationId;

        CASE eActiveCommand OF
            E_GripperCommand.Open,
            E_GripperCommand.Close:
                // 10 6101 0002 04 + 32位有符号目标位置
                aTx[1] := 16#10;
                aTx[2] := 16#61;
                aTx[3] := 16#01;
                aTx[4] := 16#00;
                aTx[5] := 16#02;
                aTx[6] := 16#04;

                dwTarget := DINT_TO_DWORD(diActiveTarget);
                aTx[7]  := DWORD_TO_BYTE(SHR(dwTarget, 24));
                aTx[8]  := DWORD_TO_BYTE(SHR(dwTarget, 16));
                aTx[9]  := DWORD_TO_BYTE(SHR(dwTarget, 8));
                aTx[10] := DWORD_TO_BYTE(dwTarget);
                nTxLength := 13;

            E_GripperCommand.Stop:
                // 06 6040 010F：停止运动
                aTx[1] := 16#06;
                aTx[2] := 16#60;
                aTx[3] := 16#40;
                aTx[4] := 16#01;
                aTx[5] := 16#0F;
                nTxLength := 8;

            E_GripperCommand.ResetFault:
                // 06 6040 0080：故障复位
                aTx[1] := 16#06;
                aTx[2] := 16#60;
                aTx[3] := 16#40;
                aTx[4] := 16#00;
                aTx[5] := 16#80;
                nTxLength := 8;
        END_CASE;

        wCrc := F_GripperModbusCrc16(
            pData := ADR(aTx),
            nLength := nTxLength - 2
        );
        aTx[nTxLength - 2] := WORD_TO_BYTE(wCrc);
        aTx[nTxLength - 1] := WORD_TO_BYTE(SHR(wCrc, 8));

        nRxLength := 0;
        nExpectedLen := 0;
        bBadFrame := FALSE;
        eStep := E_GripperCommStep.SendRequest;

    ELSIF fbPollInterval.Q THEN
        // 以下保持你原来的三项读取轮询，增加 nTxLength := 8。
        nActiveKind := nPollKind;
        aTx[0] := ioGripper.Set.nStationId;
        aTx[1] := 16#03;

        CASE nActiveKind OF
            1: // 0x6064：位置，两个寄存器
                aTx[2] := 16#60; aTx[3] := 16#64;
                aTx[4] := 16#00; aTx[5] := 16#02;
            2: // 0x6078：电流，一个寄存器
                aTx[2] := 16#60; aTx[3] := 16#78;
                aTx[4] := 16#00; aTx[5] := 16#01;
            3: // 0x603F：故障，两个寄存器
                aTx[2] := 16#60; aTx[3] := 16#3F;
                aTx[4] := 16#00; aTx[5] := 16#02;
        END_CASE;

        nTxLength := 8;
        wCrc := F_GripperModbusCrc16(
            pData := ADR(aTx),
            nLength := 6
        );
        aTx[6] := WORD_TO_BYTE(wCrc);
        aTx[7] := WORD_TO_BYTE(SHR(wCrc, 8));

        nRxLength := 0;
        nExpectedLen := 0;
        bBadFrame := FALSE;
        eStep := E_GripperCommStep.SendRequest;

        nPollKind := nPollKind + 1;
        IF nPollKind > 3 THEN nPollKind := 1; 
		END_IF;
    END_IF;

	E_GripperCommStep.SendRequest: // 使用当前帧长度；Busy期间不得修改aTx
		fbSend(
			pSendData := ADR(aTx),
			Length := UINT_TO_UDINT(nTxLength),
			TxBuffer := stTxBuffer
		);
	
		IF fbSend.Error <> 0 THEN
			eStep := E_GripperCommStep.CommError;
		ELSIF NOT fbSend.Busy THEN
			eStep := E_GripperCommStep.WaitReply;
		END_IF;

    E_GripperCommStep.WaitReply: // 等待并校验当前请求的完整应答
        IF bBadFrame OR fbReplyTimeout.Q THEN
            eStep := E_GripperCommStep.CommError;

        ELSIF (nExpectedLen <> 0) AND (nRxLength = nExpectedLen) THEN
            // 先核对站号和CRC。
            wCrc := F_GripperModbusCrc16(
                pData   := ADR(aRx),
                nLength := nRxLength - 2
            );

            wRxCrc :=
                BYTE_TO_WORD(aRx[nRxLength - 2])
                OR SHL(BYTE_TO_WORD(aRx[nRxLength - 1]), 8);

            IF (aRx[0] <> ioGripper.Set.nStationId)
                OR (wCrc <> wRxCrc) THEN
                eStep := E_GripperCommStep.CommError;


			ELSIF bWriteActive THEN
			// 写请求不能走读取分支，否则会误用
			// aModbusException[nActiveKind]。
			IF
				((aTx[1] = 16#10) AND (aRx[1] = 16#90))
				OR ((aTx[1] = 16#06) AND (aRx[1] = 16#86))
			THEN
				// 有效的Modbus异常回复，不属于0x603F电机故障。
				ioGripper.Feedback.bOnline := TRUE;
				ioGripper.Feedback.bCommFault := TRUE;
				ioGripper.Feedback.udCommErrorCode :=
					16#100 + BYTE_TO_UDINT(aRx[2]);
		
				IF NOT bInternalStop THEN
					ioGripper.Feedback.udCommandErrorCode := 16#2003;
					ioGripper.Feedback.bBusy := FALSE;
				END_IF;
		
				bMoveActive := FALSE;
				bWriteActive := FALSE;
				bInternalStop := FALSE;
				eStep := E_GripperCommStep.SelectRequest;
		
			ELSIF (nRxLength = 8)
				AND (aRx[1] = aTx[1])
				AND (aRx[2] = aTx[2])
				AND (aRx[3] = aTx[3])
				AND (aRx[4] = aTx[4])
				AND (aRx[5] = aTx[5]) THEN
		
				// 10回执核对地址及数量；06回执核对地址及写入值。
				// 注意：这是写入确认，不是位置到达确认。
				ioGripper.Feedback.bOnline := TRUE;
				ioGripper.Feedback.bCommFault := FALSE;
				ioGripper.Feedback.udCommErrorCode := 0;
		
				// 保留尚未被对应读取成功消除的旧协议异常。
				FOR nErrorKind := 1 TO 3 DO
					IF aModbusException[nErrorKind] <> 0 THEN
						ioGripper.Feedback.bCommFault := TRUE;
						ioGripper.Feedback.udCommErrorCode :=
							16#100
							+ BYTE_TO_UDINT(aModbusException[nErrorKind]);
						EXIT;
					END_IF;
				END_FOR;
		
				CASE eActiveCommand OF
					E_GripperCommand.Open,
					E_GripperCommand.Close:
						IF bStopPending OR bStopRequested THEN
							// 位置写入可能已被电机接收，但停止已请求；
							// 不得重新启动原动作的到位判定。
							bMoveActive := FALSE;
							ioGripper.Feedback.bBusy := FALSE;
							ioGripper.Feedback.bOpen := FALSE;
							ioGripper.Feedback.bClosed := FALSE;
							ioGripper.Feedback.bPositionReached := FALSE;
							ioGripper.Feedback.bCurrentReached := FALSE;
							ioGripper.Feedback.udCommandErrorCode := 16#2004;
						ELSE
							bMoveActive := TRUE;
							// 正常运动时，等待写入后的新轮询数据。
							M_InvalidateFeedback(stFeedback := ioGripper.Feedback);
						END_IF;
		
					E_GripperCommand.Stop:
						IF NOT bInternalStop THEN
							// 仅表示停止写命令已得到回执；
							// 没有速度反馈，不能证明机械已完全停止。
							ioGripper.Feedback.bBusy := FALSE;
							ioGripper.Feedback.udiCompletedId := udiActiveId;
						END_IF;
		
					E_GripperCommand.ResetFault:
						// 回执仅表示复位写入成功；是否真的复位
						// 仍须看随后0x603F的有效反馈。
						ioGripper.Feedback.bFaultCodeValid := FALSE;
						ioGripper.Feedback.bBusy := FALSE;
						ioGripper.Feedback.udiCompletedId := udiActiveId;
				END_CASE;
		
				bWriteActive := FALSE;
				bInternalStop := FALSE;
				eStep := E_GripperCommStep.SelectRequest;
		
			ELSE
				// 功能码或回显字段与本次请求不一致。
				eStep := E_GripperCommStep.CommError;
			END_IF;
		
		ELSIF aRx[1] = 16#83 THEN
				// CRC 和站号已校验：电机在线，但拒绝了本项读取。
				// 这是协议异常，不是 0x603F 所表示的电机故障。
				aModbusException[nActiveKind] := aRx[2];
			
				ioGripper.Feedback.bOnline := TRUE;
				ioGripper.Feedback.bCommFault := TRUE;
				ioGripper.Feedback.udCommErrorCode :=
					16#100 + BYTE_TO_UDINT(aRx[2]);
			
				// 本次没有取得对应的反馈，不能继续把旧值当成有效值。
				CASE nActiveKind OF
					1: ioGripper.Feedback.bPositionValid := FALSE;
					2: ioGripper.Feedback.bCurrentValid := FALSE;
					3: ioGripper.Feedback.bFaultCodeValid := FALSE;
				END_CASE;
			
				// 不修改 bFault 或 udFaultCode：它们属于电机故障状态，
				// 只能由成功读取 0x603F 的结果更新。
				eStep := E_GripperCommStep.SelectRequest;
            ELSIF aRx[1] <> 16#03 THEN
                eStep := E_GripperCommStep.CommError;

            ELSE
                // 回复必须与当前请求的数据长度一致。
                IF
                    ((nActiveKind = 2) AND (aRx[2] <> 2))
                    OR ((nActiveKind <> 2) AND (aRx[2] <> 4))
                THEN
                    eStep := E_GripperCommStep.CommError;
                ELSE
                    CASE nActiveKind OF
                        1: // 32位有符号位置；报文高字节在前
                            dwValue :=
                                SHL(BYTE_TO_DWORD(aRx[3]), 24)
                                OR SHL(BYTE_TO_DWORD(aRx[4]), 16)
                                OR SHL(BYTE_TO_DWORD(aRx[5]), 8)
                                OR BYTE_TO_DWORD(aRx[6]);

                            ioGripper.Feedback.diActualPosition :=
                                DWORD_TO_DINT(dwValue);
                            ioGripper.Feedback.bPositionValid := TRUE;

                        2: // 16位有符号电流；工程单位0.01 A
                            wCurrentRaw :=
                                SHL(BYTE_TO_WORD(aRx[3]), 8)
                                OR BYTE_TO_WORD(aRx[4]);

                            ioGripper.Feedback.iActualCurrent :=
                                WORD_TO_INT(wCurrentRaw);
                            ioGripper.Feedback.bCurrentValid := TRUE;

                        3: // 32位故障代码
                            dwValue :=
                                SHL(BYTE_TO_DWORD(aRx[3]), 24)
                                OR SHL(BYTE_TO_DWORD(aRx[4]), 16)
                                OR SHL(BYTE_TO_DWORD(aRx[5]), 8)
                                OR BYTE_TO_DWORD(aRx[6]);

                            ioGripper.Feedback.udFaultCode :=
                                DWORD_TO_UDINT(dwValue);
                            ioGripper.Feedback.bFault := (dwValue <> 0);
							ioGripper.Feedback.bFaultCodeValid := TRUE;
					END_CASE;
					
					// 只有“先前报异常的同一项”成功读回，才清除该项异常。
					aModbusException[nActiveKind] := 0;
					
					ioGripper.Feedback.bOnline := TRUE;
					ioGripper.Feedback.bCommFault := FALSE;
					ioGripper.Feedback.udCommErrorCode := 0;
					
					// 其他轮询项若仍有未恢复的异常，保持通信故障状态。
					FOR nErrorKind := 1 TO 3 DO
						IF aModbusException[nErrorKind] <> 0 THEN
							ioGripper.Feedback.bCommFault := TRUE;
							ioGripper.Feedback.udCommErrorCode :=
								16#100 + BYTE_TO_UDINT(aModbusException[nErrorKind]);
							EXIT;
						END_IF;
					END_FOR;
					
					eStep := E_GripperCommStep.SelectRequest;
                END_IF;
            END_IF;
        END_IF;

    E_GripperCommStep.CommError: // 应答超时、帧错误、CRC错误或串口错误
        ioGripper.Feedback.bOnline := FALSE;
        ioGripper.Feedback.bCommFault := TRUE;
        M_InvalidateFeedback(stFeedback := ioGripper.Feedback);
		
        IF fbSerial.Error THEN
            ioGripper.Feedback.udCommErrorCode := fbSerial.ErrorID;
        ELSE
            ioGripper.Feedback.udCommErrorCode := 16#FFFF;
        END_IF;

        nRxLength := 0;
        nExpectedLen := 0;
		// 写入已确认，但运动中的读取事务失败：
		// 若串口仍打开，下一事务尽力发送停止命令。
		IF bMoveActive AND fbSerial.PortOpened THEN
			bStopPending := TRUE;
		END_IF;
		// 已受理的写命令或运行中的动作因通信错误而失败。
		IF bWriteActive OR bMoveActive THEN
			IF bWriteActive AND NOT bInternalStop
				AND ((eActiveCommand = E_GripperCommand.Open)
				  OR (eActiveCommand = E_GripperCommand.Close)) THEN
				// 写回执丢失时，电机可能已收到运动请求；
				// 串口尚可用时下一事务尽力发停止命令。
				bStopPending := fbSerial.PortOpened;
			END_IF;
		
			ioGripper.Feedback.bBusy := FALSE;
			ioGripper.Feedback.udCommandErrorCode := 16#2003;
		END_IF;
		
		bWriteActive := FALSE;
		bMoveActive := FALSE;
		bInternalStop := FALSE;
        eStep := E_GripperCommStep.SelectRequest;
END_CASE;
IF bMoveActive THEN
    IF NOT ioGripper.Feedback.bOnline
        OR ioGripper.Feedback.bCommFault THEN

        bMoveActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.udCommandErrorCode := 16#2003;
        bStopPending := fbSerial.PortOpened;

    ELSIF ioGripper.Feedback.bFaultCodeValid
        AND ioGripper.Feedback.bFault THEN

        bMoveActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.udCommandErrorCode := 16#2002;
        bStopPending := fbSerial.PortOpened;

    ELSIF fbMoveTimeout.Q THEN
        bMoveActive := FALSE;
        ioGripper.Feedback.bBusy := FALSE;
        ioGripper.Feedback.udCommandErrorCode := 16#2001;
        bStopPending := fbSerial.PortOpened;

    ELSIF ioGripper.Feedback.bFaultCodeValid
        AND ioGripper.Feedback.bPositionValid THEN

        // 用LINT计算差值，避免32位位置相减溢出。
        liPositionError :=
            DINT_TO_LINT(ioGripper.Feedback.diActualPosition)
            - DINT_TO_LINT(diActiveTarget);
        IF liPositionError < 0 THEN
            liPositionError := -liPositionError;
        END_IF;

        ioGripper.Feedback.bPositionReached :=
            liPositionError
            <= DINT_TO_LINT(ioGripper.Set.diPositionTolerance);

        ioGripper.Feedback.bCurrentReached := FALSE;
        IF ioGripper.Feedback.bCurrentValid THEN
            // 先转DINT，避免INT最小值取绝对值时溢出。
            ioGripper.Feedback.bCurrentReached :=
                ABS(INT_TO_DINT(ioGripper.Feedback.iActualCurrent))
                >= UINT_TO_DINT(ioGripper.Set.uiCloseCurrentMin);
        END_IF;

        IF ioGripper.Feedback.bPositionReached
            AND NOT ioGripper.Feedback.bFault THEN

            CASE eActiveCommand OF
                E_GripperCommand.Open:
                    ioGripper.Feedback.bOpen := TRUE;
                    ioGripper.Feedback.bClosed := FALSE;
                    ioGripper.Feedback.bBusy := FALSE;
                    ioGripper.Feedback.udiCompletedId := udiActiveId;
                    bMoveActive := FALSE;

                E_GripperCommand.Close:
                    // 夹紧必须同时满足位置及实际电流阈值。
                    IF ioGripper.Feedback.bCurrentReached THEN
                        ioGripper.Feedback.bClosed := TRUE;
                        ioGripper.Feedback.bOpen := FALSE;
                        ioGripper.Feedback.bBusy := FALSE;
                        ioGripper.Feedback.udiCompletedId := udiActiveId;
                        bMoveActive := FALSE;
                    END_IF;
            END_CASE;
        END_IF;
    END_IF;
END_IF;]]></ST>
    </Implementation>
    <Method Name="M_InvalidateFeedback" Id="{fc8c9ecb-5ea8-49b5-9258-c3192a7570f8}">
      <Declaration><![CDATA[METHOD PRIVATE M_InvalidateFeedback
VAR_IN_OUT
    stFeedback : ST_GripperFeedback;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[stFeedback.bPositionValid := FALSE;
stFeedback.bCurrentValid := FALSE;
stFeedback.bFaultCodeValid := FALSE;
stFeedback.bOpen := FALSE;
stFeedback.bClosed := FALSE;
stFeedback.bPositionReached := FALSE;
stFeedback.bCurrentReached := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>