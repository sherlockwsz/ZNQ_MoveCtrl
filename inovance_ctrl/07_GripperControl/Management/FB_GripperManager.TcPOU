<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.20">
  <POU Name="FB_GripperManager" Id="{604d8b30-294c-4983-864c-d7b539e9942c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GripperManager
VAR_INPUT
    bEnableComm     : BOOL;
    bSimulationMode : BOOL;
    bStopRequested  : BOOL;
    bControlAllowed : BOOL;
    eMachineMode    : E_MachineMode;
    bRecoveryEnableAllowed : BOOL := FALSE; // 仅MAIN本扫描提交内部恢复Enable时授权
END_VAR
VAR_IN_OUT
    ioGripper : ST_GripperInterface;
END_VAR
VAR
    fbGripperControl : FB_GripperControl;
    bInitialized : BOOL;
    udiLastManualId : UDINT;
    udiLastAutoId : UDINT;
    udiDeviceRequestId : UDINT;
    udiActiveDeviceId : UDINT;
    udiActiveSourceId : UDINT;
    eActiveOwner : E_GripperControlOwner := E_GripperControlOwner.None;
    eActiveCommand : E_GripperCommand := E_GripperCommand.None;
    bNewManual : BOOL;
    bNewAuto : BOOL;
    bIssueCommand : BOOL;
    eIssueOwner : E_GripperControlOwner;
    eIssueCommand : E_GripperCommand;
    udiIssueSourceId : UDINT;
    bCommunicationReady : BOOL;
    bHealthy : BOOL;
    bAutoParametersValid : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// 本FB是夹爪唯一命令所有者：WPF写ManualCmd，自动流程写AutoCmd，
// 只有本FB可以写底层Cmd。Stop始终具有最高优先级。
IF NOT bInitialized THEN
    udiLastManualId := ioGripper.ManualCmd.udiRequestId;
    udiLastAutoId := ioGripper.AutoCmd.udiRequestId;
    udiDeviceRequestId := ioGripper.Cmd.udiRequestId;
    bInitialized := TRUE;
END_IF;

bNewManual := ioGripper.ManualCmd.udiRequestId <> udiLastManualId;
bNewAuto := ioGripper.AutoCmd.udiRequestId <> udiLastAutoId;
IF bNewManual THEN udiLastManualId := ioGripper.ManualCmd.udiRequestId; END_IF;
IF bNewAuto THEN udiLastAutoId := ioGripper.AutoCmd.udiRequestId; END_IF;

bCommunicationReady :=
    bSimulationMode
    OR (ioGripper.Feedback.bOnline AND NOT ioGripper.Feedback.bCommFault);
bHealthy :=
    bSimulationMode
    OR (bCommunicationReady
        AND ioGripper.Feedback.bFaultCodeValid
        AND NOT ioGripper.Feedback.bFault);
bAutoParametersValid :=
    ioGripper.Set.bParametersVerified
    AND (ioGripper.Set.diPositionTolerance >= 0)
    AND (ioGripper.Set.uiCloseCurrentMin > 0)
    AND (ioGripper.Set.diGripPositionMin <= ioGripper.Set.diGripPositionMax)
    AND (ioGripper.Set.uiGripConfirmCount > 0)
    AND (ioGripper.Set.tFeedbackTimeout > T#0MS)
    AND (ioGripper.Set.tMoveTimeout > T#0MS);

// 特殊结果与当前通道事务绑定；新编号和Stop不得继承上一结果。
IF bNewManual OR bStopRequested THEN
    ioGripper.ManualFeedback.bCloseTargetReachedWithoutGrip := FALSE;
END_IF;
IF bNewAuto OR bStopRequested THEN
    ioGripper.AutoFeedback.bCloseTargetReachedWithoutGrip := FALSE;
END_IF;
// Action取消/释放后撤销底层授权；不为此生成新命令或改动所有权。
IF (eActiveOwner = E_GripperControlOwner.Auto)
    AND (NOT ioGripper.AutoCmd.bAllowCloseTargetWithoutGrip
        OR (eMachineMode <> E_MachineMode.Automatic)
        OR bStopRequested) THEN
    ioGripper.Cmd.bAllowCloseTargetWithoutGrip := FALSE;
END_IF;

// Stop到来时，当前来源动作立即以“被停止中断”结束。
IF bStopRequested AND (eActiveOwner <> E_GripperControlOwner.None) THEN
    CASE eActiveOwner OF
        E_GripperControlOwner.Manual:
            ioGripper.ManualFeedback.bBusy := FALSE;
            ioGripper.ManualFeedback.udiFailedId := udiActiveSourceId;
            ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.InterruptedByMachineStop);
        E_GripperControlOwner.Auto:
            ioGripper.AutoFeedback.bBusy := FALSE;
            ioGripper.AutoFeedback.udiFailedId := udiActiveSourceId;
            ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.InterruptedByMachineStop);
    END_CASE;
    eActiveOwner := E_GripperControlOwner.None;
    eActiveCommand := E_GripperCommand.None;
END_IF;

bIssueCommand := FALSE;
eIssueOwner := E_GripperControlOwner.None;
eIssueCommand := E_GripperCommand.None;
udiIssueSourceId := 0;

// 先拒绝当前模式无权使用的通道，再从有权通道选择一条新命令。
IF bStopRequested THEN
    IF bNewManual THEN
        ioGripper.ManualFeedback.bBusy := FALSE;
        ioGripper.ManualFeedback.udiRejectedId := ioGripper.ManualCmd.udiRequestId;
        ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.MachineStopping);
    END_IF;
    IF bNewAuto THEN
        ioGripper.AutoFeedback.bBusy := FALSE;
        ioGripper.AutoFeedback.udiRejectedId := ioGripper.AutoCmd.udiRequestId;
        ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.MachineStopping);
    END_IF;

// 自动流程、自动启动和机构准备都使用AutoCmd通道。
// Preparing期间仍禁止WPF手动命令与准备动作争抢COM3。
ELSIF (eMachineMode = E_MachineMode.Automatic)
    OR (eMachineMode = E_MachineMode.AutoStarting)
    OR (eMachineMode = E_MachineMode.Preparing)
THEN
    IF bNewManual THEN
        ioGripper.ManualFeedback.udiRejectedId := ioGripper.ManualCmd.udiRequestId;
        ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.ManualForbiddenInAuto); // 自动模式禁止手动命令
    END_IF;
    IF bNewAuto THEN
        IF (eActiveOwner <> E_GripperControlOwner.None)
            OR ioGripper.Feedback.bBusy THEN
            ioGripper.AutoFeedback.udiRejectedId := ioGripper.AutoCmd.udiRequestId;
            ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.Busy);
        ELSIF (ioGripper.AutoCmd.eCommand <> E_GripperCommand.Open)
            AND (ioGripper.AutoCmd.eCommand <> E_GripperCommand.Close)
            AND NOT ((eMachineMode = E_MachineMode.Preparing)
                AND (ioGripper.AutoCmd.eCommand = E_GripperCommand.Enable)) THEN
            ioGripper.AutoFeedback.udiRejectedId := ioGripper.AutoCmd.udiRequestId;
            ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.InvalidCommand);
        ELSIF NOT bSimulationMode
            AND (NOT bHealthy
                OR ((ioGripper.AutoCmd.eCommand <> E_GripperCommand.Enable)
                    AND NOT bAutoParametersValid)) THEN
            ioGripper.AutoFeedback.udiRejectedId := ioGripper.AutoCmd.udiRequestId;
            ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.NotReady);
        ELSE
            bIssueCommand := TRUE;
            eIssueOwner := E_GripperControlOwner.Auto;
            eIssueCommand := ioGripper.AutoCmd.eCommand;
            udiIssueSourceId := ioGripper.AutoCmd.udiRequestId;
        END_IF;
    END_IF;

ELSIF (eMachineMode = E_MachineMode.Manual)
    OR (eMachineMode = E_MachineMode.Fault) THEN

    IF bNewAuto THEN
        ioGripper.AutoFeedback.udiRejectedId := ioGripper.AutoCmd.udiRequestId;
        ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.AutoForbiddenInCurrentMode); // 当前模式禁止自动命令
    END_IF;
    IF bNewManual THEN
        IF (eActiveOwner <> E_GripperControlOwner.None)
            OR ioGripper.Feedback.bBusy THEN
            ioGripper.ManualFeedback.udiRejectedId := ioGripper.ManualCmd.udiRequestId;
            ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.Busy);
        ELSIF (eMachineMode = E_MachineMode.Fault)
            AND (ioGripper.ManualCmd.eCommand <> E_GripperCommand.ResetFault)
            AND (ioGripper.ManualCmd.eCommand <> E_GripperCommand.Stop)
            AND NOT (bRecoveryEnableAllowed
                AND (ioGripper.ManualCmd.eCommand = E_GripperCommand.Enable)) THEN
            ioGripper.ManualFeedback.udiRejectedId := ioGripper.ManualCmd.udiRequestId;
            ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.FaultModeCommandForbidden);
        ELSIF (ioGripper.ManualCmd.eCommand = E_GripperCommand.Enable)
            AND NOT bRecoveryEnableAllowed THEN
            // Enable只属于内部整机恢复，不开放为普通HMI手动能力。
            ioGripper.ManualFeedback.udiRejectedId := ioGripper.ManualCmd.udiRequestId;
            ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.ControlForbiddenInCurrentMode);
        ELSIF (ioGripper.ManualCmd.eCommand = E_GripperCommand.Enable)
            AND NOT bHealthy THEN
            ioGripper.ManualFeedback.udiRejectedId := ioGripper.ManualCmd.udiRequestId;
            ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.NotReady);
        ELSIF (ioGripper.ManualCmd.eCommand = E_GripperCommand.None) THEN
            ioGripper.ManualFeedback.udiRejectedId := ioGripper.ManualCmd.udiRequestId;
            ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.InvalidCommand);
        ELSIF NOT bSimulationMode AND NOT bCommunicationReady THEN
            ioGripper.ManualFeedback.udiRejectedId := ioGripper.ManualCmd.udiRequestId;
            ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.NotReady);
        ELSE
            bIssueCommand := TRUE;
            eIssueOwner := E_GripperControlOwner.Manual;
            eIssueCommand := ioGripper.ManualCmd.eCommand;
            udiIssueSourceId := ioGripper.ManualCmd.udiRequestId;
        END_IF;
    END_IF;

ELSE
    IF bNewManual THEN
        ioGripper.ManualFeedback.udiRejectedId := ioGripper.ManualCmd.udiRequestId;
        ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.ControlForbiddenInCurrentMode);
    END_IF;
    IF bNewAuto THEN
        ioGripper.AutoFeedback.udiRejectedId := ioGripper.AutoCmd.udiRequestId;
        ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.ControlForbiddenInCurrentMode);
    END_IF;
END_IF;

IF bIssueCommand THEN
    IF bSimulationMode THEN
        // 仿真只完成管理通道握手，不伪造物理位置、电流或在线反馈。
        CASE eIssueOwner OF
            E_GripperControlOwner.Manual:
                ioGripper.ManualFeedback.bCloseTargetReachedWithoutGrip := FALSE;
                ioGripper.ManualFeedback.udiAcceptedId := udiIssueSourceId;
                ioGripper.ManualFeedback.udiCompletedId := udiIssueSourceId;
                ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.None);
            E_GripperControlOwner.Auto:
                ioGripper.AutoFeedback.bCloseTargetReachedWithoutGrip := FALSE;
                ioGripper.AutoFeedback.udiAcceptedId := udiIssueSourceId;
                ioGripper.AutoFeedback.udiCompletedId := udiIssueSourceId;
                ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.None);
        END_CASE;
    ELSE
        IF udiDeviceRequestId = 16#FFFFFFFF THEN
            udiDeviceRequestId := 1;
        ELSE
            udiDeviceRequestId := udiDeviceRequestId + 1;
        END_IF;
        // 只透明传递实机COM3正式自动Close的显式授权。
        // Manual、Preparation、COM4及非Close始终关闭。
        ioGripper.Cmd.bAllowCloseTargetWithoutGrip :=
            (eIssueOwner = E_GripperControlOwner.Auto)
            AND (eMachineMode = E_MachineMode.Automatic)
            AND (ioGripper.Port.ComPort = 3)
            AND (eIssueCommand = E_GripperCommand.Close)
            AND ioGripper.AutoCmd.bAllowCloseTargetWithoutGrip;
        ioGripper.Cmd.eCommand := eIssueCommand;
        ioGripper.Cmd.udiRequestId := udiDeviceRequestId;
        udiActiveDeviceId := udiDeviceRequestId;
        udiActiveSourceId := udiIssueSourceId;
        eActiveOwner := eIssueOwner;
        eActiveCommand := eIssueCommand;
        CASE eActiveOwner OF
            E_GripperControlOwner.Manual:
                ioGripper.ManualFeedback.bBusy := TRUE;
                ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.None);
            E_GripperControlOwner.Auto:
                ioGripper.AutoFeedback.bBusy := TRUE;
                ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.None);
        END_CASE;
    END_IF;
END_IF;

// 仿真与实机只在这一层分流，上层启动、流程和Supervisor无需再判断。
fbGripperControl(
    bEnableComm := bEnableComm AND NOT bSimulationMode,
    bStopRequested := bStopRequested AND NOT bSimulationMode,
    ioGripper := ioGripper
);

// 将底层设备编号的结果映射回各自来源编号。
IF NOT bSimulationMode AND (eActiveOwner <> E_GripperControlOwner.None) THEN
    CASE eActiveOwner OF
        E_GripperControlOwner.Manual:
            IF ioGripper.Feedback.udiAcceptedId = udiActiveDeviceId THEN
                ioGripper.ManualFeedback.udiAcceptedId := udiActiveSourceId;
            END_IF;
            IF ioGripper.Feedback.udiRejectedId = udiActiveDeviceId THEN
                ioGripper.ManualFeedback.bBusy := FALSE;
                ioGripper.ManualFeedback.udiRejectedId := udiActiveSourceId;
                ioGripper.ManualFeedback.udErrorCode := ioGripper.Feedback.udCommandErrorCode;
                eActiveOwner := E_GripperControlOwner.None;
            ELSIF (ioGripper.Feedback.udiCompletedId = udiActiveDeviceId)
                AND (ioGripper.Feedback.udCommandErrorCode = TO_UDINT(E_GripperErrorCode.None)) THEN
                ioGripper.ManualFeedback.bBusy := FALSE;
                ioGripper.ManualFeedback.udiCompletedId := udiActiveSourceId;
                ioGripper.ManualFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.None);
                eActiveOwner := E_GripperControlOwner.None;
            ELSIF (ioGripper.Feedback.udiAcceptedId = udiActiveDeviceId)
                AND NOT ioGripper.Feedback.bBusy
                AND (ioGripper.Feedback.udCommandErrorCode <> TO_UDINT(E_GripperErrorCode.None)) THEN
                ioGripper.ManualFeedback.bBusy := FALSE;
                ioGripper.ManualFeedback.udiFailedId := udiActiveSourceId;
                ioGripper.ManualFeedback.udErrorCode := ioGripper.Feedback.udCommandErrorCode;
                eActiveOwner := E_GripperControlOwner.None;
            END_IF;

        E_GripperControlOwner.Auto:
            IF ioGripper.Feedback.udiAcceptedId = udiActiveDeviceId THEN
                ioGripper.AutoFeedback.udiAcceptedId := udiActiveSourceId;
            END_IF;
            IF ioGripper.Feedback.udiRejectedId = udiActiveDeviceId THEN
                ioGripper.AutoFeedback.bBusy := FALSE;
                ioGripper.AutoFeedback.udiRejectedId := udiActiveSourceId;
                ioGripper.AutoFeedback.udErrorCode := ioGripper.Feedback.udCommandErrorCode;
                eActiveOwner := E_GripperControlOwner.None;
            ELSIF (ioGripper.Feedback.udiCompletedId = udiActiveDeviceId)
                AND (ioGripper.Feedback.udCommandErrorCode = TO_UDINT(E_GripperErrorCode.None)) THEN
                ioGripper.AutoFeedback.bBusy := FALSE;
                ioGripper.AutoFeedback.bCloseTargetReachedWithoutGrip :=
                    ioGripper.Feedback.bCloseTargetReachedWithoutGrip;
                ioGripper.AutoFeedback.udiCompletedId := udiActiveSourceId;
                ioGripper.AutoFeedback.udErrorCode := TO_UDINT(E_GripperErrorCode.None);
                eActiveOwner := E_GripperControlOwner.None;
            ELSIF (ioGripper.Feedback.udiAcceptedId = udiActiveDeviceId)
                AND NOT ioGripper.Feedback.bBusy
                AND (ioGripper.Feedback.udCommandErrorCode <> TO_UDINT(E_GripperErrorCode.None)) THEN
                ioGripper.AutoFeedback.bBusy := FALSE;
                ioGripper.AutoFeedback.bCloseTargetReachedWithoutGrip := FALSE;
                ioGripper.AutoFeedback.udiFailedId := udiActiveSourceId;
                ioGripper.AutoFeedback.udErrorCode := ioGripper.Feedback.udCommandErrorCode;
                eActiveOwner := E_GripperControlOwner.None;
            END_IF;
    END_CASE;
END_IF;

IF eActiveOwner = E_GripperControlOwner.None THEN
    ioGripper.Cmd.bAllowCloseTargetWithoutGrip := FALSE;
    eActiveCommand := E_GripperCommand.None;
END_IF;

// 统一发布上层只读状态。
ioGripper.State.bSimulationActive := bSimulationMode;
ioGripper.State.bCommunicationReady :=
    bSimulationMode
    OR (ioGripper.Feedback.bOnline AND NOT ioGripper.Feedback.bCommFault);
ioGripper.State.bHealthy :=
    bSimulationMode
    OR (ioGripper.State.bCommunicationReady
        AND ioGripper.Feedback.bFaultCodeValid
        AND NOT ioGripper.Feedback.bFault);
ioGripper.State.bBusy :=
    (eActiveOwner <> E_GripperControlOwner.None)
    OR ioGripper.Feedback.bBusy;
ioGripper.State.bManualReady :=
    bControlAllowed
    AND (eMachineMode = E_MachineMode.Manual)
    AND ioGripper.State.bHealthy
    AND NOT ioGripper.State.bBusy
    AND NOT bStopRequested;
ioGripper.State.bAutoReady :=
    bSimulationMode
    OR (bAutoParametersValid
        AND ioGripper.State.bHealthy
        AND ioGripper.Feedback.bPositionValid
        AND ioGripper.Feedback.bCurrentValid
        AND NOT ioGripper.State.bBusy
        AND NOT bStopRequested);
ioGripper.State.bStopAcknowledged :=
    bSimulationMode OR ioGripper.Feedback.bStopAcknowledged;
ioGripper.State.bStopError :=
    NOT bSimulationMode AND ioGripper.Feedback.bStopError;
ioGripper.State.udStopErrorCode := ioGripper.Feedback.udStopErrorCode;

IF bStopRequested THEN
    ioGripper.State.eOwner := E_GripperControlOwner.Stop;
    ioGripper.State.eActiveCommand := E_GripperCommand.Stop;
ELSE
    ioGripper.State.eOwner := eActiveOwner;
    ioGripper.State.eActiveCommand := eActiveCommand;
END_IF;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
